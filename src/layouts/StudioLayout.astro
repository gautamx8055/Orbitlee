---
import '../styles/studio.css';
import StudioNav from '../components/studio/StudioNav.astro';
import StudioFooter from '../components/studio/StudioFooter.astro';

interface Props {
	title?: string;
	description?: string;
	ogImage?: string;
	noindex?: boolean;
}

const {
	title = 'Orbitlee — Creative & Marketing Studio | We Circle, You Grow',
	description = 'Orbitlee is a Delhi creative and marketing studio for brand, AI UGC, social, ads, web and growth. 15+ brands scaled. Free 30-minute audit.',
	ogImage = 'https://www.orbitlee.com/Orbitlee-logo-transparent.png',
	noindex = false,
} = Astro.props;

const siteUrl = 'https://www.orbitlee.com';
const pathname = Astro.url.pathname;
const year = new Date().getFullYear();
const brandVariants = ['Orbitly', 'Orbitli', 'Orbit Lee', 'Orbitlee Agency', 'Orbitlee Creative', 'Orbitlee Marketing', 'Orbitlee Digital', 'Orbitlee India'];

const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Organization',
			'@id': `${siteUrl}/#organization`,
			name: 'Orbitlee',
			alternateName: brandVariants,
			url: siteUrl,
			logo: {
				'@type': 'ImageObject',
				url: `${siteUrl}/Orbitlee-logo-transparent.png`,
				width: 512,
				height: 512,
			},
			description: 'Creative and marketing studio uniting branding, AI content, paid ads and web development. 15+ brands scaled.',
			slogan: 'We Circle, You Grow.',
			foundingDate: '2024',
			founder: { '@id': `${siteUrl}/#founder` },
			sameAs: ['https://www.instagram.com/orbitlee_'],
			contactPoint: {
				'@type': 'ContactPoint',
				telephone: '+91-98106-92028',
				email: 'orbitleeee@gmail.com',
				contactType: 'sales',
				areaServed: 'IN',
				availableLanguage: ['English', 'Hindi'],
			},
			areaServed: { '@type': 'Country', name: 'India' },
		},
		{
			'@type': 'Person',
			'@id': `${siteUrl}/#founder`,
			name: 'Sachin Verma',
			jobTitle: 'Founder & Creative Head',
			worksFor: { '@id': `${siteUrl}/#organization` },
		},
		{
			'@type': 'WebSite',
			'@id': `${siteUrl}/#website`,
			url: siteUrl,
			name: 'Orbitlee',
			publisher: { '@id': `${siteUrl}/#organization` },
		},
		{
			'@type': 'WebPage',
			'@id': `${siteUrl}${pathname}#webpage`,
			url: `${siteUrl}${pathname}`,
			name: title,
			description,
			isPartOf: { '@id': `${siteUrl}/#website` },
		},
	],
};
---

<html lang="en" data-theme="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<script is:inline>
			(function () {
				try {
					var saved = localStorage.getItem('orbitlee-theme');
					var theme = saved || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
					document.documentElement.setAttribute('data-theme', theme);
				} catch (e) {}
			})();
		</script>
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1'} />
		<meta name="theme-color" content="#07080A" id="theme-color-meta" />
		<meta name="color-scheme" content="dark light" />
		<meta name="author" content="Sachin Verma, Orbitlee" />
		<link rel="canonical" href={`${siteUrl}${pathname}`} />
		<meta name="keywords" content="orbitlee, creative agency india, marketing agency delhi, branding studio, ai ugc, meta ads, web development india, sachin verma" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Orbitlee" />
		<meta property="og:url" content={`${siteUrl}${pathname}`} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:locale" content="en_IN" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=6" />
		<link rel="icon" type="image/png" href="/Orbitlee-fav-icon.png?v=6" />
		<link rel="shortcut icon" href="/favicon.ico?v=6" />
		<link rel="apple-touch-icon" href="/Orbitlee-fav-icon.png?v=6" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,500&display=swap" rel="stylesheet" />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		<slot name="head" />
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>
		<div class="scroll-progress" id="scroll-progress" aria-hidden="true"></div>
		<StudioNav pathname={pathname} />
		<main class="wrap" id="main">
			<slot />
		</main>
		<StudioFooter year={year} />
		<script>
			import '../scripts/studio.ts';
		</script>
	</body>
</html>
