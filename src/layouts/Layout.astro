			/* ════════ HOMEPAGE ════════ */
			.hp-hero {
				max-width: 1280px;
				margin: 0 auto;
				padding: 80px 40px 60px;
				display: grid;
				grid-template-columns: 1fr 480px;
				gap: 64px;
				align-items: center;
				min-height: calc(100svh - 80px);
			}
			.hp-hero__left { display: flex; flex-direction: column; gap: 28px; }
			.hp-badge {
				display: inline-flex;
				align-items: center;
				gap: 10px;
				padding: 8px 16px;
				border: 1.5px solid var(--violet-mid);
				border-radius: 999px;
				font-size: 13px;
				font-weight: 600;
				color: var(--violet);
				background: var(--violet-light);
