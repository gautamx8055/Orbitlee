			.hp-cta__orb { position: absolute; border-radius: 50%; filter: blur(70px); pointer-events: none; }
			.hp-cta__orb--1 { width: 400px; height: 400px; background: radial-gradient(circle, rgba(124,58,237,0.5) 0%, transparent 70%); top: -100px; left: -100px; }
			.hp-cta__orb--2 { width: 300px; height: 300px; background: radial-gradient(circle, rgba(21,128,61,0.3) 0%, transparent 70%); bottom: -60px; right: -60px; }
			.hp-cta__content { position: relative; max-width: 680px; }
			.hp-cta__tag { display: inline-block; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; color: rgba(255,255,255,0.5); margin-bottom: 20px; }
			.hp-cta__h2 { font-size: clamp(36px, 4.5vw, 60px); font-weight: 900; letter-spacing: -0.03em; line-height: 1.1; margin: 0 0 16px; color: #fff; }
			.hp-cta__h2 em { font-style: italic; opacity: 0.85; }
			.hp-cta__sub { font-size: 16px; color: rgba(255,255,255,0.6); margin: 0 0 40px; line-height: 1.6; }
			.hp-cta__actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
			.hp-cta__btn-primary {
				padding: 14px 28px; border-radius: 999px; background: #fff; color: var(--violet);
				font-size: 15px; font-weight: 700; border: 1.5px solid transparent;
				box-shadow: 0 4px 16px rgba(0,0,0,0.2); cursor: pointer;
				transition: transform 0.2s, box-shadow 0.2s, background 0.2s;
				display: inline-flex; align-items: center; justify-content: center;
			}
			.hp-cta__btn-primary:hover { background: var(--violet-light); transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,0.25); }
			.hp-cta__btn-ghost {
				padding: 14px 28px; border-radius: 999px; background: transparent; color: rgba(255,255,255,0.8);
				font-size: 15px; font-weight: 600; border: 1.5px solid rgba(255,255,255,0.25);
				cursor: pointer; transition: border-color 0.2s, background 0.2s, transform 0.2s;
				display: inline-flex; align-items: center; justify-content: center;
			}
			.hp-cta__btn-ghost:hover { border-color: rgba(255,255,255,0.5); background: rgba(255,255,255,0.08); transform: translateY(-2px); }

			/* HP Responsive */
			@media (max-width: 1200px) {
				.hp-hero { grid-template-columns: 1fr 380px; gap: 40px; padding: 64px 32px 48px; }
				.orbit-scene { width: 380px; height: 380px; }
				.orbit-ring--3 { width: 340px; height: 340px; }
				.orbit-planet--3 { width: 340px; height: 340px; margin: -170px; }
				.svc-row { grid-template-columns: 52px 1fr 1fr 52px; gap: 24px; }
			}
			@media (max-width: 900px) {
