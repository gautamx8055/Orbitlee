				margin: 0;
				line-height: 1.65;
				max-width: 480px;
			}
			.hp-hero__actions { display: flex; gap: 12px; flex-wrap: wrap; }
			.hp-hero__trust { padding-top: 24px; border-top: 1px solid var(--line); }
			.hp-hero__trust-items {
				display: flex;
				align-items: center;
				gap: 14px;
				flex-wrap: wrap;
				font-size: 14px;
				color: var(--muted);
			}
			.hp-hero__trust-items strong { color: var(--text); font-weight: 700; }
			.hp-hero__trust-dot { width: 4px; height: 4px; border-radius: 50%; background: var(--muted-2); flex-shrink: 0; }
			.hp-hero__right { display: flex; align-items: center; justify-content: center; }

			/* Orbit animation */
			.orbit-scene { position: relative; width: 420px; height: 420px; flex-shrink: 0; }
			.orbit-ring {
				position: absolute;
				top: 50%; left: 50%;
				transform: translate(-50%, -50%);
				border-radius: 50%;
				border: 1.5px solid;
			}
			.orbit-ring--1 { width: 140px; height: 140px; border-color: rgba(124,58,237,0.2); }
			.orbit-ring--2 { width: 260px; height: 260px; border-color: rgba(21,128,61,0.15); border-style: dashed; }
			.orbit-ring--3 { width: 380px; height: 380px; border-color: rgba(124,58,237,0.1); }
			.orbit-planet {
				position: absolute;
				top: 50%; left: 50%;
				transform-origin: 0 0;
			}
			.orbit-planet--1 { width: 130px; height: 130px; margin: -65px; animation: orbit 6s linear infinite; }
			.orbit-planet--2 { width: 256px; height: 256px; margin: -128px; animation: orbit 10s linear infinite reverse; }
			.orbit-planet--3 { width: 380px; height: 380px; margin: -190px; animation: orbit 16s linear infinite; }
			@keyframes orbit { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
			@media (prefers-reduced-motion: reduce) { .orbit-planet--1, .orbit-planet--2, .orbit-planet--3 { animation: none; } }
			.orbit-planet__dot {
				position: absolute;
				top: 0; left: 50%;
				transform: translateX(-50%);
				width: 12px; height: 12px;
				border-radius: 50%;
				background: var(--violet);
				box-shadow: 0 0 12px rgba(124,58,237,0.6), 0 0 24px rgba(124,58,237,0.3);
			}
			.orbit-planet__dot--green { background: var(--green); box-shadow: 0 0 12px rgba(21,128,61,0.6), 0 0 24px rgba(21,128,61,0.3); }
			.orbit-planet__dot--amber { background: #d97706; box-shadow: 0 0 12px rgba(217,119,6,0.6), 0 0 24px rgba(217,119,6,0.3); }
			.orbit-center {
				position: absolute;
				top: 50%; left: 50%;
				transform: translate(-50%, -50%);
				width: 80px; height: 80px;
				border-radius: 50%;
				background: var(--panel);
				border: 2px solid var(--violet-mid);
				box-shadow: var(--shadow-md), 0 0 0 8px var(--violet-light);
				display: flex;
				align-items: center;
				justify-content: center;
			}
			.orbit-center__logo { width: 48px; height: 48px; object-fit: contain; }
			.orbit-chip {
				position: absolute;
				display: flex;
				flex-direction: column;
				align-items: center;
				padding: 10px 16px;
				background: var(--panel);
				border: 1.5px solid var(--line);
				border-radius: 14px;
				box-shadow: var(--shadow);
				animation: floatChip 4s ease-in-out infinite;
			}
			.orbit-chip--1 { top: 10%; left: -20px; animation-delay: 0s; }
			.orbit-chip--2 { bottom: 15%; right: -20px; animation-delay: 1.4s; }
			.orbit-chip--3 { bottom: 5%; left: 5%; animation-delay: 0.7s; }
			@keyframes floatChip { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
			@media (prefers-reduced-motion: reduce) { .orbit-chip { animation: none; } }
			.orbit-chip__num { font-size: 20px; font-weight: 900; letter-spacing: -0.03em; background: var(--gradient); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; line-height: 1; }
			.orbit-chip__label { font-size: 11px; color: var(--muted); font-weight: 600; white-space: nowrap; margin-top: 2px; }

			/* Ticker */
			.ticker-wrap { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 16px 0; overflow: hidden; background: var(--bg-2); }
			.ticker { display: flex; overflow: hidden; }
			.ticker__track {
				display: flex;
				align-items: center;
				gap: 24px;
				white-space: nowrap;
				animation: tickerScroll 28s linear infinite;
				will-change: transform;
			}
			@keyframes tickerScroll { 0% { transform: translateX(0); } 100% { transform: translateX(-33.333%); } }
			@media (prefers-reduced-motion: reduce) { .ticker__track { animation: none; } }
			.ticker__item { font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
			.ticker__sep { color: var(--violet); font-size: 16px; font-weight: 700; }

			/* HP section shared */
			.hp-section { max-width: 1200px; margin: 0 auto; padding: 80px 40px; }
			.hp-section__intro { margin-bottom: 56px; }
			.hp-section__intro--split { display: flex; align-items: flex-end; justify-content: space-between; gap: 32px; }
			.hp-section__label { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; color: var(--muted-2); margin-bottom: 12px; }
			.hp-section__h2 { font-size: clamp(36px, 4.2vw, 60px); font-weight: 900; letter-spacing: -0.03em; line-height: 1.06; margin: 0 0 16px; color: var(--text); }
			.hp-section__sub { font-size: 16px; color: var(--muted); margin: 0; line-height: 1.65; max-width: 480px; }

			/* Service rows */
			.svc-rows { display: flex; flex-direction: column; }
			.svc-row {
				display: grid;
				grid-template-columns: 72px 1fr auto 52px;
				align-items: center;
				gap: 32px;
				padding: 36px 0;
				border-bottom: 1.5px solid var(--line);
				color: inherit;
				text-decoration: none;
				position: relative;
			}
			.svc-rows .svc-row:first-child { border-top: 1.5px solid var(--line); }
			.svc-row::before {
				content: '';
				position: absolute;
				inset: 0 -40px;
				background: var(--violet-light);
				border-radius: 16px;
				opacity: 0;
				transition: opacity 0.25s;
				pointer-events: none;
			}
			.svc-row:hover::before { opacity: 1; }
			.svc-row__num { font-size: 13px; font-weight: 700; color: var(--muted-2); letter-spacing: 0.1em; position: relative; transition: color 0.2s; }
			.svc-row:hover .svc-row__num { color: var(--violet); }
			.svc-row__body { position: relative; }
			.svc-row__title { font-size: 22px; font-weight: 800; letter-spacing: -0.02em; margin: 0 0 6px; color: var(--text); transition: color 0.2s; }
			.svc-row:hover .svc-row__title { color: var(--violet); }
			.svc-row__desc { font-size: 14px; color: var(--muted); margin: 0; line-height: 1.6; max-width: 420px; }
			.svc-row__tags { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; max-width: 280px; position: relative; }
			.svc-row__tags li {
				font-size: 12px; font-weight: 600; color: var(--muted);
				border: 1.5px solid var(--line); border-radius: 999px;
				padding: 4px 10px; background: var(--bg); white-space: nowrap;
				transition: color 0.2s, border-color 0.2s, background 0.2s;
			}
			.svc-row:hover .svc-row__tags li { border-color: var(--violet-mid); color: var(--violet); background: var(--panel); }
			.svc-row__arrow {
				width: 44px; height: 44px;
				display: inline-flex; align-items: center; justify-content: center;
				border-radius: 50%; background: var(--bg);
				border: 1.5px solid var(--line); color: var(--muted); flex-shrink: 0;
				transition: background 0.25s, border-color 0.25s, color 0.25s, transform 0.25s;
				position: relative;
			}
			.svc-row__arrow svg { width: 18px; height: 18px; }
			.svc-row:hover .svc-row__arrow { background: var(--violet); border-color: var(--violet); color: #fff; transform: rotate(-45deg); }

			/* HP Why */
			.hp-why { background: var(--bg-2); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
			.hp-why__head { max-width: 1200px; margin: 0 auto; padding: 80px 40px 0; }
			.hp-why__grid { max-width: 1200px; margin: 0 auto; padding: 48px 40px 80px; display: grid; grid-template-columns: 1fr 1fr; gap: 2px; }
			.why-feat {
				display: flex; gap: 28px; padding: 40px;
				background: var(--panel); border: 1.5px solid var(--line);
				transition: border-color 0.25s, box-shadow 0.25s; position: relative;
			}
			.hp-why__grid > .why-feat:first-child { border-radius: 20px 0 0 0; }
			.hp-why__grid > .why-feat:nth-child(2) { border-radius: 0 20px 0 0; }
			.hp-why__grid > .why-feat:nth-child(3) { border-radius: 0 0 0 20px; }
			.hp-why__grid > .why-feat:last-child { border-radius: 0 0 20px 0; }
			.why-feat:hover { border-color: var(--violet-mid); box-shadow: var(--shadow-md); z-index: 1; }
			.why-feat__num {
				font-size: 56px; font-weight: 900; letter-spacing: -0.05em; line-height: 1;
				background: var(--gradient); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
				flex-shrink: 0; opacity: 0.18; transition: opacity 0.25s; align-self: flex-start; padding-top: 4px;
			}
			.why-feat:hover .why-feat__num { opacity: 0.35; }
			.why-feat__content { display: flex; flex-direction: column; gap: 10px; }
			.why-feat__label { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; color: var(--violet); }
			.why-feat__title { font-size: 20px; font-weight: 800; letter-spacing: -0.02em; margin: 0; color: var(--text); line-height: 1.3; }
			.why-feat__body { font-size: 14px; color: var(--muted); margin: 0; line-height: 1.7; }

			/* Work extras */
			.work-card__media--wide { aspect-ratio: 4 / 3 !important; }
			.work-card__client { font-size: 11px; color: var(--violet); font-weight: 600; letter-spacing: 0.04em; }
			.work-viewall { display: flex; justify-content: center; margin-top: 32px; }
			.hp-section .work-grid {
				display: grid;
				grid-auto-flow: column;
				grid-auto-columns: calc((100% - 60px) / 4);
				grid-template-columns: none;
