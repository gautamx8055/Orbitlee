				.hp-cta__inner { padding: 48px 28px; border-radius: 20px; }
				.hp-cta__actions { flex-direction: column; align-items: center; }
				.hp-cta__btn-primary, .hp-cta__btn-ghost { width: 100%; max-width: 280px; }
