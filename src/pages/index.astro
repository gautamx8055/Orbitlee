---
import Layout from '../layouts/Layout.astro';

const siteUrl = "https://www.orbitlee.com";

const serviceRows = [
	{
		num: "01",
		href: "/services/marketing-advertising",
		title: "Marketing & Advertising",
		desc: "Full-funnel campaigns from cold reach to qualified pipeline. Meta, Google, social media management and AI-native content built to compound.",
		tags: ["Meta Ads", "Google Ads", "Social Media", "AI UGC", "Lead Generation"],
	},
	{
		num: "02",
		href: "/services/web-app-development",
		title: "Web & App Development",
		desc: "Sites, products and automations that feel effortless, load fast and convert visitors into paying customers.",
		tags: ["Websites", "Landing Pages", "Mobile Apps", "SaaS", "AI Automation"],
	},
	{
		num: "03",
		href: "/services/branding-creative",
		title: "Branding & Creative",
		desc: "Positioning, identity and high-craft production that stops the scroll and makes your brand impossible to ignore.",
		tags: ["Brand Strategy", "Logo & Identity", "AI UGC", "Commercial Ads"],
	},
	{
		num: "04",
		href: "/services/growth-consulting",
		title: "Growth Consulting",
		desc: "Sharp diagnostics and clear roadmaps before your next big investment. Audits, strategy, go-to-market.",
		tags: ["Growth Audit", "Brand Audit", "GTM Strategy", "Marketing Strategy"],
	},
];

const whyItems = [
	{
		num: "01",
		title: "One team. One brief. Zero handoffs.",
		body: "Stop stitching an agency, a dev shop and a media consultant together. Strategy, design, dev and ads move together in one weekly sprint - so nothing falls through the cracks.",
		label: "Unified delivery",
	},
	{
		num: "02",
		title: "AI-native production at scale.",
		body: "AI UGC, generative creative and automated post-production means 10x the ad variants without 10x the cost. You get volume and quality.",
		label: "AI advantage",
	},
	{
		num: "03",
		title: "Live in weeks, not quarters.",
		body: "Brand new to live site, campaign or product in 2-6 weeks. Momentum is a growth channel - we ship fast so you can learn faster.",
		label: "Speed to market",
	},
	{
		num: "04",
		title: "Dev and marketing share a brain.",
		body: "Landing pages ship the same day a campaign does. Your site and ad account share a nervous system - no more waiting on the 'other team'.",
		label: "In-house full stack",
	},
];

const testimonials = [
	{
		quote: "Orbitlee rebuilt our brand from the identity up and had a new site plus paid campaigns live inside six weeks. Revenue is up 3x since launch.",
		name: "Priya Menon",
		role: "Founder, Aurora Labs",
		initials: "PM",
		accent: "#16a34a",
	},
	{
		quote: "One team for creative, ads and dev meant we finally stopped losing weeks to handoffs. Things just ship, and keep shipping.",
		name: "Rohan Kapoor",
		role: "Head of Growth, Halo Studio",
		initials: "RK",
		accent: "#7c3aed",
	},
	{
		quote: "The audit alone was worth twice what we paid. Then they executed on the roadmap. Rare to find both in the same room.",
		name: "Anaya Sharma",
		role: "CMO, Ember & Oak",
		initials: "AS",
		accent: "#9333ea",
	},
	{
		quote: "Their AI UGC pipeline now produces more ad variants in a week than our old agency did in a quarter, at a fraction of the cost.",
		name: "Vikram Reddy",
		role: "Marketing Director, Northwind & Co.",
		initials: "VR",
		accent: "#d97706",
	},
	{
		quote: "The team understood our brand vision on day one and delivered a site that actually converts. We saw a 40% lift in inquiries.",
		name: "Meera Joshi",
		role: "Co-founder, Luminos",
		initials: "MJ",
		accent: "#0891b2",
	},
	{
		quote: "Working with Orbitlee felt like having an in-house team - responsive, fast and always one step ahead.",
		name: "Arjun Das",
		role: "CEO, Stackr",
		initials: "AD",
		accent: "#7c3aed",
	},
];

const clientWork = {
	videos: [
		{ src: "/ADVC UGC 1.mp4", label: "ADVC - AI UGC Spot 1", category: "AI UGC", client: "ADVC" },
		{ src: "/ADVC UGC 2.mp4", label: "ADVC - AI UGC Spot 2", category: "AI UGC", client: "ADVC" },
		{ src: "/Horizon RE NEW SAMPLE.mp4", label: "Horizon Real Estate", category: "Commercial", client: "Horizon RE" },
		{ src: "/Gaurya Farms Ghee reel .mp4", label: "Gaurya Farms Ghee", category: "Product Reel", client: "Gaurya Farms" },
		{ src: "/Green Exlir Lip Balm UGC.mp4", label: "Green Elixir Lip Balm", category: "UGC", client: "Green Elixir" },
		{ src: "/BA .mp4", label: "BA Campaign", category: "Commercial", client: "BA" },
	],
	branding: [
		{ src: "/AURIX-SM-BANNER.jpg", label: "Aurix - Social Banner", category: "Branding", client: "Aurix" },
		{ src: "/Post 1.png", label: "Social Creative 01", category: "Social", client: "" },
		{ src: "/Post 2.png", label: "Social Creative 02", category: "Social", client: "" },
		{ src: "/Post 3.png", label: "Social Creative 03", category: "Social", client: "" },
		{ src: "/Post 4.png", label: "Social Creative 04", category: "Social", client: "" },
		{ src: "/Post-5.png", label: "Social Creative 05", category: "Social", client: "" },
	],
	ads: [
		{ src: "/Ads-try-1-F.jpg", label: "Ad Creative - Concept 1", category: "Paid Ads", client: "" },
		{ src: "/Ads-try-2-F.jpg", label: "Ad Creative - Concept 2", category: "Paid Ads", client: "" },
		{ src: "/Ads-try-3&4.jpg", label: "Ad Creative - Concepts 3 & 4", category: "Paid Ads", client: "" },
	],
	design: [
		{ src: "/1.jpg", label: "Design Portfolio 01", category: "Design", client: "" },
		{ src: "/2.jpg", label: "Design Portfolio 02", category: "Design", client: "" },
		{ src: "/3.jpg", label: "Design Portfolio 03", category: "Design", client: "" },
		{ src: "/4.jpg", label: "Design Portfolio 04", category: "Design", client: "" },
		{ src: "/5.jpg", label: "Design Portfolio 05", category: "Design", client: "" },
		{ src: "/6.jpg", label: "Design Portfolio 06", category: "Design", client: "" },
		{ src: "/7.jpg", label: "Design Portfolio 07", category: "Design", client: "" },
		{ src: "/8.jpg", label: "Design Portfolio 08", category: "Design", client: "" },
		{ src: "/9.jpg", label: "Design Portfolio 09", category: "Design", client: "" },
		{ src: "/10.jpg", label: "Design Portfolio 10", category: "Design", client: "" },
		{ src: "/11.jpg", label: "Design Portfolio 11", category: "Design", client: "" },
	],
};

const faqs = [
	{
		q: "What services does Orbitlee offer?",
		a: "We're a full-service creative and marketing agency covering branding & strategy, social media & content, AI-generated UGC, graphic design, UI/UX, web & app development, AI automation and LinkedIn sales outreach - all under one team.",
	},
	{
		q: "How much does Orbitlee charge?",
		a: "Pricing depends on scope - from focused single-sprint projects to always-on retainers. Every engagement starts with a free consultation and audit where we scope the work and share transparent numbers. No slide decks, no pressure.",
	},
	{
		q: "How long do projects usually take?",
		a: "Most projects ship in weeks, not quarters. Brand identities typically land in 2-4 weeks, websites in 3-6, and always-on campaigns run in weekly sprints so you see momentum from day one.",
	},
	{
		q: "Do you work with clients outside India?",
		a: "Yes. We're based in India with a distributed team and work remotely with clients globally. Weekly sprint reviews keep you in the loop regardless of timezone.",
	},
];

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: faqs.map((f) => ({
		"@type": "Question",
		name: f.q,
		acceptedAnswer: { "@type": "Answer", text: f.a },
	})),
};

const homePageSchema = {
	"@context": "https://schema.org",
	"@type": "ItemList",
	name: "Orbitlee Services",
	numberOfItems: 4,
	itemListElement: [
		{ "@type": "ListItem", position: 1, name: "Marketing & Advertising", url: `${siteUrl}/services/marketing-advertising/` },
		{ "@type": "ListItem", position: 2, name: "Web & App Development", url: `${siteUrl}/services/web-app-development/` },
		{ "@type": "ListItem", position: 3, name: "Branding & Creative", url: `${siteUrl}/services/branding-creative/` },
		{ "@type": "ListItem", position: 4, name: "Growth Consulting", url: `${siteUrl}/services/growth-consulting/` },
	],
};
---

<Layout
	title="Orbitlee - Creative & Marketing Agency India | Branding, AI Content, Ads & Web"
	description="Orbitlee (also known as Orbitly, Orbitli) is India's creative & marketing agency. Branding, AI UGC, Meta Ads, Google Ads, web development & growth consulting. 25+ brands scaled. Book a free audit."
>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(homePageSchema)} />
	</Fragment>

	<!-- ═══════════════════ HERO ═══════════════════ -->
	<section class="hp-hero" itemscope itemtype="https://schema.org/WPHeader">
		<div class="hp-hero__left">
			<span class="hp-badge" data-reveal>
				<span class="hp-badge__dot"></span>
				India's Creative & Marketing Agency
			</span>

			<h1 class="hp-hero__h1" itemprop="headline" data-reveal>
				Brands that<br />
				<em class="hp-hero__em">ship, sell</em><br />
				and&nbsp;<em class="hp-hero__em">scale.</em>
			</h1>

			<p class="hp-hero__sub" itemprop="description" data-reveal>
				Strategy, design, marketing and technology under one team.
				One brief. One weekly sprint. Zero handoffs.
			</p>

			<div class="hp-hero__actions" data-reveal>
				<a href="/contact" class="btn btn--primary btn--lg magnetic-btn">
					Book a free brand audit
					<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true"><path d="M4 10h12M10 4l6 6-6 6"/></svg>
				</a>
				<a href="#work" class="btn btn--ghost btn--lg">See our work</a>
			</div>

			<div class="hp-hero__trust" data-reveal>
				<div class="hp-hero__trust-items">
					<span>
						<strong>25+</strong> projects
					</span>
					<span class="hp-hero__trust-dot"></span>
					<span>
						<strong>$100K+</strong> ad spend
					</span>
					<span class="hp-hero__trust-dot"></span>
					<span>
						<strong>5★</strong> rated
					</span>
					<span class="hp-hero__trust-dot"></span>
					<span>Free 30-min audit</span>
				</div>
			</div>
		</div>

		<div class="hp-hero__right" aria-hidden="true">
			<div class="orbit-scene">
				<!-- Static rings -->
				<div class="orbit-ring orbit-ring--1"></div>
				<div class="orbit-ring orbit-ring--2"></div>
				<div class="orbit-ring orbit-ring--3"></div>
				<!-- Orbiting dots -->
				<div class="orbit-planet orbit-planet--1">
					<span class="orbit-planet__dot"></span>
				</div>
				<div class="orbit-planet orbit-planet--2">
					<span class="orbit-planet__dot orbit-planet__dot--green"></span>
				</div>
				<div class="orbit-planet orbit-planet--3">
					<span class="orbit-planet__dot orbit-planet__dot--amber"></span>
				</div>
				<!-- Center -->
				<div class="orbit-center">
					<img src="/Orbitlee-logo-transparent.png" alt="" class="brand__img orbit-center__logo" width="64" height="64" />
				</div>
				<!-- Floating stat chips -->
				<div class="orbit-chip orbit-chip--1">
					<span class="orbit-chip__num">25+</span>
					<span class="orbit-chip__label">Projects</span>
				</div>
				<div class="orbit-chip orbit-chip--2">
					<span class="orbit-chip__num">5★</span>
					<span class="orbit-chip__label">Rating</span>
				</div>
				<div class="orbit-chip orbit-chip--3">
					<span class="orbit-chip__num">8</span>
					<span class="orbit-chip__label">Brands scaled</span>
				</div>
			</div>
		</div>
	</section>

	<!-- ═══════════════════ TICKER ═══════════════════ -->
	<div class="ticker-wrap" aria-hidden="true">
		<div class="ticker">
			<div class="ticker__track">
				{Array.from({length: 3}).map(() => (
					<span class="ticker__item">Strategy</span>
					<span class="ticker__sep">·</span>
					<span class="ticker__item">Brand Identity</span>
					<span class="ticker__sep">·</span>
					<span class="ticker__item">Paid Ads</span>
					<span class="ticker__sep">·</span>
					<span class="ticker__item">AI UGC</span>
					<span class="ticker__sep">·</span>
					<span class="ticker__item">Web Development</span>
					<span class="ticker__sep">·</span>
					<span class="ticker__item">Growth Consulting</span>
					<span class="ticker__sep">·</span>
					<span class="ticker__item">Social Media</span>
					<span class="ticker__sep">·</span>
					<span class="ticker__item">Mobile Apps</span>
					<span class="ticker__sep">·</span>
				))}
			</div>
		</div>
	</div>

	<!-- ═══════════════════ SERVICES ═══════════════════ -->
	<section class="hp-section" id="services" aria-labelledby="services-h">
		<div class="hp-section__intro" data-reveal>
			<div class="hp-section__label">What we do</div>
			<h2 class="hp-section__h2" id="services-h">
				Everything under<br /><span class="gradient-text">one roof.</span>
			</h2>
		</div>

		<div class="svc-rows">
			{serviceRows.map((s, i) => (
				<a href={s.href} class="svc-row" data-reveal style={`transition-delay:${i*0.07}s`}>
					<span class="svc-row__num">{s.num}</span>
					<div class="svc-row__body">
						<h3 class="svc-row__title">{s.title}</h3>
						<p class="svc-row__desc">{s.desc}</p>
					</div>
					<ul class="svc-row__tags" aria-label="Includes">
						{s.tags.map(t => <li>{t}</li>)}
					</ul>
					<span class="svc-row__arrow" aria-hidden="true">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
					</span>
				</a>
			))}
		</div>
	</section>

	<!-- ═══════════════════ WHY ORBITLEE ═══════════════════ -->
	<section class="hp-why" aria-labelledby="why-h">
		<div class="hp-why__head" data-reveal>
			<div class="hp-section__label">Why Orbitlee</div>
			<h2 class="hp-section__h2" id="why-h">
				Full-service,<br /><span class="gradient-text">actually delivered.</span>
			</h2>
		</div>
		<div class="hp-why__grid">
			{whyItems.map((w, i) => (
				<div class="why-feat" data-reveal style={`transition-delay:${(i%2)*0.1}s`}>
					<div class="why-feat__num">{w.num}</div>
					<div class="why-feat__content">
						<span class="why-feat__label">{w.label}</span>
						<h3 class="why-feat__title">{w.title}</h3>
						<p class="why-feat__body">{w.body}</p>
					</div>
				</div>
			))}
		</div>
	</section>

	<!-- ═══════════════════ WORK ═══════════════════ -->
	<section class="hp-section" id="work" aria-labelledby="work-h">
		<div class="hp-section__intro hp-section__intro--split" data-reveal>
			<div>
				<div class="hp-section__label">Client Work</div>
				<h2 class="hp-section__h2" id="work-h">
					Real orbits <span class="gradient-text">we've flown.</span>
				</h2>
				<p class="hp-section__sub">Ad films, AI content, brand identity and design for real brands across India.</p>
			</div>
			<a href="/contact" class="btn btn--ghost">Start yours &rarr;</a>
		</div>

		<div class="work-tabs" role="tablist" aria-label="Portfolio categories">
			<button class="work-tab is-active" role="tab" aria-selected="true" data-tab="videos">
				<span class="work-tab__dot"></span>
				Ad Films & UGC
				<span class="work-tab__count">{clientWork.videos.length}</span>
			</button>
			<button class="work-tab" role="tab" aria-selected="false" data-tab="branding">
				<span class="work-tab__dot"></span>
				Branding & Social
				<span class="work-tab__count">{clientWork.branding.length}</span>
			</button>
			<button class="work-tab" role="tab" aria-selected="false" data-tab="ads">
				<span class="work-tab__dot"></span>
				Ad Creatives
				<span class="work-tab__count">{clientWork.ads.length}</span>
			</button>
			<button class="work-tab" role="tab" aria-selected="false" data-tab="design">
				<span class="work-tab__dot"></span>
				Design
				<span class="work-tab__count">{clientWork.design.length}</span>
			</button>
		</div>

		<div class="work-panel is-active" data-panel="videos" role="tabpanel">
			<div class="work-grid work-grid--videos">
				{clientWork.videos.map((v) => (
					<button class="work-card work-card--video" data-video-src={v.src} data-video-label={v.label} aria-label={`Play ${v.label}`}>
						<video class="work-card__media" data-src={v.src} muted loop playsinline preload="metadata"></video>
						<span class="work-card__play" aria-hidden="true">
							<svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
						</span>
						<span class="work-card__foot">
							<span class="work-card__cat">{v.category}</span>
							<span class="work-card__label">{v.label}</span>
							{v.client && <span class="work-card__client">{v.client}</span>}
						</span>
					</button>
				))}
			</div>
			<div class="work-viewall"><a href="/work" class="btn btn--ghost btn--lg">View all &rarr;</a></div>
		</div>

		<div class="work-panel" data-panel="branding" role="tabpanel">
			<div class="work-grid work-grid--images">
				{clientWork.branding.map((img) => (
					<button class="work-card work-card--image" data-image-src={img.src} data-image-label={img.label} aria-label={`View ${img.label}`}>
						<img class="work-card__media" src={img.src} alt={img.label} loading="lazy" />
						<span class="work-card__foot">
							<span class="work-card__cat">{img.category}</span>
							<span class="work-card__label">{img.label}</span>
							{img.client && <span class="work-card__client">{img.client}</span>}
						</span>
					</button>
				))}
			</div>
			<div class="work-viewall"><a href="/work" class="btn btn--ghost btn--lg">View all &rarr;</a></div>
		</div>

		<div class="work-panel" data-panel="ads" role="tabpanel">
			<div class="work-grid work-grid--images work-grid--ads">
				{clientWork.ads.map((img) => (
					<button class="work-card work-card--image" data-image-src={img.src} data-image-label={img.label} aria-label={`View ${img.label}`}>
						<img class="work-card__media work-card__media--wide" src={img.src} alt={img.label} loading="lazy" />
						<span class="work-card__foot">
							<span class="work-card__cat">{img.category}</span>
							<span class="work-card__label">{img.label}</span>
						</span>
					</button>
				))}
			</div>
			<div class="work-viewall"><a href="/work" class="btn btn--ghost btn--lg">View all &rarr;</a></div>
		</div>

		<div class="work-panel" data-panel="design" role="tabpanel">
			<div class="work-grid work-grid--images work-grid--design">
				{clientWork.design.map((img) => (
					<button class="work-card work-card--image" data-image-src={img.src} data-image-label={img.label} aria-label={`View ${img.label}`}>
						<img class="work-card__media" src={img.src} alt={img.label} loading="lazy" />
						<span class="work-card__foot">
							<span class="work-card__cat">{img.category}</span>
							<span class="work-card__label">{img.label}</span>
						</span>
					</button>
				))}
			</div>
			<div class="work-viewall"><a href="/work" class="btn btn--ghost btn--lg">View all &rarr;</a></div>
		</div>
	</section>

	<!-- LIGHTBOX -->
	<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-hidden="true" aria-label="Media viewer">
		<button class="lightbox__close" type="button" aria-label="Close viewer">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
		</button>
		<div class="lightbox__stage" id="lightbox-stage"></div>
		<p class="lightbox__caption" id="lightbox-caption"></p>
	</div>

	<!-- ═══════════════════ TESTIMONIALS MARQUEE ═══════════════════ -->
	<section class="hp-tm" aria-labelledby="tm-h">
		<div class="hp-tm__head" data-reveal>
			<div class="hp-section__label">Client Testimonials</div>
			<h2 class="hp-section__h2" id="tm-h">Founders who <span class="gradient-text">kept coming back.</span></h2>
		</div>
		<div class="tm-marquee" aria-label="Testimonials" role="list">
			<div class="tm-marquee__track">
				{[...testimonials, ...testimonials].map((t, i) => (
					<figure class="tm-card" role="listitem" itemscope itemtype="https://schema.org/Review">
						<blockquote class="tm-card__quote" itemprop="reviewBody">"{t.quote}"</blockquote>
						<figcaption class="tm-card__foot">
							<span class="tm-card__avatar" style={`background:${t.accent}`} aria-hidden="true">{t.initials}</span>
							<span class="tm-card__id" itemprop="author" itemscope itemtype="https://schema.org/Person">
								<span class="tm-card__name" itemprop="name">{t.name}</span>
								<span class="tm-card__role">{t.role}</span>
							</span>
						</figcaption>
					</figure>
				))}
			</div>
		</div>
	</section>

	<!-- ═══════════════════ FAQ ═══════════════════ -->
	<section class="hp-faq" aria-labelledby="faq-h">
		<div class="hp-faq__left" data-reveal>
			<div class="hp-section__label">FAQ</div>
			<h2 class="hp-section__h2" id="faq-h">Common<br /><span class="gradient-text">questions.</span></h2>
			<p class="hp-faq__sub">Can't find what you're looking for? <a href="/contact" class="hp-faq__link">Reach out directly.</a></p>
		</div>
		<div class="hp-faq__list" data-reveal>
			{faqs.map((f) => (
				<details class="faq-item">
					<summary class="faq-question">{f.q}</summary>
					<div class="faq-body">
						<p class="faq-answer">{f.a}</p>
					</div>
				</details>
			))}
		</div>
	</section>

	<!-- ═══════════════════ CTA ═══════════════════ -->
	<section class="hp-cta" data-reveal>
		<div class="hp-cta__inner">
			<div class="hp-cta__orb hp-cta__orb--1" aria-hidden="true"></div>
			<div class="hp-cta__orb hp-cta__orb--2" aria-hidden="true"></div>
			<div class="hp-cta__content">
				<span class="hp-cta__tag">Let's work together</span>
				<h2 class="hp-cta__h2">Ready to put your brand<br /><em>into orbit?</em></h2>
				<p class="hp-cta__sub">Most briefs get a response within one working day. No slide decks, no pushy sales calls.</p>
				<div class="hp-cta__actions">
					<a href="/contact" class="btn hp-cta__btn-primary magnetic-btn">Book a free audit</a>
					<a href="/work" class="btn hp-cta__btn-ghost">See our work</a>
				</div>
			</div>
		</div>
	</section>

	<script is:inline>
		(function () {
			/* Work tabs */
			document.querySelectorAll('.work-tab').forEach(function (tab) {
				tab.addEventListener('click', function () {
					var target = tab.dataset.tab;
					document.querySelectorAll('.work-tab').forEach(function (t) {
						t.classList.toggle('is-active', t === tab);
						t.setAttribute('aria-selected', t === tab ? 'true' : 'false');
					});
					document.querySelectorAll('.work-panel').forEach(function (p) {
						p.classList.toggle('is-active', p.dataset.panel === target);
					});
					document.querySelectorAll('.work-card--video video').forEach(function (v) { v.pause(); v.currentTime = 0; });
				});
			});

			/* Lazy video */
			function attachVideoSrc(card) {
				var video = card.querySelector('video');
				if (!video || video.src) return;
				var src = video.dataset.src;
				if (!src) return;
				video.src = src + '#t=0.1';
				video.preload = 'metadata';
				video.addEventListener('loadedmetadata', function () { try { video.currentTime = 0.1; } catch (_) {} }, { once: true });
			}
			var videoCards = document.querySelectorAll('.work-card--video');
			if ('IntersectionObserver' in window) {
				var vio = new IntersectionObserver(function (entries) {
					entries.forEach(function (e) { if (e.isIntersecting) { attachVideoSrc(e.target); vio.unobserve(e.target); } });
				}, { rootMargin: '200px' });
				videoCards.forEach(function (c) { vio.observe(c); });
			} else { videoCards.forEach(attachVideoSrc); }

			/* Hover video preview */
			if (!window.matchMedia('(hover: none)').matches) {
				videoCards.forEach(function (card) {
					var v = card.querySelector('video');
					if (!v) return;
					card.addEventListener('mouseenter', function () { attachVideoSrc(card); v.play().catch(function(){}); });
					card.addEventListener('mouseleave', function () { v.pause(); if (v.currentTime) v.currentTime = 0; });
				});
			}

			/* Lightbox */
			var lb = document.getElementById('lightbox');
			var lbStage = document.getElementById('lightbox-stage');
			var lbCaption = document.getElementById('lightbox-caption');
			function openLB(node, label) {
				if (!lb) return;
				lbStage.innerHTML = ''; lbStage.appendChild(node);
				lbCaption.textContent = label || '';
				lb.classList.add('is-open'); lb.setAttribute('aria-hidden', 'false');
				document.body.style.overflow = 'hidden';
			}
			function closeLB() {
				if (!lb) return;
				var v = lbStage.querySelector('video');
				if (v) { v.pause(); v.src = ''; }
				lbStage.innerHTML = ''; lbCaption.textContent = '';
				lb.classList.remove('is-open'); lb.setAttribute('aria-hidden', 'true');
				document.body.style.overflow = '';
			}
			document.querySelectorAll('.work-card--video').forEach(function (c) {
				c.addEventListener('click', function () {
					var v = document.createElement('video');
					v.src = c.dataset.videoSrc; v.controls = true; v.autoplay = true; v.playsInline = true;
					openLB(v, c.dataset.videoLabel);
				});
			});
			document.querySelectorAll('.work-card--image').forEach(function (c) {
				c.addEventListener('click', function () {
					var img = document.createElement('img');
					img.src = c.dataset.imageSrc; img.alt = c.dataset.imageLabel || '';
					openLB(img, c.dataset.imageLabel);
				});
			});
			var lbClose = lb && lb.querySelector('.lightbox__close');
			if (lbClose) lbClose.addEventListener('click', closeLB);
			if (lb) lb.addEventListener('click', function (e) { if (e.target === lb) closeLB(); });
			document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && lb && lb.classList.contains('is-open')) closeLB(); });

			/* FAQ smooth accordion */
			document.querySelectorAll('.faq-item').forEach(function (item) {
				var summary = item.querySelector('.faq-question');
				var body = item.querySelector('.faq-body');
				if (!summary || !body) return;
				function closeItem(it) {
					var b = it.querySelector('.faq-body');
					it.classList.remove('is-open');
					b.style.maxHeight = '0';
					var done = function () { it.open = false; b.removeEventListener('transitionend', done); };
					b.addEventListener('transitionend', done);
				}
				function openItem(it) {
					var b = it.querySelector('.faq-body');
					it.open = true;
					it.classList.add('is-open');
					b.style.maxHeight = '0';
					requestAnimationFrame(function () {
						b.style.maxHeight = b.scrollHeight + 'px';
					});
				}
				summary.addEventListener('click', function (e) {
					e.preventDefault();
					var isOpen = item.classList.contains('is-open');
					document.querySelectorAll('.faq-item.is-open').forEach(function (open) {
						if (open !== item) closeItem(open);
					});
					if (isOpen) closeItem(item);
					else openItem(item);
				});
			});

			/* Magnetic buttons */
			if (!window.matchMedia('(hover: none)').matches) {
				document.querySelectorAll('.magnetic-btn').forEach(function (btn) {
					btn.addEventListener('mousemove', function (e) {
						var r = btn.getBoundingClientRect();
						var x = (e.clientX - r.left - r.width / 2) * 0.2;
						var y = (e.clientY - r.top - r.height / 2) * 0.2;
						btn.style.transform = 'translate(' + x + 'px,' + (y - 2) + 'px)';
					});
					btn.addEventListener('mouseleave', function () { btn.style.transform = ''; });
				});
			}

			/* Pause marquee on hover */
			var tmTrack = document.querySelector('.tm-marquee__track');
			if (tmTrack) {
				tmTrack.addEventListener('mouseenter', function () { tmTrack.style.animationPlayState = 'paused'; });
				tmTrack.addEventListener('mouseleave', function () { tmTrack.style.animationPlayState = 'running'; });
			}

			/* Service row hover line */
			document.querySelectorAll('.svc-row').forEach(function(row) {
				row.addEventListener('mouseenter', function() { row.classList.add('is-hovered'); });
				row.addEventListener('mouseleave', function() { row.classList.remove('is-hovered'); });
			});
		})();
	</script>

</Layout>
