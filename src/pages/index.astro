---
const year = new Date().getFullYear();
const siteUrl = "https://www.orbitlee.com";
const siteTitle = "Orbitlee - Creative & Marketing Agency | Branding, AI Content, Ads & Web";
const siteDescription = "Orbitlee is a creative and marketing agency that unites branding, design, AI-generated content, paid ads and web under one accountable team. 15+ brands scaled. Strategy. Design. Grow.";
const ogImage = `${siteUrl}/Orbitlee-logo-transparent.png`;

const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "Organization",
			"@id": `${siteUrl}/#organization`,
			name: "Orbitlee",
			alternateName: "Orbitlee Creative & Marketing Agency",
			url: siteUrl,
			logo: {
				"@type": "ImageObject",
				url: `${siteUrl}/Orbitlee-logo-transparent.png`,
				width: 512,
				height: 512,
			},
			image: ogImage,
			description: siteDescription,
			slogan: "Strategy. Design. Grow.",
			foundingDate: "2024",
			founder: { "@id": `${siteUrl}/#founder` },
			sameAs: ["https://www.instagram.com/orbitlee_"],
			contactPoint: [
				{
					"@type": "ContactPoint",
					telephone: "+91-98106-92028",
					email: "orbitleeee@gmail.com",
					contactType: "sales",
					areaServed: "IN",
					availableLanguage: ["English", "Hindi"],
				},
			],
			areaServed: { "@type": "Country", name: "India" },
		},
		{
			"@type": "ProfessionalService",
			"@id": `${siteUrl}/#business`,
			name: "Orbitlee",
			url: siteUrl,
			description: siteDescription,
			image: ogImage,
			priceRange: "₹₹",
			areaServed: { "@type": "Country", name: "India" },
			serviceType: [
				"Branding & Strategy",
				"Social Media & Content",
				"AI Generated Content",
				"Graphic Design",
				"UI/UX & Landing Pages",
				"Web & App Development",
				"AI Automation",
				"LinkedIn Sales Outreach",
			],
			hasOfferCatalog: {
				"@type": "OfferCatalog",
				name: "Orbitlee Services",
				itemListElement: [
					{ "@type": "Offer", itemOffered: { "@type": "Service", name: "Branding & Strategy" } },
					{ "@type": "Offer", itemOffered: { "@type": "Service", name: "Social Media & Content" } },
					{ "@type": "Offer", itemOffered: { "@type": "Service", name: "AI Generated Content (UGC)" } },
					{ "@type": "Offer", itemOffered: { "@type": "Service", name: "Graphic Design" } },
					{ "@type": "Offer", itemOffered: { "@type": "Service", name: "UI/UX & Landing Pages" } },
					{ "@type": "Offer", itemOffered: { "@type": "Service", name: "Web & App Development" } },
					{ "@type": "Offer", itemOffered: { "@type": "Service", name: "AI Automation" } },
					{ "@type": "Offer", itemOffered: { "@type": "Service", name: "Sales Outreach on LinkedIn" } },
				],
			},
		},
		{
			"@type": "Person",
			"@id": `${siteUrl}/#founder`,
			name: "Sachin Verma",
			jobTitle: "Founder & Creative Head",
			worksFor: { "@id": `${siteUrl}/#organization` },
			url: siteUrl,
		},
		{
			"@type": "WebSite",
			"@id": `${siteUrl}/#website`,
			url: siteUrl,
			name: "Orbitlee",
			description: siteDescription,
			publisher: { "@id": `${siteUrl}/#organization` },
			inLanguage: "en",
		},
	],
};
const services = [
	{
		num: "01",
		title: "Branding",
		blurb: "Positioning, marks and identity systems built to last and compound over time.",
		items: ["Brand Strategy", "Logo Design", "Visual Identity", "Packaging"],
	},
	{
		num: "02",
		title: "Creative Production",
		blurb: "High-craft content engineered to stop the scroll and move the metric.",
		items: ["AI UGC", "Commercial Ads", "Product Photography", "Motion Graphics"],
	},
	{
		num: "03",
		title: "Marketing",
		blurb: "Full-funnel performance, from cold reach to qualified pipeline.",
		items: ["Meta Ads", "Google Ads", "Social Media Management", "Lead Generation"],
	},
	{
		num: "04",
		title: "Technology",
		blurb: "Websites, products and automations that feel effortless and convert.",
		items: ["Website Development", "Landing Pages", "UI/UX", "AI Automation"],
	},
	{
		num: "05",
		title: "Engineering",
		blurb: "Custom-built software, from MVPs to full-scale platforms engineered to grow with you.",
		items: ["Web Applications", "Mobile Apps", "SaaS Platforms", "API & Integrations"],
	},
	{
		num: "06",
		title: "Consulting",
		blurb: "Sharp diagnostics and clear roadmaps before your next big investment.",
		items: ["Business Growth Audit", "Marketing Strategy", "Brand Audit", "Go-to-Market Strategy"],
	},
];

const stats = [
	{ num: "25+", label: "Projects delivered" },
	{ num: "$100K+", label: "Ad spend managed" },
	{ num: "8", label: "Brands scaled" },
	{ num: "5★", label: "Avg. client rating" },
];

const differentiators = [
	{
		title: "One team, not five vendors",
		body: "Stop stitching an agency, a dev shop and a media consultant together. Everything ships from the same weekly sprint.",
	},
	{
		title: "AI-native production",
		body: "AI UGC, generative creative and automated post-production, 10× the ad variants, without 10× the cost.",
	},
	{
		title: "Speed to launch",
		body: "Brand new to live site, campaign or product in weeks, not quarters. Momentum is a growth channel.",
	},
	{
		title: "In-house dev + marketing",
		body: "Landing pages ship the same day a campaign does. Site and ad account share a nervous system.",
	},
];

const testimonials = [
	{
		quote: "Orbitlee rebuilt our brand from the identity up and had a new site plus paid campaigns live inside six weeks. Revenue is up 3× since launch.",
		name: "Priya Menon",
		role: "Founder",
		company: "Aurora Labs",
		initials: "PM",
		accent: "linear-gradient(135deg, #a3e635, #65a30d)",
	},
	{
		quote: "One team for creative, ads and dev meant we finally stopped losing weeks to handoffs. Things just ship, and keep shipping.",
		name: "Rohan Kapoor",
		role: "Head of Growth",
		company: "Halo Studio",
		initials: "RK",
		accent: "linear-gradient(135deg, #a855f7, #4f46e5)",
	},
	{
		quote: "The audit alone was worth twice what we paid. Then they executed on the roadmap. Rare to find both in the same room.",
		name: "Anaya Sharma",
		role: "CMO",
		company: "Ember & Oak",
		initials: "AS",
		accent: "linear-gradient(135deg, #d946ef, #a855f7)",
	},
	{
		quote: "Their AI UGC pipeline now produces more ad variants in a week than our old agency did in a quarter, at a fraction of the cost.",
		name: "Vikram Reddy",
		role: "Marketing Director",
		company: "Northwind & Co.",
		initials: "VR",
		accent: "linear-gradient(135deg, #f59e0b, #d946ef)",
	},
];

const workVideos = [
	{ src: "/ADVC UGC 1.mp4", label: "ADVC UGC — Spot 1", category: "AI UGC" },
	{ src: "/ADVC UGC 2.mp4", label: "ADVC UGC — Spot 2", category: "AI UGC" },
	{ src: "/Horizon RE NEW SAMPLE.mp4", label: "Horizon Real Estate", category: "Commercial" },
	{ src: "/Gaurya Farms Ghee reel .mp4", label: "Gaurya Farms Ghee", category: "Product Reel" },
	{ src: "/Green Exlir Lip Balm UGC.mp4", label: "Green Elixir Lip Balm", category: "UGC" },
	{ src: "/BA .mp4", label: "BA Campaign", category: "Commercial" },
];

const workImages = [
	{ src: "/AURIX-SM-BANNER.jpg", label: "Aurix — Social Banner", category: "Branding" },
	{ src: "/Post 1.png", label: "Social Post 01", category: "Social" },
	{ src: "/Post 2.png", label: "Social Post 02", category: "Social" },
	{ src: "/Post 3.png", label: "Social Post 03", category: "Social" },
	{ src: "/Post 4.png", label: "Social Post 04", category: "Social" },
	{ src: "/Post-5.png", label: "Social Post 05", category: "Social" },
	{ src: "/Ads-try-1-F.jpg", label: "Ad Creative — Concept 1", category: "Ads" },
	{ src: "/Ads-try-2-F.jpg", label: "Ad Creative — Concept 2", category: "Ads" },
	{ src: "/Ads-try-3&4.jpg", label: "Ad Creative — Concepts 3 & 4", category: "Ads" },
	{ src: "/1.jpg", label: "Portfolio 01", category: "Design" },
	{ src: "/2.jpg", label: "Portfolio 02", category: "Design" },
	{ src: "/3.jpg", label: "Portfolio 03", category: "Design" },
	{ src: "/4.jpg", label: "Portfolio 04", category: "Design" },
	{ src: "/5.jpg", label: "Portfolio 05", category: "Design" },
	{ src: "/6.jpg", label: "Portfolio 06", category: "Design" },
	{ src: "/7.jpg", label: "Portfolio 07", category: "Design" },
	{ src: "/8.jpg", label: "Portfolio 08", category: "Design" },
	{ src: "/9.jpg", label: "Portfolio 09", category: "Design" },
	{ src: "/10.jpg", label: "Portfolio 10", category: "Design" },
	{ src: "/11.jpg", label: "Portfolio 11", category: "Design" },
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />

		<title>{siteTitle}</title>
		<meta name="description" content={siteDescription} />
		<meta name="keywords" content="creative agency India, marketing agency, branding agency, AI UGC, AI generated content, social media marketing, Meta ads, Google ads, landing page design, web development, Orbitlee, Sachin Verma" />
		<meta name="author" content="Sachin Verma" />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<meta name="theme-color" content="#0a0912" />
		<link rel="canonical" href={siteUrl} />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Orbitlee" />
		<meta property="og:url" content={siteUrl} />
		<meta property="og:title" content={siteTitle} />
		<meta property="og:description" content={siteDescription} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:alt" content="Orbitlee — Creative & Marketing Agency" />
		<meta property="og:locale" content="en_IN" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={siteTitle} />
		<meta name="twitter:description" content={siteDescription} />
		<meta name="twitter:image" content={ogImage} />

		<!-- Favicons -->
		<link rel="icon" type="image/png" sizes="32x32" href="/Orbitlee-fav-icon.png" />
		<link rel="icon" type="image/png" sizes="192x192" href="/Orbitlee-fav-icon.png" />
		<link rel="shortcut icon" type="image/png" href="/Orbitlee-fav-icon.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/Orbitlee-fav-icon.png" />

		<!-- Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>

		<!-- Preconnect for form submissions -->
		<link rel="dns-prefetch" href="https://formspree.io" />

		<!-- Structured data -->
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body>
		<div class="ambient"></div>

		<header class="header">
			<a href="#top" class="brand" aria-label="Orbitlee home">
				<img src="/Orbitlee-logo-transparent.png" alt="Orbitlee" width="138" height="40" fetchpriority="high" decoding="async" />
			</a>
			<nav class="nav">
				<a href="#home" data-nav="home">Home</a>
				<a href="#services" data-nav="services">Services</a>
				<a href="#projects" data-nav="projects">Projects</a>
				<a href="#about" data-nav="about">About</a>
				<a href="#contact" data-nav="contact">Contact</a>
			</nav>
			<a href="#contact" class="btn btn--primary btn--sm">Book a free audit</a>
		</header>

		<main id="top">
			<!-- HERO -->
			<section id="home" class="hero">
				<span class="eyebrow">
					<span class="eyebrow__dot"></span>
					We Circle, You Grow.
				</span>
				<h1 class="hero__title">
					Brands that <span class="hero__gradient">ship, sell and scale.</span>
				</h1>
				<p class="hero__sub">
					Strategy, design, marketing and technology, under one team, in one weekly
					sprint. Fewer handoffs, faster growth, one clear line of sight.
				</p>
				<div class="hero__actions">
					<a href="#contact" class="btn btn--primary btn--lg">Book a free brand audit</a>
					<a href="#projects" class="btn btn--ghost btn--lg">See our work →</a>
				</div>
				<p class="hero__micro">
					Free 30-minute audit · No slide deck · Actionable next steps
				</p>
			</section>

			<!-- STAT STRIP -->
			<section class="trust">
				<ul class="stats">
					{stats.map((s) => (
						<li class="stat">
							<span class="stat__num">{s.num}</span>
							<span class="stat__label">{s.label}</span>
						</li>
					))}
				</ul>
			</section>

			<!-- SERVICES -->
			<section id="services" class="section">
				<div class="section__head">
					<span class="eyebrow eyebrow--plain">Services</span>
					<h2 class="section__title">Everything you need to <span class="hero__gradient">grow.</span></h2>
					<p class="section__sub">
						No stitching agencies together. Every discipline under one roof, briefed
						once, moving in sync.
					</p>
				</div>

				<div class="services-grid">
					{services.map((s) => (
						<article class="service">
							<div class="service__head">
								<span class="service__num">{s.num}</span>
								<h3 class="service__title">{s.title}</h3>
							</div>
							<p class="service__blurb">{s.blurb}</p>
							<ul class="service__list">
								{s.items.map((it) => (
									<li>
										<span class="service__tick" aria-hidden="true">
											<svg viewBox="0 0 12 12" fill="none">
												<path d="M2.5 6.5 5 9l4.5-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
											</svg>
										</span>
										{it}
									</li>
								))}
							</ul>
						</article>
					))}
				</div>
			</section>

			<!-- WHY US -->
			<section id="why" class="section section--why">
				<div class="section__head">
					<span class="eyebrow eyebrow--plain">Why Orbitlee</span>
					<h2 class="section__title">Full-service, <span class="hero__gradient">actually delivered.</span></h2>
				</div>

				<div class="why-grid">
					{differentiators.map((d, i) => (
						<article class="why-card">
							<span class="why-card__num">0{i + 1}</span>
							<h3 class="why-card__title">{d.title}</h3>
							<p class="why-card__body">{d.body}</p>
						</article>
					))}
				</div>
			</section>

			<!-- PROCESS -->
			<section id="process" class="section">
				<div class="section__head">
					<span class="eyebrow eyebrow--plain">Process</span>
					<h2 class="section__title">A process built to <span class="hero__gradient">compound.</span></h2>
				</div>

				<ol class="steps">
					<li class="step">
						<div class="step__marker">
							<span class="step__num">01</span>
							<div class="step__icon">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
									<circle cx="11" cy="11" r="7" />
									<path d="m20 20-3.5-3.5" />
								</svg>
							</div>
						</div>
						<h3>Audit</h3>
						<p>A hard look at brand, funnel and product. Where you're leaking growth and the biggest wins hide.</p>
					</li>
					<li class="step">
						<div class="step__marker">
							<span class="step__num">02</span>
							<div class="step__icon">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
									<circle cx="12" cy="12" r="9" />
									<circle cx="12" cy="12" r="5" />
									<circle cx="12" cy="12" r="1.5" fill="currentColor" />
								</svg>
							</div>
						</div>
						<h3>Strategy</h3>
						<p>A crisp, prioritised roadmap tied to business outcomes, not a 60-slide deck no one opens twice.</p>
					</li>
					<li class="step">
						<div class="step__marker">
							<span class="step__num">03</span>
							<div class="step__icon">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
									<path d="M4 20h16" />
									<path d="M6 16 15.5 6.5a2.121 2.121 0 0 1 3 3L9 19l-5 1 1-5Z" />
								</svg>
							</div>
						</div>
						<h3>Design / Build</h3>
						<p>Identity, product, site, campaign creative, shipped as one system, in weekly review cycles.</p>
					</li>
					<li class="step">
						<div class="step__marker">
							<span class="step__num">04</span>
							<div class="step__icon">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
									<path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09Z" />
									<path d="M12 15 9 12a11 11 0 0 1 7-8 11 11 0 0 1 4 4 11 11 0 0 1-8 7Z" />
									<path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0" />
									<path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5" />
								</svg>
							</div>
						</div>
						<h3>Launch</h3>
						<p>Go-live with real testing, analytics and ads. No soft launches that quietly die.</p>
					</li>
					<li class="step">
						<div class="step__marker">
							<span class="step__num">05</span>
							<div class="step__icon">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
									<path d="M3 17 9 11l4 4 8-8" />
									<path d="M14 7h7v7" />
								</svg>
							</div>
						</div>
						<h3>Scale</h3>
						<p>Measure, iterate, compound. The loop that turns launch energy into a permanent orbit.</p>
					</li>
				</ol>
			</section>

			<!-- PROJECTS / WORK -->
			<section id="projects" class="section section--projects">
				<div class="section__head section__head--split">
					<div>
						<span class="eyebrow eyebrow--plain">Our Work</span>
						<h2 class="section__title section__title--left">Recent orbits <span class="hero__gradient">we've flown.</span></h2>
					</div>
					<a href="#contact" class="btn btn--ghost btn--sm">Start yours →</a>
				</div>

				<div class="work-tabs" role="tablist" aria-label="Portfolio filter">
					<button class="work-tab is-active" role="tab" aria-selected="true" data-tab="videos">
						<span class="work-tab__dot"></span>
						Videos
						<span class="work-tab__count">{workVideos.length}</span>
					</button>
					<button class="work-tab" role="tab" aria-selected="false" data-tab="images">
						<span class="work-tab__dot"></span>
						Images
						<span class="work-tab__count">{workImages.length}</span>
					</button>
				</div>

				<div class="work-panel is-active" data-panel="videos">
					<div class="work-grid work-grid--videos">
						{workVideos.map((v) => (
							<button class="work-card work-card--video" data-video-src={v.src} data-video-label={v.label} aria-label={`Play ${v.label}`}>
								<video
									class="work-card__media"
									data-src={v.src}
									muted
									loop
									playsinline
									preload="none"
								></video>
								<span class="work-card__play" aria-hidden="true">
									<svg viewBox="0 0 24 24" fill="currentColor">
										<path d="M8 5v14l11-7z" />
									</svg>
								</span>
								<span class="work-card__foot">
									<span class="work-card__cat">{v.category}</span>
									<span class="work-card__label">{v.label}</span>
								</span>
							</button>
						))}
					</div>
				</div>

				<div class="work-panel" data-panel="images">
					<div class="work-grid work-grid--images">
						{workImages.map((img) => (
							<button class="work-card work-card--image" data-image-src={img.src} data-image-label={img.label} aria-label={`View ${img.label}`}>
								<img class="work-card__media" src={img.src} alt={img.label} loading="lazy" />
								<span class="work-card__foot">
									<span class="work-card__cat">{img.category}</span>
									<span class="work-card__label">{img.label}</span>
								</span>
							</button>
						))}
					</div>
				</div>
			</section>

			<!-- LIGHTBOX / VIDEO MODAL -->
			<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-hidden="true">
				<button class="lightbox__close" type="button" aria-label="Close">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
						<path d="M6 6l12 12M18 6L6 18" />
					</svg>
				</button>
				<div class="lightbox__stage" id="lightbox-stage"></div>
				<p class="lightbox__caption" id="lightbox-caption"></p>
			</div>

			<!-- TESTIMONIALS -->
			<section id="testimonials" class="section section--testimonials">
				<div class="section__head">
					<span class="eyebrow eyebrow--plain">Testimonials</span>
					<h2 class="section__title">Founders who <span class="hero__gradient">kept coming back.</span></h2>
				</div>

				<div class="tm-grid">
					{testimonials.map((t) => (
						<figure class="tm">
							<svg class="tm__mark" viewBox="0 0 32 24" aria-hidden="true">
								<path d="M0 24V14C0 6.3 4.9 1 12 0v5c-3.7 1-6 3.7-6 7h6v12H0Zm20 0V14c0-7.7 4.9-13 12-14v5c-3.7 1-6 3.7-6 7h6v12H20Z" fill="currentColor" />
							</svg>
							<blockquote class="tm__quote">"{t.quote}"</blockquote>
							<figcaption class="tm__foot">
