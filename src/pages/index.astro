			transition: border-color 0.2s;
		}
		.faq-item[open] { border-color: var(--line-strong); }
		.faq-question {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 16px;
			padding: 20px 24px;
			font-size: 16px;
			font-weight: 600;
			cursor: pointer;
			list-style: none;
			color: var(--text);
			user-select: none;
			transition: color 0.2s;
		}
		.faq-question::-webkit-details-marker { display: none; }
		.faq-question::after {
			content: '+';
			font-size: 22px;
			font-weight: 300;
			color: var(--muted);
			flex-shrink: 0;
			transition: transform 0.2s, color 0.2s;
		}
		.faq-item[open] .faq-question::after { transform: rotate(45deg); color: var(--violet); }
		.faq-item[open] .faq-question { color: var(--text); }
		.faq-answer {
			padding: 0 24px 20px;
			margin: 0;
			font-size: 15px;
			color: var(--muted);
			line-height: 1.7;
			border-top: 1px solid var(--line);
			padding-top: 16px;
		}

		@media (max-width: 900px) {
			.work-grid--ads { grid-template-columns: 1fr 1fr; }
			.work-grid--design { grid-template-columns: repeat(3, 1fr); }
		}
		@media (max-width: 640px) {
			.work-grid--ads { grid-template-columns: 1fr 1fr; }
			.work-grid--design { grid-template-columns: 1fr 1fr; }
			.faq-question { padding: 16px 18px; font-size: 15px; }
			.faq-answer { padding: 0 18px 16px; padding-top: 14px; }
		}
	</style>
</Layout>
