---
const year = new Date().getFullYear();
const services = [
	{
		num: "01",
		title: "Branding",
		blurb: "Positioning, marks and identity systems built to last and compound over time.",
		items: ["Brand Strategy", "Logo Design", "Visual Identity", "Packaging"],
	},
	{
		num: "02",
		title: "Creative Production",
		blurb: "High-craft content engineered to stop the scroll and move the metric.",
		items: ["AI UGC", "Commercial Ads", "Product Photography", "Motion Graphics"],
	},
	{
		num: "03",
		title: "Marketing",
		blurb: "Full-funnel performance, from cold reach to qualified pipeline.",
		items: ["Meta Ads", "Google Ads", "Social Media Management", "Lead Generation"],
	},
	{
		num: "04",
		title: "Technology",
		blurb: "Websites, products and automations that feel effortless and convert.",
		items: ["Website Development", "Landing Pages", "UI/UX", "AI Automation"],
	},
	{
		num: "05",
		title: "Engineering",
		blurb: "Custom-built software, from MVPs to full-scale platforms engineered to grow with you.",
		items: ["Web Applications", "Mobile Apps", "SaaS Platforms", "API & Integrations"],
	},
	{
		num: "06",
		title: "Consulting",
		blurb: "Sharp diagnostics and clear roadmaps before your next big investment.",
		items: ["Business Growth Audit", "Marketing Strategy", "Brand Audit", "Go-to-Market Strategy"],
	},
];

const stats = [
	{ num: "25+", label: "Projects delivered" },
	{ num: "$100K+", label: "Ad spend managed" },
	{ num: "8", label: "Brands scaled" },
	{ num: "5★", label: "Avg. client rating" },
];

const differentiators = [
	{
		title: "One team, not five vendors",
		body: "Stop stitching an agency, a dev shop and a media consultant together. Everything ships from the same weekly sprint.",
	},
	{
		title: "AI-native production",
		body: "AI UGC, generative creative and automated post-production, 10× the ad variants, without 10× the cost.",
	},
	{
		title: "Speed to launch",
		body: "Brand new to live site, campaign or product in weeks, not quarters. Momentum is a growth channel.",
	},
	{
		title: "In-house dev + marketing",
		body: "Landing pages ship the same day a campaign does. Site and ad account share a nervous system.",
	},
];

const testimonials = [
	{
		quote: "Orbitlee rebuilt our brand from the identity up and had a new site plus paid campaigns live inside six weeks. Revenue is up 3× since launch.",
		name: "Priya Menon",
		role: "Founder",
		company: "Aurora Labs",
		initials: "PM",
		accent: "linear-gradient(135deg, #a3e635, #65a30d)",
	},
	{
		quote: "One team for creative, ads and dev meant we finally stopped losing weeks to handoffs. Things just ship, and keep shipping.",
		name: "Rohan Kapoor",
		role: "Head of Growth",
		company: "Halo Studio",
		initials: "RK",
		accent: "linear-gradient(135deg, #a855f7, #4f46e5)",
	},
	{
		quote: "The audit alone was worth twice what we paid. Then they executed on the roadmap. Rare to find both in the same room.",
		name: "Anaya Sharma",
		role: "CMO",
		company: "Ember & Oak",
		initials: "AS",
		accent: "linear-gradient(135deg, #d946ef, #a855f7)",
	},
	{
		quote: "Their AI UGC pipeline now produces more ad variants in a week than our old agency did in a quarter, at a fraction of the cost.",
		name: "Vikram Reddy",
		role: "Marketing Director",
		company: "Northwind & Co.",
		initials: "VR",
		accent: "linear-gradient(135deg, #f59e0b, #d946ef)",
	},
];

const projects = [
	{
		name: "Aurora Labs",
		category: "Branding · Ecommerce",
		blurb: "A clean-beauty rebrand, packaging system and Shopify launch that lifted AOV by 42%.",
		tags: ["Identity", "Packaging", "Shopify"],
		style: { "--p-a": "#a3e635", "--p-b": "#65a30d" },
	},
	{
		name: "Kavya Foods",
		category: "Packaging · Retail",
		blurb: "Heritage spice startup, full identity system across 24 SKUs, ready for shelf.",
		tags: ["Brand", "Packaging"],
		style: { "--p-a": "#d946ef", "--p-b": "#a855f7" },
	},
	{
		name: "Halo Studio",
		category: "Product · UI/UX",
		blurb: "Marketing site and dashboard UI for a fast-scaling productivity app.",
		tags: ["Website", "UI/UX", "Motion"],
		style: { "--p-a": "#a855f7", "--p-b": "#4f46e5" },
	},
	{
		name: "Northwind & Co.",
		category: "Marketing · Campaign",
		blurb: "Meta + Google performance program for a boutique fashion label, 3.2× ROAS in 90 days.",
		tags: ["Meta Ads", "Google Ads", "Creative"],
		style: { "--p-a": "#f59e0b", "--p-b": "#d946ef" },
	},
	{
		name: "Ember & Oak",
		category: "Hospitality · Brand",
		blurb: "Full identity for a hospitality group, from wordmark to menu to signage.",
		tags: ["Identity", "Print", "Signage"],
		style: { "--p-a": "#f472b6", "--p-b": "#a855f7" },
	},
	{
		name: "Loop Robotics",
		category: "Motion · Launch",
		blurb: "Product launch film and motion system for a Series-A robotics company.",
		tags: ["Motion", "Film", "Web"],
		style: { "--p-a": "#22d3ee", "--p-b": "#a855f7" },
	},
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" sizes="32x32" href="/Orbitlee-fav-icon.png" />
		<link rel="icon" type="image/png" sizes="192x192" href="/Orbitlee-fav-icon.png" />
		<link rel="shortcut icon" type="image/png" href="/Orbitlee-fav-icon.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/Orbitlee-fav-icon.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Orbitlee, Strategy. Design. Grow. We Circle, You Grow." />
		<title>Orbitlee, We Circle, You Grow</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<div class="ambient"></div>

		<header class="header">
			<a href="#top" class="brand" aria-label="Orbitlee home">
				<img src="/Orbitlee-logo-transparent.png" alt="Orbitlee" />
			</a>
			<nav class="nav">
				<a href="#home" data-nav="home">Home</a>
				<a href="#services" data-nav="services">Services</a>
				<a href="#projects" data-nav="projects">Projects</a>
				<a href="#about" data-nav="about">About</a>
				<a href="#contact" data-nav="contact">Contact</a>
			</nav>
			<a href="#contact" class="btn btn--primary btn--sm">Book a free audit</a>
		</header>

		<main id="top">
			<!-- HERO -->
			<section id="home" class="hero">
				<span class="eyebrow">
					<span class="eyebrow__dot"></span>
					We Circle, You Grow.
				</span>
				<h1 class="hero__title">
					Brands that <span class="hero__gradient">ship, sell and scale.</span>
				</h1>
				<p class="hero__sub">
					Strategy, design, marketing and technology, under one team, in one weekly
					sprint. Fewer handoffs, faster growth, one clear line of sight.
				</p>
				<div class="hero__actions">
					<a href="#contact" class="btn btn--primary btn--lg">Book a free brand audit</a>
					<a href="#projects" class="btn btn--ghost btn--lg">See our work →</a>
				</div>
				<p class="hero__micro">
					Free 30-minute audit · No slide deck · Actionable next steps
				</p>
			</section>

			<!-- STAT STRIP -->
			<section class="trust">
				<ul class="stats">
					{stats.map((s) => (
						<li class="stat">
							<span class="stat__num">{s.num}</span>
							<span class="stat__label">{s.label}</span>
						</li>
					))}
				</ul>
			</section>

			<!-- SERVICES -->
			<section id="services" class="section">
				<div class="section__head">
					<span class="eyebrow eyebrow--plain">Services</span>
					<h2 class="section__title">Everything you need to <span class="hero__gradient">grow.</span></h2>
					<p class="section__sub">
						No stitching agencies together. Every discipline under one roof, briefed
						once, moving in sync.
					</p>
				</div>

				<div class="services-grid">
					{services.map((s) => (
						<article class="service">
							<div class="service__head">
								<span class="service__num">{s.num}</span>
								<h3 class="service__title">{s.title}</h3>
							</div>
							<p class="service__blurb">{s.blurb}</p>
							<ul class="service__list">
								{s.items.map((it) => (
									<li>
										<span class="service__tick" aria-hidden="true">
											<svg viewBox="0 0 12 12" fill="none">
												<path d="M2.5 6.5 5 9l4.5-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
											</svg>
										</span>
										{it}
									</li>
								))}
							</ul>
						</article>
					))}
				</div>
			</section>

			<!-- WHY US -->
			<section id="why" class="section section--why">
				<div class="section__head">
					<span class="eyebrow eyebrow--plain">Why Orbitlee</span>
					<h2 class="section__title">Full-service, <span class="hero__gradient">actually delivered.</span></h2>
				</div>

				<div class="why-grid">
					{differentiators.map((d, i) => (
						<article class="why-card">
							<span class="why-card__num">0{i + 1}</span>
							<h3 class="why-card__title">{d.title}</h3>
							<p class="why-card__body">{d.body}</p>
						</article>
					))}
				</div>
			</section>

			<!-- PROCESS -->
			<section id="process" class="section">
				<div class="section__head">
					<span class="eyebrow eyebrow--plain">Process</span>
					<h2 class="section__title">A process built to <span class="hero__gradient">compound.</span></h2>
				</div>

				<ol class="steps">
					<li class="step">
						<div class="step__icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
								<circle cx="11" cy="11" r="7" />
								<path d="m20 20-3.5-3.5" />
							</svg>
						</div>
						<h3>Audit</h3>
						<p>A hard look at brand, funnel and product. Where you're leaking growth and where the biggest wins hide.</p>
					</li>
					<li class="step">
						<div class="step__icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
								<circle cx="12" cy="12" r="9" />
								<circle cx="12" cy="12" r="5" />
								<circle cx="12" cy="12" r="1.5" fill="currentColor" />
							</svg>
						</div>
						<h3>Strategy</h3>
						<p>A crisp, prioritised roadmap tied to business outcomes, not a 60-slide deck no one opens twice.</p>
					</li>
					<li class="step">
						<div class="step__icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
								<path d="M4 20h16" />
								<path d="M6 16 15.5 6.5a2.121 2.121 0 0 1 3 3L9 19l-5 1 1-5Z" />
							</svg>
						</div>
						<h3>Design / Build</h3>
						<p>Identity, product, site, campaign creative, shipped as one system, in weekly review cycles.</p>
					</li>
					<li class="step">
						<div class="step__icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
								<path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09Z" />
								<path d="M12 15 9 12a11 11 0 0 1 7-8 11 11 0 0 1 4 4 11 11 0 0 1-8 7Z" />
								<path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0" />
								<path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5" />
							</svg>
						</div>
						<h3>Launch</h3>
						<p>Go-live with real testing, real analytics and real ads. No soft launches that quietly die.</p>
					</li>
					<li class="step">
						<div class="step__icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
								<path d="M3 17 9 11l4 4 8-8" />
								<path d="M14 7h7v7" />
							</svg>
						</div>
						<h3>Scale</h3>
						<p>Measure, iterate, compound. The loop that turns launch energy into a permanent orbit.</p>
					</li>
				</ol>
			</section>

			<!-- PROJECTS -->
			<section id="projects" class="section section--projects">
				<div class="section__head section__head--split">
					<div>
						<span class="eyebrow eyebrow--plain">Projects</span>
						<h2 class="section__title section__title--left">Recent orbits <span class="hero__gradient">we've flown.</span></h2>
					</div>
					<a href="#contact" class="btn btn--ghost btn--sm">Start yours →</a>
				</div>

				<div class="projects-grid">
					{projects.map((p) => (
						<article class="project" style={p.style}>
							<div class="project__cover">
								<span class="project__mono">{p.name.charAt(0)}</span>
								<span class="project__cat">{p.category}</span>
							</div>
							<div class="project__body">
								<h3 class="project__title">{p.name}</h3>
								<p class="project__blurb">{p.blurb}</p>
								<div class="project__tags">
									{p.tags.map((t) => (
										<span class="project__tag">{t}</span>
									))}
								</div>
							</div>
						</article>
					))}
				</div>
			</section>

			<!-- TESTIMONIALS -->
			<section id="testimonials" class="section section--testimonials">
				<div class="section__head">
					<span class="eyebrow eyebrow--plain">Testimonials</span>
					<h2 class="section__title">Founders who <span class="hero__gradient">kept coming back.</span></h2>
				</div>

				<div class="tm-grid">
					{testimonials.map((t) => (
						<figure class="tm">
							<svg class="tm__mark" viewBox="0 0 32 24" aria-hidden="true">
								<path d="M0 24V14C0 6.3 4.9 1 12 0v5c-3.7 1-6 3.7-6 7h6v12H0Zm20 0V14c0-7.7 4.9-13 12-14v5c-3.7 1-6 3.7-6 7h6v12H20Z" fill="currentColor" />
							</svg>
							<blockquote class="tm__quote">"{t.quote}"</blockquote>
							<figcaption class="tm__foot">
								<span class="tm__avatar" style={`background: ${t.accent}`}>{t.initials}</span>
								<span class="tm__id">
									<span class="tm__name">{t.name}</span>
									<span class="tm__role">{t.role} · {t.company}</span>
								</span>
							</figcaption>
						</figure>
					))}
				</div>
			</section>

			<!-- ABOUT -->
			<section id="about" class="about">
				<div class="about__copy">
					<span class="eyebrow eyebrow--plain">Why Orbitlee</span>
					<h2 class="section__title section__title--left">We circle <span class="hero__gradient">until it opens.</span></h2>
					<p class="about__lead">
						Most agencies work in silos, a strategy deck here, a design file there,
						an ad account somewhere else. Nothing compounds.
					</p>
					<p class="about__lead">
						We work as one team on one brief, in one weekly cadence. Fewer handoffs.
						Sharper decisions. Faster growth.
					</p>
					<ul class="about__points">
						<li><span class="about__check">✓</span> Senior team on every engagement</li>
						<li><span class="about__check">✓</span> Weekly sprints with transparent progress</li>
						<li><span class="about__check">✓</span> Measured on outcomes, not deliverables</li>
					</ul>
				</div>
				<div class="about__logo">
					<img src="/Orbitlee-logo-transparent.png" alt="" />
				</div>
			</section>

			<!-- CONTACT -->
			<section id="contact" class="contact">
				<div class="contact__intro">
					<span class="eyebrow eyebrow--plain">Contact</span>
					<h2 class="section__title section__title--left">Let's put your brand <span class="hero__gradient">into orbit.</span></h2>
					<p class="about__lead">
						Tell us where you want to go, we'll draw the trajectory and fly it with you.
						Most briefs get a response within one working day.
					</p>
					<div class="contact__meta">
						<div class="contact__meta-item">
							<span class="contact__meta-label">Email</span>
							<a href="mailto:hello@orbitlee.com">hello@orbitlee.com</a>
						</div>
						<div class="contact__meta-item">
							<span class="contact__meta-label">Response time</span>
							<span>Within 1 business day</span>
						</div>
					</div>
				</div>

				<form class="form" id="contact-form" action="https://formspree.io/f/moeajqjw" method="POST" novalidate>
					<div class="form__row form__row--two">
						<label class="field">
							<span class="field__label">Full name <span class="req">*</span></span>
							<input type="text" name="name" required placeholder="Jane Doe" />
						</label>
						<label class="field">
							<span class="field__label">Email <span class="req">*</span></span>
							<input type="email" name="email" required placeholder="jane@company.com" />
						</label>
					</div>
					<div class="form__row form__row--two">
						<label class="field">
							<span class="field__label">Company</span>
							<input type="text" name="company" placeholder="Acme Inc." />
						</label>
						<label class="field">
							<span class="field__label">Budget</span>
							<select name="budget">
								<option value="">Select a range</option>
								<option value="< ₹1L">Under ₹1L</option>
								<option value="₹1L – ₹5L">₹1L – ₹5L</option>
								<option value="₹5L – ₹15L">₹5L – ₹15L</option>
								<option value="₹15L +">₹15L +</option>
								<option value="Not sure yet">Not sure yet</option>
							</select>
						</label>
					</div>
					<fieldset class="field field--chips">
						<legend class="field__label">What do you need help with? <span class="hint">(pick any)</span></legend>
						<div class="chips">
							{services.map((s) => (
								<label class="chip">
									<input type="checkbox" name="services" value={s.title} />
									<span>{s.title}</span>
								</label>
							))}
						</div>
					</fieldset>
					<label class="field">
						<span class="field__label">Tell us about your project <span class="req">*</span></span>
						<textarea name="message" rows="5" required placeholder="A few lines about your business, what you're trying to solve, and your timeline."></textarea>
					</label>
					<div class="form__foot">
						<button type="submit" class="btn btn--primary btn--lg">
							Send the brief
						</button>
						<p class="form__note" id="form-note" role="status"></p>
					</div>
				</form>
			</section>
		</main>

		<footer class="footer">
			<div class="footer__top">
				<a href="#top" class="footer__brand">
					<img src="/Orbitlee-logo-transparent.png" alt="Orbitlee" />
				</a>
				<nav class="footer__nav">
					<a href="#services">Services</a>
					<a href="#projects">Projects</a>
					<a href="#about">About</a>
					<a href="#contact">Contact</a>
				</nav>
			</div>
			<div class="footer__bar">
				<p class="footer__tag">We Circle, You Grow.</p>
				<p class="footer__copy">© {year} Orbitlee. All rights reserved.</p>
			</div>
		</footer>

		<script is:inline>
			// Highlight nav item for the section currently in view
			(function () {
				const navLinks = document.querySelectorAll('.nav a[data-nav]');
				const sections = Array.from(navLinks)
					.map((link) => ({ link, el: document.getElementById(link.getAttribute('data-nav')) }))
					.filter((s) => s.el);

				function updateActive() {
					const trigger = window.scrollY + window.innerHeight * 0.32;
					let active = sections[0];
					for (const s of sections) {
						if (s.el.offsetTop <= trigger) active = s;
					}
					sections.forEach((s) => s.link.classList.remove('active'));
					if (active) active.link.classList.add('active');
				}

				window.addEventListener('scroll', updateActive, { passive: true });
				window.addEventListener('resize', updateActive);
				updateActive();
			})();

			const form = document.getElementById('contact-form');
			const note = document.getElementById('form-note');
			if (form) {
				const submitBtn = form.querySelector('button[type="submit"]');
				const defaultLabel = submitBtn ? submitBtn.textContent : 'Send';

				form.addEventListener('submit', async (e) => {
					e.preventDefault();
					const data = new FormData(form);
					const name = (data.get('name') || '').toString().trim();
					const email = (data.get('email') || '').toString().trim();
					const message = (data.get('message') || '').toString().trim();

					if (!name || !email || !message) {
						note.textContent = 'Please fill in name, email and a short message.';
						note.classList.add('form__note--error');
						return;
					}

					note.textContent = '';
					note.classList.remove('form__note--error');
					if (submitBtn) {
						submitBtn.disabled = true;
						submitBtn.textContent = 'Sending...';
					}

					try {
						const res = await fetch(form.action, {
							method: 'POST',
							body: data,
							headers: { Accept: 'application/json' },
						});

						if (res.ok) {
							note.textContent = "Thanks! Your brief is in. We'll be in touch within one business day.";
							form.reset();
						} else {
							let msg = 'Something went wrong. Please try again or email hello@orbitlee.com';
							try {
								const body = await res.json();
								if (body && body.errors && body.errors.length) {
									msg = body.errors.map((er) => er.message).join(', ');
								}
							} catch (_) {}
							note.textContent = msg;
							note.classList.add('form__note--error');
						}
					} catch (err) {
						note.textContent = 'Network error. Please try again or email hello@orbitlee.com';
