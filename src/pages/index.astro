---
import StudioLayout from '../layouts/StudioLayout.astro';
import { featuredWork, servicePillars } from '../lib/content';

const process = [
	{ n: '01', t: 'Orbit', d: 'Free 30-minute call. We audit brand, product and channels.' },
	{ n: '02', t: 'Chart', d: 'A 12-week roadmap: message, funnel, media, what ships first.' },
	{ n: '03', t: 'Launch', d: 'Design, UGC, ads and site — one in-house pod, not five vendors.' },
	{ n: '04', t: 'Compound', d: 'Weekly reporting. Cut what fails. Scale what works.' },
];
---

<StudioLayout>
	<section class="hero container">
		<div class="hero__grid">
			<div>
				<p class="eyebrow"><span class="eyebrow__dot"></span> Delhi studio · Strategy. Design. Grow.</p>
				<h1>A creative agency that puts your brand in <em>orbit</em>.</h1>
				<p class="hero__lead">
					Identity, AI UGC, social, paid ads and websites — briefed once, shipped by the same team. 15+ brands. 3.8× average ROAS.
				</p>
				<div class="hero__actions">
					<a href="/work" class="btn btn--solid">See client work</a>
					<a href="/contact" class="btn btn--ghost">Book a free audit</a>
				</div>
			</div>
			<div class="hero__visual">
				<img src="/Post 3.png" alt="Wildcraft campaign creative produced by Orbitlee" />
				<img class="hero__mark" src="/Orbitlee-fav-icon.png" alt="" width="72" height="67" />
			</div>
		</div>
	</section>

	<div class="band-wrap">
		<div class="band">
			{['Ortholite', 'JK Junglee Honey', 'Green Elixir', 'Windsouls Goa', 'Gaurya Farms', 'Budweiser', 'Aurix', 'WeCredit', 'Prime Figurzz'].concat(['Ortholite', 'JK Junglee Honey', 'Green Elixir', 'Windsouls Goa', 'Gaurya Farms', 'Budweiser', 'Aurix', 'WeCredit', 'Prime Figurzz']).map((name) => (
				<span>{name}</span>
			))}
		</div>
	</div>

	<section class="section">
		<div class="container">
			<p class="kicker">Selected work</p>
			<h2 class="h2">Real campaigns. Real <em>clients</em>.</h2>
			<p class="lede">Every still below shipped for a brand — Amazon creatives, social, UGC, OOH and print. Open the full archive for films.</p>
			<div class="cases">
				<a class="case" href="/work">
					<img src={featuredWork[0].img} alt={`${featuredWork[0].client} — ${featuredWork[0].tag}`} />
					<span class="case__meta">
						<small>{featuredWork[0].tag}</small>
						<strong>{featuredWork[0].client}</strong>
					</span>
				</a>
				<div class="cases--stack">
					{featuredWork.slice(1, 3).map((w) => (
						<a class="case" href="/work">
							<img src={w.img} alt={`${w.client} — ${w.tag}`} loading="lazy" />
							<span class="case__meta">
								<small>{w.tag}</small>
								<strong>{w.client}</strong>
							</span>
						</a>
					))}
				</div>
			</div>
			<div class="mosaic" style="margin-top: 12px;">
				{featuredWork.slice(3).map((w) => (
					<a href="/work">
						<img src={w.img} alt={`${w.client} — ${w.tag}`} loading="lazy" />
					</a>
				))}
			</div>
			<p style="margin-top: 24px;"><a href="/work" class="btn btn--ghost">View full portfolio</a></p>
		</div>
	</section>

	<ul class="stats container" aria-label="Studio results">
		<li><strong>15+</strong><span>Brands scaled</span></li>
		<li><strong>3.8×</strong><span>Average ROAS</span></li>
		<li><strong>−42%</strong><span>CPL reduction</span></li>
		<li><strong>₹12Cr+</strong><span>Media spend managed</span></li>
	</ul>

	<section class="section">
		<div class="container">
			<p class="kicker">Services</p>
			<h2 class="h2">One brief. The whole <em>stack</em>.</h2>
			<p class="lede">Digital, performance, social, software and web — briefed once, moving in the same weekly sprint. Branding and growth sit alongside when you need them.</p>
			<div class="svc-cards">
				{servicePillars.map((s) => (
					<a class="svc-card" href={s.href}>
						<img src={s.img} alt="" loading="lazy" />
						<div>
							<h3>{s.title}</h3>
							<p>{s.blurb}</p>
							<ul>{s.items.map((i) => <li>{i}</li>)}</ul>
						</div>
					</a>
				))}
			</div>
		</div>
	</section>

	<section class="section" style="padding-top: 0;">
		<div class="container">
			<p class="kicker">How we work</p>
			<h2 class="h2">Four moves. Twelve weeks.</h2>
			<div class="steps" style="margin-top: 36px;">
				{process.map((p) => (
					<article class="step">
						<span class="step__n">{p.n}</span>
						<h3>{p.t}</h3>
						<p>{p.d}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="cta-block">
		<div>
			<p class="kicker">Free 30-minute audit</p>
			<h2>Tell us where it leaks. We’ll map the orbit.</h2>
			<p>No 60-slide deck. Actionable next steps within a working day.</p>
		</div>
		<a href="/contact" class="btn btn--solid">Start a project</a>
	</section>
</StudioLayout>
