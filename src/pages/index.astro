			justify-content: center;
			margin-top: 32px;
		}

		/* FAQ */
		.faq-list {
			display: flex;
			flex-direction: column;
			gap: 12px;
			max-width: 860px;
			margin: 0 auto;
		}
		.faq-item {
			background: var(--panel);
