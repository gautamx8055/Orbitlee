---
import Layout from '../layouts/Layout.astro';

const stats = [
	{ num: "25+", label: "Projects delivered" },
	{ num: "$100K+", label: "Ad spend managed" },
	{ num: "8", label: "Brands scaled" },
	{ num: "5★", label: "Avg. client rating" },
];

const serviceOverview = [
	{
		href: "/services/marketing-advertising",
		title: "Marketing & Advertising",
		desc: "Full-funnel performance from cold reach to qualified pipeline. Meta, Google, social and AI-native content.",
		items: ["Meta Ads", "Google Ads", "Social Media", "AI UGC"],
		icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>`,
	},
	{
		href: "/services/web-app-development",
		title: "Web & App Development",
		desc: "Sites, products and automations that feel effortless, load fast and convert visitors into customers.",
		items: ["Websites", "Landing Pages", "Mobile Apps", "AI Automation"],
		icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>`,
	},
	{
		href: "/services/branding-creative",
		title: "Branding & Creative",
		desc: "Positioning, identity and high-craft production that stops the scroll and makes your brand stick.",
		items: ["Brand Strategy", "Logo & Identity", "AI UGC", "Commercial Ads"],
		icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>`,
	},
	{
		href: "/services/growth-consulting",
		title: "Growth Consulting",
		desc: "Sharp diagnostics and clear roadmaps before your next big investment. Audits, strategy, go-to-market.",
		items: ["Growth Audit", "Brand Audit", "GTM Strategy", "Marketing Strategy"],
		icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17 9 11l4 4 8-8"/><path d="M14 7h7v7"/></svg>`,
	},
];

const testimonials = [
	{
		quote: "Orbitlee rebuilt our brand from the identity up and had a new site plus paid campaigns live inside six weeks. Revenue is up 3× since launch.",
		name: "Priya Menon",
		role: "Founder",
		company: "Aurora Labs",
		initials: "PM",
		accent: "linear-gradient(135deg, #a3e635, #65a30d)",
	},
	{
		quote: "One team for creative, ads and dev meant we finally stopped losing weeks to handoffs. Things just ship, and keep shipping.",
		name: "Rohan Kapoor",
		role: "Head of Growth",
		company: "Halo Studio",
		initials: "RK",
		accent: "linear-gradient(135deg, #a855f7, #4f46e5)",
	},
];

const workVideos = [
	{ src: "/ADVC UGC 1.mp4", label: "ADVC UGC — Spot 1", category: "AI UGC" },
	{ src: "/ADVC UGC 2.mp4", label: "ADVC UGC — Spot 2", category: "AI UGC" },
	{ src: "/Horizon RE NEW SAMPLE.mp4", label: "Horizon Real Estate", category: "Commercial" },
	{ src: "/Gaurya Farms Ghee reel .mp4", label: "Gaurya Farms Ghee", category: "Product Reel" },
	{ src: "/Green Exlir Lip Balm UGC.mp4", label: "Green Elixir Lip Balm", category: "UGC" },
	{ src: "/BA .mp4", label: "BA Campaign", category: "Commercial" },
];

const workImages = [
	{ src: "/AURIX-SM-BANNER.jpg", label: "Aurix — Social Banner", category: "Branding" },
	{ src: "/Post 1.png", label: "Social Post 01", category: "Social" },
	{ src: "/Post 2.png", label: "Social Post 02", category: "Social" },
	{ src: "/Post 3.png", label: "Social Post 03", category: "Social" },
	{ src: "/Post 4.png", label: "Social Post 04", category: "Social" },
	{ src: "/Post-5.png", label: "Social Post 05", category: "Social" },
	{ src: "/Ads-try-1-F.jpg", label: "Ad Creative — Concept 1", category: "Ads" },
	{ src: "/Ads-try-2-F.jpg", label: "Ad Creative — Concept 2", category: "Ads" },
	{ src: "/Ads-try-3&4.jpg", label: "Ad Creative — Concepts 3 & 4", category: "Ads" },
	{ src: "/1.jpg", label: "Portfolio 01", category: "Design" },
	{ src: "/2.jpg", label: "Portfolio 02", category: "Design" },
	{ src: "/3.jpg", label: "Portfolio 03", category: "Design" },
	{ src: "/4.jpg", label: "Portfolio 04", category: "Design" },
	{ src: "/5.jpg", label: "Portfolio 05", category: "Design" },
	{ src: "/6.jpg", label: "Portfolio 06", category: "Design" },
	{ src: "/7.jpg", label: "Portfolio 07", category: "Design" },
	{ src: "/8.jpg", label: "Portfolio 08", category: "Design" },
	{ src: "/9.jpg", label: "Portfolio 09", category: "Design" },
	{ src: "/10.jpg", label: "Portfolio 10", category: "Design" },
	{ src: "/11.jpg", label: "Portfolio 11", category: "Design" },
];
---

<Layout>
	<!-- HERO -->
	<section class="hero">
		<span class="eyebrow">
			<span class="eyebrow__dot"></span>
			We Circle, You Grow.
		</span>
		<h1 class="hero__title">
			Brands that <span class="hero__gradient">ship, sell and scale.</span>
		</h1>
		<p class="hero__sub">
			Strategy, design, marketing and technology — under one team, in one weekly sprint. Fewer handoffs, faster growth, one clear line of sight.
		</p>
		<div class="hero__actions">
			<a href="/contact" class="btn btn--primary btn--lg">Book a free brand audit</a>
			<a href="#projects" class="btn btn--ghost btn--lg">See our work →</a>
		</div>
		<p class="hero__micro">Free 30-minute audit · No slide deck · Actionable next steps</p>
	</section>

	<!-- STATS -->
	<section class="trust">
		<ul class="stats">
			{stats.map((s) => (
				<li class="stat">
					<span class="stat__num">{s.num}</span>
					<span class="stat__label">{s.label}</span>
				</li>
			))}
		</ul>
	</section>

	<!-- WHAT WE DO -->
	<section class="section">
		<div class="section__head">
			<span class="eyebrow eyebrow--plain">What we do</span>
			<h2 class="section__title">Everything you need to <span class="hero__gradient">grow.</span></h2>
			<p class="section__sub">No stitching agencies together. Every discipline under one roof, briefed once, moving in sync.</p>
		</div>
		<div class="service-overview-grid">
			{serviceOverview.map((s) => (
				<a href={s.href} class="service-overview-card">
					<div class="service-overview-card__icon" set:html={s.icon}></div>
					<h3 class="service-overview-card__title">{s.title}</h3>
					<p class="service-overview-card__desc">{s.desc}</p>
					<ul class="service-overview-card__items">
						{s.items.map((item) => <li>{item}</li>)}
					</ul>
					<span class="service-overview-card__link">Explore {s.title} →</span>
				</a>
			))}
		</div>
	</section>

	<!-- PROJECTS / WORK -->
	<section id="projects" class="section section--projects">
		<div class="section__head section__head--split">
			<div>
				<span class="eyebrow eyebrow--plain">Our Work</span>
				<h2 class="section__title section__title--left">Recent orbits <span class="hero__gradient">we've flown.</span></h2>
			</div>
			<a href="/contact" class="btn btn--ghost btn--sm">Start yours →</a>
		</div>

		<div class="work-tabs" role="tablist" aria-label="Portfolio filter">
			<button class="work-tab is-active" role="tab" aria-selected="true" data-tab="videos">
				<span class="work-tab__dot"></span>
				Videos
				<span class="work-tab__count">{workVideos.length}</span>
			</button>
			<button class="work-tab" role="tab" aria-selected="false" data-tab="images">
				<span class="work-tab__dot"></span>
				Images
				<span class="work-tab__count">{workImages.length}</span>
			</button>
		</div>

		<div class="work-panel is-active" data-panel="videos">
			<div class="work-grid work-grid--videos">
				{workVideos.map((v) => (
					<button class="work-card work-card--video" data-video-src={v.src} data-video-label={v.label} aria-label={`Play ${v.label}`}>
						<video class="work-card__media" data-src={v.src} muted loop playsinline preload="none"></video>
						<span class="work-card__play" aria-hidden="true">
							<svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
						</span>
						<span class="work-card__foot">
							<span class="work-card__cat">{v.category}</span>
							<span class="work-card__label">{v.label}</span>
						</span>
					</button>
				))}
			</div>
		</div>

		<div class="work-panel" data-panel="images">
			<div class="work-grid work-grid--images">
				{workImages.map((img) => (
					<button class="work-card work-card--image" data-image-src={img.src} data-image-label={img.label} aria-label={`View ${img.label}`}>
						<img class="work-card__media" src={img.src} alt={img.label} loading="lazy" />
						<span class="work-card__foot">
							<span class="work-card__cat">{img.category}</span>
							<span class="work-card__label">{img.label}</span>
						</span>
					</button>
				))}
			</div>
		</div>
	</section>

	<!-- LIGHTBOX -->
	<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-hidden="true">
		<button class="lightbox__close" type="button" aria-label="Close">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
				<path d="M6 6l12 12M18 6L6 18"/>
			</svg>
		</button>
		<div class="lightbox__stage" id="lightbox-stage"></div>
		<p class="lightbox__caption" id="lightbox-caption"></p>
	</div>

	<!-- TESTIMONIALS -->
	<section class="section section--testimonials">
		<div class="section__head">
			<span class="eyebrow eyebrow--plain">Testimonials</span>
			<h2 class="section__title">Founders who <span class="hero__gradient">kept coming back.</span></h2>
		</div>
		<div class="tm-grid">
			{testimonials.map((t) => (
				<figure class="tm">
					<svg class="tm__mark" viewBox="0 0 32 24" aria-hidden="true">
						<path d="M0 24V14C0 6.3 4.9 1 12 0v5c-3.7 1-6 3.7-6 7h6v12H0Zm20 0V14c0-7.7 4.9-13 12-14v5c-3.7 1-6 3.7-6 7h6v12H20Z" fill="currentColor"/>
					</svg>
					<blockquote class="tm__quote">"{t.quote}"</blockquote>
					<figcaption class="tm__foot">
						<span class="tm__avatar" style={`background: ${t.accent}`}>{t.initials}</span>
						<span class="tm__id">
							<span class="tm__name">{t.name}</span>
							<span class="tm__role">{t.role} · {t.company}</span>
						</span>
					</figcaption>
				</figure>
			))}
		</div>
	</section>

	<!-- CTA STRIP -->
	<div class="cta-strip">
		<div class="cta-strip__inner">
			<div class="cta-strip__copy">
				<h2 class="cta-strip__title">Ready to put your brand <span class="hero__gradient">into orbit?</span></h2>
				<p class="cta-strip__sub">Most briefs get a response within one working day.</p>
			</div>
			<a href="/contact" class="btn btn--primary btn--lg">Book a free audit</a>
		</div>
	</div>

	<script is:inline>
		(function () {
			const tabs = document.querySelectorAll('.work-tab');
			const panels = document.querySelectorAll('.work-panel');
			tabs.forEach((tab) => {
				tab.addEventListener('click', () => {
					const target = tab.getAttribute('data-tab');
					tabs.forEach((t) => {
						const active = t === tab;
						t.classList.toggle('is-active', active);
						t.setAttribute('aria-selected', active ? 'true' : 'false');
					});
					panels.forEach((p) => {
						p.classList.toggle('is-active', p.getAttribute('data-panel') === target);
					});
					document.querySelectorAll('.work-card--video video').forEach((v) => { v.pause(); v.currentTime = 0; });
				});
			});

			const videoCards = document.querySelectorAll('.work-card--video');
			const attachVideoSrc = (card) => {
				const video = card.querySelector('video');
				if (!video || video.src) return;
				const src = video.getAttribute('data-src');
				if (src) { video.src = src; video.preload = 'metadata'; }
			};
			if ('IntersectionObserver' in window) {
				const io = new IntersectionObserver((entries) => {
					entries.forEach((entry) => { if (entry.isIntersecting) { attachVideoSrc(entry.target); io.unobserve(entry.target); } });
				}, { rootMargin: '200px' });
				videoCards.forEach((card) => io.observe(card));
			} else {
				videoCards.forEach(attachVideoSrc);
			}

			const isTouch = window.matchMedia('(hover: none)').matches;
			if (!isTouch) {
				videoCards.forEach((card) => {
					const video = card.querySelector('video');
					if (!video) return;
					card.addEventListener('mouseenter', () => { attachVideoSrc(card); video.play().catch(() => {}); });
					card.addEventListener('mouseleave', () => { video.pause(); if (video.currentTime) video.currentTime = 0; });
				});
			}

			const lightbox = document.getElementById('lightbox');
			const stage = document.getElementById('lightbox-stage');
			const caption = document.getElementById('lightbox-caption');
			const closeBtn = lightbox ? lightbox.querySelector('.lightbox__close') : null;

			function openLightbox(node, label) {
				if (!lightbox || !stage) return;
				stage.innerHTML = '';
				stage.appendChild(node);
				caption.textContent = label || '';
				lightbox.classList.add('is-open');
				lightbox.setAttribute('aria-hidden', 'false');
				document.body.style.overflow = 'hidden';
			}
			function closeLightbox() {
				if (!lightbox || !stage) return;
				const v = stage.querySelector('video');
				if (v) { v.pause(); v.src = ''; }
				stage.innerHTML = '';
				caption.textContent = '';
				lightbox.classList.remove('is-open');
				lightbox.setAttribute('aria-hidden', 'true');
				document.body.style.overflow = '';
			}

			document.querySelectorAll('.work-card--video').forEach((card) => {
				card.addEventListener('click', () => {
					const src = card.getAttribute('data-video-src');
					const label = card.getAttribute('data-video-label');
					const v = document.createElement('video');
					v.src = src; v.controls = true; v.autoplay = true; v.playsInline = true;
					openLightbox(v, label);
				});
			});
			document.querySelectorAll('.work-card--image').forEach((card) => {
				card.addEventListener('click', () => {
					const src = card.getAttribute('data-image-src');
					const label = card.getAttribute('data-image-label');
					const img = document.createElement('img');
					img.src = src; img.alt = label || '';
					openLightbox(img, label);
				});
			});

			if (closeBtn) closeBtn.addEventListener('click', closeLightbox);
			if (lightbox) lightbox.addEventListener('click', (e) => { if (e.target === lightbox) closeLightbox(); });
			document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && lightbox && lightbox.classList.contains('is-open')) closeLightbox(); });
		})();
	</script>
</Layout>
