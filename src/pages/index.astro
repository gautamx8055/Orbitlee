---
import StudioLayout from '../layouts/StudioLayout.astro';
import HeroCast from '../components/studio/HeroCast.astro';
import { featuredWork, servicePillars, clientNames, testimonials } from '../lib/content';

const marketing = servicePillars.filter((s) => s.lane === 'growth');
const technology = servicePillars.filter((s) => s.lane === 'build');

const reel = featuredWork.map((w) => ({
	...w,
	lane: w.img === '/1.jpg' ? 'build' : 'growth',
}));

const path = [
	{ t: 'Listen', d: 'You bring the messy brief. Ads, a site, an app, or all of it.' },
	{ t: 'Mix', d: 'We decide what to spend, what to build, and in what order.' },
	{ t: 'Ship', d: 'Creative and product leave the same week. No handoff graveyard.' },
	{ t: 'Tune', d: 'Monday numbers. Friday changes. We stay on it.' },
];

const faqs = [
	{ q: 'Is Orbitlee a tech agency or a marketing agency?', a: 'Both. We run digital marketing, performance ads and social, and we build websites and apps. One brief, one team.' },
	{ q: 'Can I hire only ads or only a website?', a: 'Yes. Hire performance marketing, social, web development or app work on its own, or keep them in one weekly sprint.' },
	{ q: 'How do we start?', a: 'Book a free 30-minute chat. Bring the ads account, the site, or the product idea. We will say what to spend, what to build, and what to leave alone.' },
];

const homeSchema = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'FAQPage',
			mainEntity: faqs.map((f) => ({
				'@type': 'Question',
				name: f.q,
				acceptedAnswer: { '@type': 'Answer', text: f.a },
			})),
		},
	],
};
---

<StudioLayout
	title="Tech & Marketing Agency | Ads + Software | Orbitlee"
	description="Orbitlee is a tech and marketing agency. We run performance ads and social, and we ship websites and apps. One team. Free 30-minute chat."
	keywords="tech and marketing agency, performance marketing agency, web development agency, app development, Orbitlee"
>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(homeSchema)} />
	</Fragment>
	<section class="billboard">
		<div class="billboard__main">
			<p class="billboard__live"><span></span> Live mix · ads + product</p>
			<div class="billboard__words" aria-hidden="true">
				<span class="word word--m">MARKETING</span>
				<span class="word word--x">×</span>
				<span class="word word--t">SOFTWARE</span>
			</div>
			<div class="billboard__copy">
				<h1 class="billboard__title">A tech and marketing agency that runs the ads and writes the software.</h1>
				<p class="billboard__lead">Hi, we’re Orbitlee. Campaigns that get clicks, and the site or app those clicks deserve. One brief. One week. One team.</p>
				<div class="hero__actions">
					<a href="/work/" class="btn btn--solid">See the mix</a>
					<a href="/contact/" class="btn btn--ghost">Start a project</a>
				</div>
			</div>
		</div>
		<HeroCast />
		<p class="billboard__scroll" aria-hidden="true">Scroll</p>
	</section>

	<div class="band-wrap" aria-hidden="true">
		<div class="band">
			<span>Meta ads</span><span>Instagram</span><span>Web apps</span><span>Landing pages</span><span>Performance</span><span>iOS &amp; Android</span><span>Creative</span><span>APIs</span><span>Social</span><span>Dashboards</span>
			<span>Meta ads</span><span>Instagram</span><span>Web apps</span><span>Landing pages</span><span>Performance</span><span>iOS &amp; Android</span><span>Creative</span><span>APIs</span><span>Social</span><span>Dashboards</span>
		</div>
	</div>

	<div data-mix-root data-mix-active="all">
		<div class="container">
			<div class="mixer" role="tablist" aria-label="Show marketing, technology, or both">
				<button type="button" class="mixer__btn is-on" data-mix="all" role="tab" aria-selected="true">The mix</button>
				<button type="button" class="mixer__btn mixer__btn--m" data-mix="growth" role="tab" aria-selected="false">Ads &amp; social</button>
				<button type="button" class="mixer__btn mixer__btn--t" data-mix="build" role="tab" aria-selected="false">Sites &amp; apps</button>
			</div>
		</div>

		<section class="reel-wrap">
			<div class="reel">
				{reel.map((w, i) => (
					<a class="reel__card mix" data-lane={w.lane} href="/work/">
						<img src={w.img} alt={`${w.client}: ${w.tag} by Orbitlee`} loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} width="640" height="800" />
						<span>
							<small>{w.lane === 'growth' ? 'Marketing' : 'Technology'}</small>
							<strong>{w.client}</strong>
							<em>{w.tag}</em>
						</span>
					</a>
				))}
			</div>
		</section>

		<section class="section">
			<div class="container">
				<p class="kicker">What you can hire</p>
				<h2 class="h2">Flip between <em>ads</em> and <em class="h2__t">product</em>. Or keep both.</h2>
				<div class="mix-board">
					{marketing.map((s) => (
						<a class="mix-row mix mix--m" data-lane="growth" href={s.href}>
							<b>Mkt</b>
							<span>
								<strong>{s.title}</strong>
								{s.blurb}
							</span>
						</a>
					))}
					{technology.map((s) => (
						<a class="mix-row mix mix--t" data-lane="build" href={s.href}>
							<b>Tec</b>
							<span>
								<strong>{s.title}</strong>
								{s.blurb}
							</span>
						</a>
					))}
				</div>
			</div>
		</section>
	</div>

	<ul class="stats container" aria-label="Agency results">
		<li><strong>9+</strong><span>Brands</span></li>
		<li><strong>2.7×</strong><span>ROAS</span></li>
		<li><strong>$100K+</strong><span>Media</span></li>
		<li><strong>99%</strong><span>Stay</span></li>
	</ul>

	<div class="mark" role="region" aria-label="Clients">
		<div class="mark__track">
			{clientNames.map((name) => (
				<span class="mark__item">{name}</span>
			))}
			{clientNames.map((name) => (
				<span class="mark__item mark__item--loop" aria-hidden="true">{name}</span>
			))}
		</div>
	</div>

	<section class="section section--center">
		<div class="container">
			<p class="kicker">How a week feels</p>
			<h2 class="h2">Four moves. Zero extra <em>noise</em>.</h2>
			<div class="path">
				{path.map((p) => (
					<article class="path__step">
						<h3>{p.t}</h3>
						<p>{p.d}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<p class="kicker">Testimonials</p>
			<h2 class="h2">They stayed. Here’s <em>why</em>.</h2>
			<div class="quotes">
				{testimonials.map((t) => (
					<figure class="quote">
						<blockquote>{t.quote}</blockquote>
						<figcaption>
							<strong>{t.person}</strong>
							<small>{t.brand}</small>
						</figcaption>
					</figure>
				))}
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container faq">
			<p class="kicker">FAQ</p>
			<h2 class="h2">Quick answers about the <em>mix</em>.</h2>
			{faqs.map((f) => (
				<details>
					<summary>{f.q}</summary>
					<p class="faq__a">{f.a}</p>
				</details>
			))}
		</div>
	</section>

	<section class="cta-block">
		<div>
			<p class="kicker">Free 30 minutes</p>
			<h2>Bring the ads account or the repo.</h2>
			<p>We’ll tell you what to spend, what to build, and what to leave alone.</p>
		</div>
		<a href="/contact/" class="btn btn--solid">Let’s mix it</a>
	</section>
</StudioLayout>
