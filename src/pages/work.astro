---
import StudioLayout from '../layouts/StudioLayout.astro';
import { clientNames } from '../lib/content';

const siteUrl = "https://www.orbitlee.com";

const clientWork = {
	videos: [
		{ src: "/ADVC UGC 1.mp4", label: "ADVC - AI UGC Spot 1", category: "AI UGC", client: "ADVC" },
		{ src: "/ADVC UGC 2.mp4", label: "ADVC - AI UGC Spot 2", category: "AI UGC", client: "ADVC" },
		{ src: "/Horizon RE NEW SAMPLE.mp4", label: "Horizon Real Estate", category: "Commercial", client: "Horizon RE" },
		{ src: "/Gaurya Farms Ghee reel .mp4", label: "Gaurya Farms Ghee", category: "Product Reel", client: "Gaurya Farms" },
		{ src: "/Green Exlir Lip Balm UGC.mp4", label: "Green Elixir Lip Balm", category: "UGC", client: "Green Elixir" },
		{ src: "/BA .mp4", label: "BA Campaign", category: "Commercial", client: "BA" },
	],
	branding: [
		{ src: "/AURIX-SM-BANNER.jpg", label: "Aurix - Social Banner", category: "Branding", client: "Aurix" },
		{ src: "/Post 1.png", label: "Social Creative 01", category: "Social", client: "" },
		{ src: "/Post 2.png", label: "Social Creative 02", category: "Social", client: "" },
		{ src: "/Post 3.png", label: "Social Creative 03", category: "Social", client: "" },
		{ src: "/Post 4.png", label: "Social Creative 04", category: "Social", client: "" },
		{ src: "/Post-5.png", label: "Social Creative 05", category: "Social", client: "" },
	],
	ads: [
		{ src: "/Ads-try-1-F.jpg", label: "Ad Creative - Concept 1", category: "Paid Ads", client: "" },
		{ src: "/Ads-try-2-F.jpg", label: "Ad Creative - Concept 2", category: "Paid Ads", client: "" },
		{ src: "/Ads-try-3&4.jpg", label: "Ad Creative - Concepts 3 & 4", category: "Paid Ads", client: "" },
	],
	design: [
		{ src: "/1.jpg", label: "Design Portfolio 01", category: "Design", client: "" },
		{ src: "/2.jpg", label: "Design Portfolio 02", category: "Design", client: "" },
		{ src: "/3.jpg", label: "Design Portfolio 03", category: "Design", client: "" },
		{ src: "/4.jpg", label: "Design Portfolio 04", category: "Design", client: "" },
		{ src: "/5.jpg", label: "Design Portfolio 05", category: "Design", client: "" },
		{ src: "/6.jpg", label: "Design Portfolio 06", category: "Design", client: "" },
		{ src: "/7.jpg", label: "Design Portfolio 07", category: "Design", client: "" },
		{ src: "/8.jpg", label: "Design Portfolio 08", category: "Design", client: "" },
		{ src: "/9.jpg", label: "Design Portfolio 09", category: "Design", client: "" },
		{ src: "/10.jpg", label: "Design Portfolio 10", category: "Design", client: "" },
		{ src: "/11.jpg", label: "Design Portfolio 11", category: "Design", client: "" },
	],
};

const totalCount = clientWork.videos.length + clientWork.branding.length + clientWork.ads.length + clientWork.design.length;
const featuredClients = clientNames;

const workStats = [
	{ num: `${clientWork.videos.length}`, label: "Ad films & UGC" },
	{ num: `${clientWork.branding.length}`, label: "Branding & social" },
	{ num: `${clientWork.ads.length + clientWork.design.length}`, label: "Design & ad creative" },
	{ num: `${featuredClients.length}+`, label: "Featured clients" },
];

const pageSchema = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "CollectionPage",
			"@id": `${siteUrl}/work/#collection`,
			name: "Orbitlee Client Work & Portfolio",
			description: "Full portfolio of client work by Orbitlee - AI UGC, ad films, brand identity, social creative and design.",
			url: `${siteUrl}/work/`,
			isPartOf: { "@id": `${siteUrl}/#website` },
			about: { "@id": `${siteUrl}/#organization` },
		},
		{
			"@type": "BreadcrumbList",
			itemListElement: [
				{ "@type": "ListItem", position: 1, name: "Home", item: siteUrl },
				{ "@type": "ListItem", position: 2, name: "Work", item: `${siteUrl}/work/` },
			],
		},
		{
			"@type": "ItemList",
			name: "Orbitlee Portfolio",
			description: "Selected client work from Orbitlee across video, branding, advertising and design.",
			numberOfItems: totalCount,
			itemListElement: [
				...clientWork.videos.map((v, i) => ({
					"@type": "ListItem",
					position: i + 1,
					item: {
						"@type": "VideoObject",
						name: v.label,
						description: `${v.category} content produced by Orbitlee for ${v.client}.`,
						contentUrl: `${siteUrl}${v.src}`,
						thumbnailUrl: `${siteUrl}/Orbitlee-logo-transparent.png`,
						uploadDate: "2024-06-01",
						publisher: { "@id": `${siteUrl}/#organization` },
					},
				})),
				...[...clientWork.branding, ...clientWork.ads, ...clientWork.design].map((img, i) => ({
					"@type": "ListItem",
					position: clientWork.videos.length + i + 1,
					item: {
						"@type": "ImageObject",
						name: img.label,
						description: `${img.category} work by Orbitlee${img.client ? ` for ${img.client}` : ''}.`,
						contentUrl: `${siteUrl}${img.src}`,
						creator: { "@id": `${siteUrl}/#organization` },
					},
				})),
			],
		},
	],
};
---

<StudioLayout
	title="Marketing & Product Work | Portfolio | Orbitlee"
	description="Orbitlee work: ads, UGC films, social, brand and product design. Proof from a tech and marketing agency. See the mix."
	keywords="Orbitlee portfolio, marketing campaign work, ad films, social creative, product design"
>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
	</Fragment>

	<section class="pg container">
		<p class="crumb"><a href="/">Home</a> <span>/</span> Work</p>
		<p class="eyebrow"><span class="eyebrow__dot"></span> Selected work</p>
		<h1>Marketing and product work. Campaigns. Apps. <em>Proof</em>.</h1>
		<p class="lead">Ads, films, social, and the sites those campaigns land on.</p>
		<div class="pg__actions">
			<a href="#gallery" class="btn btn--solid">See the work</a>
			<a href="/contact/" class="btn btn--ghost">Start a project</a>
		</div>
	</section>

	<ul class="stats container" aria-label="Portfolio stats">
		{workStats.map((s) => (
			<li>
				<strong>{s.num}</strong>
				<span>{s.label}</span>
			</li>
		))}
	</ul>

	<section id="gallery" class="section">
		<div class="container">
			<p class="kicker">Client work</p>
			<h2 class="h2">Browse by type.</h2>

			<div class="work-tabs" role="tablist" aria-label="Portfolio categories">
				<button class="work-tab is-active" role="tab" aria-selected="true" data-tab="videos">
					Ad Films & UGC
					<span class="work-tab__count">{clientWork.videos.length}</span>
				</button>
				<button class="work-tab" role="tab" aria-selected="false" data-tab="branding">
					Branding & Social
					<span class="work-tab__count">{clientWork.branding.length}</span>
				</button>
				<button class="work-tab" role="tab" aria-selected="false" data-tab="ads">
					Ad Creatives
					<span class="work-tab__count">{clientWork.ads.length}</span>
				</button>
				<button class="work-tab" role="tab" aria-selected="false" data-tab="design">
					Design
					<span class="work-tab__count">{clientWork.design.length}</span>
				</button>
			</div>

			<div class="work-panel is-active" data-panel="videos" role="tabpanel">
				<div class="work-grid work-grid--videos">
					{clientWork.videos.map((v) => (
						<button class="work-card work-card--video" data-video-src={v.src} data-video-label={v.label} aria-label={`Play ${v.label}`}>
							<video class="work-card__media" data-src={v.src} muted loop playsinline preload="metadata"></video>
							<span class="work-card__play" aria-hidden="true">
								<svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
							</span>
							<span class="work-card__foot">
								<span class="work-card__cat">{v.category}</span>
								<span class="work-card__label">{v.label}</span>
								{v.client && <span class="work-card__client">{v.client}</span>}
							</span>
						</button>
					))}
				</div>
			</div>

			<div class="work-panel" data-panel="branding" role="tabpanel">
				<div class="work-grid work-grid--images">
					{clientWork.branding.map((img) => (
						<button class="work-card work-card--image" data-image-src={img.src} data-image-label={img.label} aria-label={`View ${img.label}`}>
							<img class="work-card__media" src={img.src} alt={img.label} loading="lazy" />
							<span class="work-card__foot">
								<span class="work-card__cat">{img.category}</span>
								<span class="work-card__label">{img.label}</span>
								{img.client && <span class="work-card__client">{img.client}</span>}
							</span>
						</button>
					))}
				</div>
			</div>

			<div class="work-panel" data-panel="ads" role="tabpanel">
				<div class="work-grid work-grid--images work-grid--ads">
					{clientWork.ads.map((img) => (
						<button class="work-card work-card--image" data-image-src={img.src} data-image-label={img.label} aria-label={`View ${img.label}`}>
							<img class="work-card__media work-card__media--wide" src={img.src} alt={img.label} loading="lazy" />
							<span class="work-card__foot">
								<span class="work-card__cat">{img.category}</span>
								<span class="work-card__label">{img.label}</span>
							</span>
						</button>
					))}
				</div>
			</div>

			<div class="work-panel" data-panel="design" role="tabpanel">
				<div class="work-grid work-grid--images work-grid--design">
					{clientWork.design.map((img) => (
						<button class="work-card work-card--image" data-image-src={img.src} data-image-label={img.label} aria-label={`View ${img.label}`}>
							<img class="work-card__media" src={img.src} alt={img.label} loading="lazy" />
							<span class="work-card__foot">
								<span class="work-card__cat">{img.category}</span>
								<span class="work-card__label">{img.label}</span>
							</span>
						</button>
					))}
				</div>
			</div>
		</div>
	</section>

	<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-hidden="true" aria-label="Media viewer">
		<button class="lightbox__close" type="button" aria-label="Close viewer">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
				<path d="M6 6l12 12M18 6L6 18"/>
			</svg>
		</button>
		<div class="lightbox__stage" id="lightbox-stage"></div>
		<p class="lightbox__caption" id="lightbox-caption"></p>
	</div>

	<section class="section" style="padding-top: 0;">
		<div class="container">
			<p class="kicker">Featured clients</p>
			<h2 class="h2">Brands we’ve worked with.</h2>
			<div class="client-strip">
				{featuredClients.map((c) => (
					<span class="client-chip">{c}</span>
				))}
			</div>
		</div>
	</section>

	<section class="cta-block">
		<div>
			<h2>Like what you see?</h2>
			<p>Free 30 minutes. We’ll keep it practical.</p>
		</div>
		<a href="/contact/" class="btn btn--solid">Book a free audit</a>
	</section>

	<script is:inline>
		(function () {
			const tabs = document.querySelectorAll('.work-tab');
			const panels = document.querySelectorAll('.work-panel');
			tabs.forEach((tab) => {
				tab.addEventListener('click', () => {
					const target = tab.getAttribute('data-tab');
					tabs.forEach((t) => {
						const active = t === tab;
						t.classList.toggle('is-active', active);
						t.setAttribute('aria-selected', active ? 'true' : 'false');
					});
					panels.forEach((p) => {
						p.classList.toggle('is-active', p.getAttribute('data-panel') === target);
					});
					document.querySelectorAll('.work-card--video video').forEach((v) => { v.pause(); v.currentTime = 0; });
				});
			});

			const videoCards = document.querySelectorAll('.work-card--video');
			const attachVideoSrc = (card) => {
				const video = card.querySelector('video');
				if (!video || video.src) return;
				const src = video.getAttribute('data-src');
				if (!src) return;
				video.src = src + '#t=0.1';
				video.preload = 'metadata';
				video.addEventListener('loadedmetadata', function () {
					try { video.currentTime = 0.1; } catch (_) {}
				}, { once: true });
			};
			if ('IntersectionObserver' in window) {
				const io = new IntersectionObserver((entries) => {
					entries.forEach((e) => { if (e.isIntersecting) { attachVideoSrc(e.target); io.unobserve(e.target); } });
				}, { rootMargin: '200px' });
				videoCards.forEach((c) => io.observe(c));
			} else {
				videoCards.forEach(attachVideoSrc);
			}

			const isTouch = window.matchMedia('(hover: none)').matches;
			if (!isTouch) {
				videoCards.forEach((card) => {
					const video = card.querySelector('video');
					if (!video) return;
					card.addEventListener('mouseenter', () => { attachVideoSrc(card); video.play().catch(() => {}); });
					card.addEventListener('mouseleave', () => { video.pause(); if (video.currentTime) video.currentTime = 0; });
				});
			}

			const lightbox = document.getElementById('lightbox');
			const stage = document.getElementById('lightbox-stage');
			const caption = document.getElementById('lightbox-caption');
			const closeBtn = lightbox ? lightbox.querySelector('.lightbox__close') : null;

			function openLightbox(node, label) {
				if (!lightbox || !stage) return;
				stage.innerHTML = '';
				stage.appendChild(node);
				caption.textContent = label || '';
				lightbox.classList.add('is-open');
				lightbox.setAttribute('aria-hidden', 'false');
				document.body.style.overflow = 'hidden';
			}
			function closeLightbox() {
				if (!lightbox || !stage) return;
				const v = stage.querySelector('video');
				if (v) { v.pause(); v.src = ''; }
				stage.innerHTML = '';
				caption.textContent = '';
				lightbox.classList.remove('is-open');
				lightbox.setAttribute('aria-hidden', 'true');
				document.body.style.overflow = '';
			}

			document.querySelectorAll('.work-card--video').forEach((card) => {
				card.addEventListener('click', () => {
					const src = card.getAttribute('data-video-src');
					const label = card.getAttribute('data-video-label');
					const v = document.createElement('video');
					v.src = src; v.controls = true; v.autoplay = true; v.playsInline = true;
					openLightbox(v, label);
				});
			});
			document.querySelectorAll('.work-card--image').forEach((card) => {
				card.addEventListener('click', () => {
					const src = card.getAttribute('data-image-src');
					const label = card.getAttribute('data-image-label');
					const img = document.createElement('img');
					img.src = src; img.alt = label || '';
					openLightbox(img, label);
				});
			});

			if (closeBtn) closeBtn.addEventListener('click', closeLightbox);
			if (lightbox) lightbox.addEventListener('click', (e) => { if (e.target === lightbox) closeLightbox(); });
			document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && lightbox && lightbox.classList.contains('is-open')) closeLightbox(); });
		})();
	</script>
</StudioLayout>
