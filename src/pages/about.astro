---
import Layout from '../layouts/Layout.astro';

const differentiators = [
	{
		title: "One team, not five vendors",
		body: "Stop stitching an agency, a dev shop and a media consultant together. Everything ships from the same weekly sprint.",
	},
	{
		title: "AI-native production",
		body: "AI UGC, generative creative and automated post-production — 10× the ad variants, without 10× the cost.",
	},
	{
		title: "Speed to launch",
		body: "Brand new to live site, campaign or product in weeks, not quarters. Momentum is a growth channel.",
	},
	{
		title: "In-house dev + marketing",
		body: "Landing pages ship the same day a campaign does. Site and ad account share a nervous system.",
	},
];

const stats = [
	{ num: "25+", label: "Projects delivered" },
	{ num: "$100K+", label: "Ad spend managed" },
	{ num: "8", label: "Brands scaled" },
	{ num: "5★", label: "Avg. client rating" },
];
---

<Layout
	title="About Orbitlee — Creative & Marketing Agency"
	description="We're Orbitlee — a creative and marketing agency built to move fast and ship everything from one brief. Strategy, design, marketing and technology under one roof."
>
	<!-- PAGE HERO -->
	<section class="page-hero">
		<div class="page-hero__eyebrow">
			<span class="eyebrow eyebrow--plain">About</span>
		</div>
		<h1 class="page-hero__title">We circle <span class="hero__gradient">until it opens.</span></h1>
		<p class="page-hero__sub">
			One brief. One team. One weekly sprint. No handoffs, no silos, no excuses.
		</p>
	</section>

	<!-- STORY -->
	<section class="about">
		<div class="about__copy">
			<span class="eyebrow eyebrow--plain">Our story</span>
			<h2 class="section__title section__title--left">Built for the <span class="hero__gradient">speed of now.</span></h2>
			<p class="about__lead">
				Most agencies work in silos — a strategy deck here, a design file there, an ad account somewhere else. Nothing compounds.
			</p>
			<p class="about__lead">
				Orbitlee was built differently. We work as one team on one brief, in one weekly cadence. Branding, performance marketing, web development and creative production move together — because they have to.
			</p>
			<p class="about__lead">
				Founded by Sachin Verma with a single belief: that the best brands don't wait for a committee to approve the next step. They orbit, they test, they ship.
			</p>
			<ul class="about__points">
				<li><span class="about__check">✓</span> Senior team on every engagement</li>
				<li><span class="about__check">✓</span> Weekly sprints with transparent progress</li>
				<li><span class="about__check">✓</span> Measured on outcomes, not deliverables</li>
			</ul>
		</div>
		<div class="about__logo">
			<img src="/Orbitlee-logo-transparent.png" alt="" width="320" height="93" loading="lazy" decoding="async" />
		</div>
	</section>

	<!-- STATS -->
	<section class="trust" style="margin-top: 0; padding-top: 0;">
		<ul class="stats">
			{stats.map((s) => (
				<li class="stat">
					<span class="stat__num">{s.num}</span>
					<span class="stat__label">{s.label}</span>
				</li>
			))}
		</ul>
	</section>

	<!-- WHY US -->
	<section class="section">
		<div class="section__head">
			<span class="eyebrow eyebrow--plain">Why Orbitlee</span>
			<h2 class="section__title">Full-service, <span class="hero__gradient">actually delivered.</span></h2>
		</div>
		<div class="why-grid">
			{differentiators.map((d, i) => (
				<article class="why-card">
					<span class="why-card__num">0{i + 1}</span>
					<h3 class="why-card__title">{d.title}</h3>
					<p class="why-card__body">{d.body}</p>
				</article>
			))}
		</div>
	</section>

	<!-- PROCESS -->
	<section class="section">
		<div class="section__head">
			<span class="eyebrow eyebrow--plain">Process</span>
			<h2 class="section__title">A process built to <span class="hero__gradient">compound.</span></h2>
		</div>
		<ol class="steps">
			<li class="step">
				<div class="step__marker">
					<span class="step__num">01</span>
					<div class="step__icon">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
							<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
						</svg>
					</div>
				</div>
				<h3>Audit</h3>
				<p>A hard look at brand, funnel and product. Where you're leaking growth and the biggest wins hide.</p>
			</li>
			<li class="step">
				<div class="step__marker">
					<span class="step__num">02</span>
					<div class="step__icon">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
							<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.5" fill="currentColor"/>
						</svg>
					</div>
				</div>
				<h3>Strategy</h3>
				<p>A crisp, prioritised roadmap tied to business outcomes, not a 60-slide deck no one opens twice.</p>
			</li>
			<li class="step">
				<div class="step__marker">
					<span class="step__num">03</span>
					<div class="step__icon">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
							<path d="M4 20h16"/><path d="M6 16 15.5 6.5a2.121 2.121 0 0 1 3 3L9 19l-5 1 1-5Z"/>
						</svg>
					</div>
				</div>
				<h3>Design / Build</h3>
				<p>Identity, product, site, campaign creative — shipped as one system in weekly review cycles.</p>
			</li>
			<li class="step">
				<div class="step__marker">
					<span class="step__num">04</span>
					<div class="step__icon">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
							<path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09Z"/>
							<path d="M12 15 9 12a11 11 0 0 1 7-8 11 11 0 0 1 4 4 11 11 0 0 1-8 7Z"/>
							<path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/>
						</svg>
					</div>
				</div>
				<h3>Launch</h3>
				<p>Go-live with real testing, analytics and ads. No soft launches that quietly die.</p>
			</li>
			<li class="step">
				<div class="step__marker">
					<span class="step__num">05</span>
					<div class="step__icon">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
							<path d="M3 17 9 11l4 4 8-8"/><path d="M14 7h7v7"/>
						</svg>
					</div>
				</div>
				<h3>Scale</h3>
				<p>Measure, iterate, compound. The loop that turns launch energy into a permanent orbit.</p>
			</li>
		</ol>
	</section>

	<!-- CTA -->
	<div class="cta-strip">
		<div class="cta-strip__inner">
			<div class="cta-strip__copy">
				<h2 class="cta-strip__title">Ready to <span class="hero__gradient">orbit together?</span></h2>
				<p class="cta-strip__sub">Free 30-minute audit. No slide deck. Actionable next steps.</p>
			</div>
			<a href="/contact" class="btn btn--primary btn--lg">Book a free audit</a>
		</div>
	</div>
</Layout>
