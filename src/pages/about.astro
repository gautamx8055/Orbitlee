---
import StudioLayout from '../layouts/StudioLayout.astro';

const siteUrl = 'https://www.orbitlee.com';
const aboutSchema = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'AboutPage',
			url: `${siteUrl}/about/`,
			name: 'About Orbitlee',
			about: { '@id': `${siteUrl}/#organization` },
		},
		{
			'@type': 'BreadcrumbList',
			itemListElement: [
				{ '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
				{ '@type': 'ListItem', position: 2, name: 'About', item: `${siteUrl}/about/` },
			],
		},
		{
			'@type': 'Person',
			'@id': `${siteUrl}/#founder`,
			name: 'Sachin Verma',
			jobTitle: 'Founder',
			worksFor: { '@id': `${siteUrl}/#organization` },
		},
	],
};

const why = [
	{ t: 'One team', d: 'Ads, social, web and apps in the same week. No vendor ping-pong.' },
	{ t: 'Honest numbers', d: 'We report Mondays. We change Fridays. Outcomes over slide decks.' },
	{ t: 'Build + grow', d: 'The page goes live when the ads do. Same calendar, same people.' },
];
---

<StudioLayout
	title="About Orbitlee | Tech & Marketing Agency"
	description="Orbitlee is Sachin Verma’s tech and marketing agency. Ads, social, websites and apps from one crew. We Circle, You Grow."
	keywords="about Orbitlee, Sachin Verma, tech and marketing agency, ads and software"
>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(aboutSchema)} />
	</Fragment>

	<section class="pg container">
		<p class="crumb"><a href="/">Home</a> <span>/</span> About</p>
		<p class="eyebrow"><span class="eyebrow__dot"></span> Tech &amp; marketing agency</p>
		<h1>A tech and marketing crew. Two crafts. One <em>team</em>.</h1>
		<p class="lead">Sachin Verma built Orbitlee so brands stop bouncing between a media shop and a software shop.</p>
	</section>

	<section class="section" style="padding-top: 0;">
		<div class="container split">
			<div>
				<p>Sachin Verma started Orbitlee so you don’t have to hire a media buyer and a software shop and hope they talk.</p>
				<p>We manage ads, social, websites and apps as one team. Mondays for numbers. Fridays for changes.</p>
			</div>
			<div>
				<img src="/Orbitlee-logo-transparent.png" alt="Orbitlee tech and marketing agency logo" class="about-logo" width="420" height="122" />
				<img src="/9.jpg" alt="Windsouls Goa brochure work by Orbitlee" loading="lazy" />
			</div>
		</div>
	</section>

	<ul class="stats container">
		<li><strong>9+</strong><span>Brands scaled</span></li>
		<li><strong>2.7×</strong><span>Avg. ROAS</span></li>
		<li><strong>−42%</strong><span>CPL reduction</span></li>
		<li><strong>99%</strong><span>Retention</span></li>
	</ul>

	<section class="section">
		<div class="container">
			<p class="kicker">Why us</p>
			<h2 class="h2">Simple, on <em>purpose</em>.</h2>
			<div class="offer" style="grid-template-columns: 1fr 1fr; margin-top: 32px;">
				{why.map((w) => (
					<article>
						<h3>{w.t}</h3>
						<p>{w.d}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="cta-block">
		<div>
			<h2>Want to say hi?</h2>
			<p>Free 30 minutes. No slide deck.</p>
		</div>
		<a href="/contact/" class="btn btn--solid">Book a free audit</a>
	</section>
</StudioLayout>
