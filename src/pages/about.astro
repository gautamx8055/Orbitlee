---
import StudioLayout from '../layouts/StudioLayout.astro';

const siteUrl = 'https://www.orbitlee.com';
const aboutSchema = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'AboutPage',
			url: `${siteUrl}/about/`,
			name: 'About Orbitlee',
			about: { '@id': `${siteUrl}/#organization` },
		},
		{
			'@type': 'Person',
			'@id': `${siteUrl}/#founder`,
			name: 'Sachin Verma',
			jobTitle: 'Founder & Creative Head',
			worksFor: { '@id': `${siteUrl}/#organization` },
		},
	],
};

const why = [
	{ t: 'One team, not five vendors', d: 'Brand, ads, UGC and product share a weekly sprint. Nothing dies in a handoff.' },
	{ t: 'AI-native production', d: 'AI UGC and generative creative — more ad variants without 10× the shoot cost.' },
	{ t: 'Speed to launch', d: 'Site, campaign or identity in weeks. Momentum is a channel.' },
	{ t: 'Dev + media aligned', d: 'Landing pages ship the same day a campaign does.' },
];
---

<StudioLayout
	title="About Orbitlee — Creative & Marketing Studio | Sachin Verma"
	description="Orbitlee is a Delhi creative studio founded by Sachin Verma. One team, one brief, one weekly sprint for brand, ads, UGC and product."
>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(aboutSchema)} />
	</Fragment>

	<section class="pg container">
		<p class="crumb"><a href="/">Home</a> <span>/</span> Studio</p>
		<p class="eyebrow"><span class="eyebrow__dot"></span> About · Founded 2024</p>
		<h1>We circle until it <em>opens</em>.</h1>
		<p class="lead">Sachin Verma built Orbitlee for founders who are tired of a strategy deck, a design file and an ad account that never meet.</p>
	</section>

	<section class="section" style="padding-top: 0;">
		<div class="container split">
			<div>
				<p>Most agencies sell fragments. We work as one pod: branding, performance, web and production in the same cadence — because growth only compounds when those pieces share a nervous system.</p>
				<p>₹12Cr+ in media spend managed. 94% client retention. We report Mondays. We iterate Fridays. Measured on outcomes, not deliverable count.</p>
			</div>
			<div>
				<img src="/Orbitlee-logo-transparent.png" alt="Orbitlee — Strategy. Design. Grow." class="about-logo" width="420" height="122" />
				<img src="/9.jpg" alt="Windsouls Goa brochure work by Orbitlee" loading="lazy" />
			</div>
		</div>
	</section>

	<ul class="stats container">
		<li><strong>15+</strong><span>Brands scaled</span></li>
		<li><strong>3.8×</strong><span>Avg. ROAS</span></li>
		<li><strong>−42%</strong><span>CPL reduction</span></li>
		<li><strong>94%</strong><span>Retention</span></li>
	</ul>

	<section class="section">
		<div class="container">
			<p class="kicker">Why Orbitlee</p>
			<h2 class="h2">Full-service, actually delivered.</h2>
			<div class="offer" style="grid-template-columns: 1fr 1fr; margin-top: 32px;">
				{why.map((w) => (
					<article>
						<h3>{w.t}</h3>
						<p>{w.d}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="cta-block">
		<div>
			<h2>Ready to orbit together?</h2>
			<p>Free 30-minute audit. No slide deck.</p>
		</div>
		<a href="/contact" class="btn btn--solid">Book a free audit</a>
	</section>
</StudioLayout>
