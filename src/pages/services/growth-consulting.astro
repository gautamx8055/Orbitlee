---
import StudioLayout from '../../layouts/StudioLayout.astro';
import ServiceDepth from '../../components/studio/ServiceDepth.astro';
import OfferIcon from '../../components/studio/OfferIcon.astro';

const siteUrl = "https://www.orbitlee.com";
const pageSchema = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "Service",
			"@id": `${siteUrl}/services/growth-consulting/#service`,
			name: "Growth Consulting",
			serviceType: "Business Growth Consulting and Marketing Strategy",
			provider: { "@id": `${siteUrl}/#organization` },
			areaServed: { "@type": "Place", name: "Worldwide" },
			description: "Business growth audits, brand audits, marketing strategy, go-to-market planning and competitive analysis for brands ready to scale.",
			url: `${siteUrl}/services/growth-consulting/`,
		},
		{
			"@type": "BreadcrumbList",
			itemListElement: [
				{ "@type": "ListItem", position: 1, name: "Home", item: siteUrl },
				{ "@type": "ListItem", position: 2, name: "Services", item: `${siteUrl}/services/` },
				{ "@type": "ListItem", position: 3, name: "Growth Consulting", item: `${siteUrl}/services/growth-consulting/` },
			],
		},
		{
			"@type": "FAQPage",
			mainEntity: [
				{ "@type": "Question", name: "What does Orbitlee's growth consulting include?", acceptedAnswer: { "@type": "Answer", text: "Orbitlee's growth consulting includes business growth audits, brand audits, marketing strategy development, go-to-market planning, competitive analysis and 90-day growth roadmaps. Every engagement starts with a diagnostic before any recommendations." } },
				{ "@type": "Question", name: "Can Orbitlee execute on the strategy they recommend?", acceptedAnswer: { "@type": "Answer", text: "Yes - unlike standalone consultants, Orbitlee can take strategy all the way to execution. The same team that audits your brand can build the campaigns, the website and the creative - no re-briefing a new vendor." } },
			],
		},
	],
};

const offerings = [
	{ icon: 'audit', title: 'Growth audit', desc: 'Funnel, brand, channels. Where it leaks. What to fix first.' },
	{ icon: 'star', title: 'Brand audit', desc: 'How you show up vs who you compete with. Gaps, not fluff.' },
	{ icon: 'grid', title: 'Marketing strategy', desc: 'Channels, budget, cadence. Tied to a number, not a vibe.' },
	{ icon: 'rocket', title: 'Go-to-market', desc: 'New product or market. Sequence, mix, metrics.' },
	{ icon: 'users', title: 'Competitive look', desc: 'Who actually wins, and what’s still open.' },
	{ icon: 'trend', title: '90-day map', desc: 'Owners and next Monday. Not a shelf deck.' },
];

const approach = [
	{
		title: "Diagnostics before prescription",
		body: "We don't walk in with a predetermined answer. Every engagement starts with a structured audit before we recommend a single thing.",
	},
	{
		title: "Actionable, not academic",
		body: "Our deliverables are working documents your team can execute on Monday morning - not 60-slide decks designed to look impressive on a shelf.",
	},
	{
		title: "We can execute too",
		body: "Unlike standalone consultants, we can take the strategy all the way to implementation. Same team, same brief, no re-briefing a new vendor.",
	},
];

const week = [
	{ t: 'Audit', d: 'Funnel, brand, spend. Where it leaks.' },
	{ t: 'Rank', d: 'Highest-leverage fixes first. The rest waits.' },
	{ t: 'Map', d: 'A 90-day plan with owners, not a shelf deck.' },
	{ t: 'Do', d: 'Same team can run ads and build the site.' },
];
const fit = [
	{ t: 'You’re spending blind', d: 'Channels exist. No one ranked them.' },
	{ t: 'New market or product', d: 'You need a GTM, not a slogan.' },
	{ t: 'You want one team', d: 'Strategy that can also ship.' },
];
const weekly = [
	{ t: 'Findings', d: 'What we saw. What’s noise.' },
	{ t: 'Priorities', d: 'Three moves. Not thirty.' },
	{ t: 'Next Monday', d: 'Who does what when we leave the call.' },
];
---

<StudioLayout
	title="Growth Consulting | Audits & GTM | Orbitlee"
	description="Growth consulting from Orbitlee: a clear audit, then the same team can run the ads and build the site. Book a free chat."
	keywords="growth consulting, marketing audit, go to market strategy, brand audit, Orbitlee"
>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
	</Fragment>

	<section class="pg container">
		<p class="crumb"><a href="/services/">Services</a> <span>/</span> Growth Consulting</p>
		<p class="eyebrow"><span class="eyebrow__dot"></span> Audit · GTM · Roadmaps</p>
		<h1>Growth consulting: see what’s leaking. Then <em>fix</em> it.</h1>
		<p class="lead">A short audit before you spend. If you want, we do the work too.</p>
		<div class="pg__actions">
			<a href="/contact/" class="btn btn--solid">Book a growth audit</a>
			<a href="/services/" class="btn btn--ghost">All services</a>
		</div>
	</section>

	<section class="section" style="padding-top: 0;">
		<div class="container split">
			<img src="/9.jpg" alt="Strategy and print system work by Orbitlee" loading="lazy" width="800" height="600" />
			<div>
				<p class="kicker">Approach</p>
				<h2 class="h2">Consulting that actually ships.</h2>
				{approach.map((a) => (
					<p><strong style="color: var(--ink);">{a.title}.</strong> {a.body}</p>
				))}
			</div>
		</div>
	</section>

	<section class="section" style="padding-top: 0;">
		<div class="container">
			<p class="kicker">What’s included</p>
			<h2 class="h2">Roadmaps you can act on Monday.</h2>
			<div class="offer offer--book" style="margin-top: 28px;">
				{offerings.map((o) => (
					<article>
						<OfferIcon name={o.icon} />
						<h3>{o.title}</h3>
						<p>{o.desc}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<ServiceDepth week={week} fit={fit} weekly={weekly} lane="growth" />

	<section class="cta-block">
		<div>
			<h2>Not sure where the biggest wins are?</h2>
			<p>The audit alone is worth the conversation.</p>
		</div>
		<a href="/contact/" class="btn btn--solid">Book a growth audit</a>
	</section>
</StudioLayout>
