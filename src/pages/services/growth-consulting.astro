---
import Layout from '../../layouts/Layout.astro';

const offerings = [
	{
		icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>`,
		title: "Business Growth Audit",
		desc: "A deep diagnostic of your funnel, brand, channels and operations. We find where you're leaking growth and rank the highest-leverage fixes.",
	},
	{
		icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>`,
		title: "Brand Audit",
		desc: "An honest look at your brand's current perception, positioning gaps and how you stack up against competitors — with clear recommendations.",
	},
	{
		icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3h18v18H3zM3 9h18M9 21V9"/></svg>`,
		title: "Marketing Strategy",
		desc: "A channel-by-channel plan tied to your specific growth targets — budget allocation, content cadence, audience strategy and 90-day milestones.",
	},
	{
		icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09Z"/><path d="M12 15 9 12a11 11 0 0 1 7-8 11 11 0 0 1 4 4 11 11 0 0 1-8 7Z"/></svg>`,
		title: "Go-to-Market Strategy",
		desc: "Launching a product or entering a new market? We build the full GTM playbook — positioning, launch sequence, channel mix and metrics.",
	},
	{
		icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
		title: "Competitive Analysis",
		desc: "A structured look at who you're actually competing with, how they're winning and where the gaps in the market are sitting unclaimed.",
	},
	{
		icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17 9 11l4 4 8-8"/><path d="M14 7h7v7"/></svg>`,
		title: "Growth Roadmap",
		desc: "A prioritised 90-day action plan with clear owners, dependencies and expected outcomes — not a deck, a working document.",
	},
];

const approach = [
	{
		title: "Diagnostics before prescription",
		body: "We don't walk in with a predetermined answer. Every engagement starts with a structured audit before we recommend a single thing.",
	},
	{
		title: "Actionable, not academic",
		body: "Our deliverables are working documents your team can execute on Monday morning — not 60-slide decks designed to look impressive on a shelf.",
	},
	{
		title: "We can execute too",
		body: "Unlike standalone consultants, we can take the strategy all the way to implementation. Same team, same brief, no re-briefing a new vendor.",
	},
];
---

<Layout
	title="Growth Consulting — Orbitlee"
	description="Business growth audits, brand audits, marketing strategy, go-to-market planning and competitive analysis — sharp diagnostics and clear roadmaps that actually get executed."
>
	<!-- BREADCRUMB + HERO -->
	<section class="page-hero">
		<div class="breadcrumb">
			<a href="/services">Services</a>
			<span class="breadcrumb__sep">›</span>
			<span>Growth Consulting</span>
		</div>
		<div class="page-hero__eyebrow">
			<span class="eyebrow eyebrow--plain">Growth Consulting</span>
		</div>
		<h1 class="page-hero__title">Find the leaks, <span class="hero__gradient">map the wins.</span></h1>
		<p class="page-hero__sub">
			Sharp diagnostics and clear roadmaps before your next big investment. We tell you exactly where you're leaving growth on the table — then help you pick it up.
		</p>
		<div class="hero__actions" style="margin-top: 32px;">
			<a href="/contact" class="btn btn--primary btn--lg">Book a growth audit</a>
			<a href="/services" class="btn btn--ghost btn--lg">All services</a>
		</div>
	</section>

	<!-- WHAT'S INCLUDED -->
	<section class="section">
		<div class="section__head">
			<span class="eyebrow eyebrow--plain">What's included</span>
			<h2 class="section__title">Strategy that <span class="hero__gradient">gets executed.</span></h2>
			<p class="section__sub">We build roadmaps you can act on — not decks that gather dust.</p>
		</div>
		<div class="svc-detail-grid">
			{offerings.map((o) => (
				<article class="svc-item">
					<div class="svc-item__icon" set:html={o.icon}></div>
					<h3 class="svc-item__title">{o.title}</h3>
					<p class="svc-item__desc">{o.desc}</p>
				</article>
			))}
		</div>
	</section>

	<!-- OUR APPROACH -->
	<section class="section section--why">
		<div class="section__head">
			<span class="eyebrow eyebrow--plain">Our approach</span>
			<h2 class="section__title">Consulting that <span class="hero__gradient">actually ships.</span></h2>
		</div>
		<div class="why-grid">
			{approach.map((a, i) => (
				<article class="why-card">
					<span class="why-card__num">0{i + 1}</span>
					<h3 class="why-card__title">{a.title}</h3>
					<p class="why-card__body">{a.body}</p>
				</article>
			))}
		</div>
	</section>

	<!-- CTA -->
	<div class="cta-strip">
		<div class="cta-strip__inner">
			<div class="cta-strip__copy">
				<h2 class="cta-strip__title">Not sure where your <span class="hero__gradient">biggest wins are?</span></h2>
				<p class="cta-strip__sub">The audit alone is worth the conversation. Most clients act on it within a week.</p>
			</div>
			<a href="/contact" class="btn btn--primary btn--lg">Book a growth audit</a>
		</div>
	</div>
</Layout>
