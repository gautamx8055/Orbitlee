---
import StudioLayout from '../../layouts/StudioLayout.astro';

const siteUrl = "https://www.orbitlee.com";
const pageSchema = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "Service",
			"@id": `${siteUrl}/services/growth-consulting/#service`,
			name: "Growth Consulting",
			serviceType: "Business Growth Consulting and Marketing Strategy",
			provider: { "@id": `${siteUrl}/#organization` },
			areaServed: { "@type": "Place", name: "Worldwide" },
			description: "Business growth audits, brand audits, marketing strategy, go-to-market planning and competitive analysis for brands ready to scale.",
			url: `${siteUrl}/services/growth-consulting/`,
		},
		{
			"@type": "BreadcrumbList",
			itemListElement: [
				{ "@type": "ListItem", position: 1, name: "Home", item: siteUrl },
				{ "@type": "ListItem", position: 2, name: "Services", item: `${siteUrl}/services/` },
				{ "@type": "ListItem", position: 3, name: "Growth Consulting", item: `${siteUrl}/services/growth-consulting/` },
			],
		},
		{
			"@type": "FAQPage",
			mainEntity: [
				{ "@type": "Question", name: "What does Orbitlee's growth consulting include?", acceptedAnswer: { "@type": "Answer", text: "Orbitlee's growth consulting includes business growth audits, brand audits, marketing strategy development, go-to-market planning, competitive analysis and 90-day growth roadmaps. Every engagement starts with a diagnostic before any recommendations." } },
				{ "@type": "Question", name: "Can Orbitlee execute on the strategy they recommend?", acceptedAnswer: { "@type": "Answer", text: "Yes - unlike standalone consultants, Orbitlee can take strategy all the way to execution. The same team that audits your brand can build the campaigns, the website and the creative - no re-briefing a new vendor." } },
			],
		},
	],
};

const offerings = [
	{
		icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>`,
		title: "Business Growth Audit",
		desc: "A deep diagnostic of your funnel, brand, channels and operations. We find where you're leaking growth and rank the highest-leverage fixes.",
	},
	{
		icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>`,
		title: "Brand Audit",
		desc: "An honest look at your brand's current perception, positioning gaps and how you stack up against competitors - with clear recommendations.",
	},
	{
		icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3h18v18H3zM3 9h18M9 21V9"/></svg>`,
		title: "Marketing Strategy",
		desc: "A channel-by-channel plan tied to your specific growth targets - budget allocation, content cadence, audience strategy and 90-day milestones.",
	},
	{
		icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09Z"/><path d="M12 15 9 12a11 11 0 0 1 7-8 11 11 0 0 1 4 4 11 11 0 0 1-8 7Z"/></svg>`,
		title: "Go-to-Market Strategy",
		desc: "Launching a product or entering a new market? We build the full GTM playbook - positioning, launch sequence, channel mix and metrics.",
	},
	{
		icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
		title: "Competitive Analysis",
		desc: "A structured look at who you're actually competing with, how they're winning and where the gaps in the market are sitting unclaimed.",
	},
	{
		icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17 9 11l4 4 8-8"/><path d="M14 7h7v7"/></svg>`,
		title: "Growth Roadmap",
		desc: "A prioritised 90-day action plan with clear owners, dependencies and expected outcomes - not a deck, a working document.",
	},
];

const approach = [
	{
		title: "Diagnostics before prescription",
		body: "We don't walk in with a predetermined answer. Every engagement starts with a structured audit before we recommend a single thing.",
	},
	{
		title: "Actionable, not academic",
		body: "Our deliverables are working documents your team can execute on Monday morning - not 60-slide decks designed to look impressive on a shelf.",
	},
	{
		title: "We can execute too",
		body: "Unlike standalone consultants, we can take the strategy all the way to implementation. Same team, same brief, no re-briefing a new vendor.",
	},
];
---

<StudioLayout
	title="Growth Consulting | Audits & GTM | Orbitlee"
	description="Growth consulting from Orbitlee: a clear audit, then the same team can run the ads and build the site. Book a free chat."
	keywords="growth consulting, marketing audit, go to market strategy, brand audit, Orbitlee"
>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
	</Fragment>

	<section class="pg container">
		<p class="crumb"><a href="/services">Services</a> <span>/</span> Growth Consulting</p>
		<p class="eyebrow"><span class="eyebrow__dot"></span> Audit · GTM · Roadmaps</p>
		<h1>Growth consulting: see what’s leaking. Then <em>fix</em> it.</h1>
		<p class="lead">A short audit before you spend. If you want, we do the work too.</p>
		<div class="pg__actions">
			<a href="/contact" class="btn btn--solid">Book a growth audit</a>
			<a href="/services" class="btn btn--ghost">All services</a>
		</div>
	</section>

	<section class="section" style="padding-top: 0;">
		<div class="container split">
			<img src="/9.jpg" alt="Strategy and print system work by Orbitlee" loading="lazy" width="800" height="600" />
			<div>
				<p class="kicker">Approach</p>
				<h2 class="h2">Consulting that actually ships.</h2>
				{approach.map((a) => (
					<p><strong style="color: var(--ink);">{a.title}.</strong> {a.body}</p>
				))}
			</div>
		</div>
	</section>

	<section class="section" style="padding-top: 0;">
		<div class="container">
			<p class="kicker">What’s included</p>
			<h2 class="h2">Roadmaps you can act on Monday.</h2>
			<div class="offer" style="margin-top: 28px;">
				{offerings.map((o) => (
					<article>
						<h3>{o.title}</h3>
						<p>{o.desc}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="cta-block">
		<div>
			<h2>Not sure where the biggest wins are?</h2>
			<p>The audit alone is worth the conversation.</p>
		</div>
		<a href="/contact" class="btn btn--solid">Book a growth audit</a>
	</section>
</StudioLayout>
