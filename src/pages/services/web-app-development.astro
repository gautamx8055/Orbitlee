---
import StudioLayout from '../../layouts/StudioLayout.astro';

const siteUrl = "https://www.orbitlee.com";
const pageSchema = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "Service",
			"@id": `${siteUrl}/services/web-app-development/#service`,
			name: "Web & App Development",
			serviceType: "Website and Mobile App Development",
			provider: { "@id": `${siteUrl}/#organization` },
			areaServed: { "@type": "Country", name: "India" },
			description: "Website development, landing pages, mobile apps, SaaS platforms, UI/UX design and AI automation built for performance and scale.",
			url: `${siteUrl}/services/web-app-development/`,
			hasOfferCatalog: {
				"@type": "OfferCatalog",
				name: "Web & App Development Services",
				itemListElement: [
					{ "@type": "Offer", itemOffered: { "@type": "Service", name: "Website Development" } },
					{ "@type": "Offer", itemOffered: { "@type": "Service", name: "Landing Page Design & Development" } },
					{ "@type": "Offer", itemOffered: { "@type": "Service", name: "Mobile App Development (iOS & Android)" } },
					{ "@type": "Offer", itemOffered: { "@type": "Service", name: "SaaS Platform Development" } },
					{ "@type": "Offer", itemOffered: { "@type": "Service", name: "UI/UX Design" } },
					{ "@type": "Offer", itemOffered: { "@type": "Service", name: "AI Automation & Workflows" } },
				],
			},
		},
		{
			"@type": "BreadcrumbList",
			itemListElement: [
				{ "@type": "ListItem", position: 1, name: "Home", item: siteUrl },
				{ "@type": "ListItem", position: 2, name: "Services", item: `${siteUrl}/services/` },
				{ "@type": "ListItem", position: 3, name: "Web & App Development", item: `${siteUrl}/services/web-app-development/` },
			],
		},
		{
			"@type": "FAQPage",
			mainEntity: [
				{ "@type": "Question", name: "Does Orbitlee build websites and apps?", acceptedAnswer: { "@type": "Answer", text: "Yes - Orbitlee is a full-service web and app development agency. We build websites, landing pages, mobile apps (iOS & Android), SaaS platforms and AI-powered automation workflows, all optimised for performance and conversions." } },
				{ "@type": "Question", name: "How long does it take Orbitlee to build a website?", acceptedAnswer: { "@type": "Answer", text: "Most landing pages and simple websites ship in 1-2 weeks. More complex web applications or SaaS products take 4-12 weeks depending on scope. We work in weekly sprints so you see progress from week one." } },
			],
		},
	],
};

const offerings = [
	{
		icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>`,
		title: "Website Development",
		desc: "Fast, conversion-optimised websites built on modern stacks. Every site is performance-tuned, SEO-ready and designed to grow with you.",
	},
	{
		icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h16M4 4h16v12H4z"/><path d="M9 20v-4h6v4"/></svg>`,
		title: "Landing Pages",
		desc: "High-converting pages built to match your campaign traffic. Designed, built and live within the same week your ads launch.",
	},
	{
		icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2"/><path d="M12 18h.01"/></svg>`,
		title: "Mobile Apps",
		desc: "iOS and Android apps engineered for performance and built for scale - from MVP to full product launch with ongoing iteration.",
	},
	{
		icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>`,
		title: "UI/UX Design",
		desc: "Interfaces that feel intuitive from the first click. We research, prototype and test before a single line of code is written.",
	},
	{
		icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>`,
		title: "SaaS Platforms",
		desc: "Full-scale software products with auth, billing, dashboards and the infrastructure to handle real growth from day one.",
	},
	{
		icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z"/><path d="M12 6v6l4 2"/></svg>`,
		title: "AI Automation",
		desc: "Workflows, bots and pipelines that remove repetitive work - from lead qualification and customer support to reporting and ops.",
	},
];

const approach = [
	{
		title: "Ship fast, iterate faster",
		body: "We scope MVPs tight, get them live quickly and improve in weekly cycles. Speed to market is a competitive moat.",
	},
	{
		title: "Performance by default",
		body: "Every site and app is optimised for Core Web Vitals, mobile-first and instrumented with analytics from day one.",
	},
	{
		title: "Marketing and dev aligned",
		body: "Because our dev and marketing teams share the same weekly sprint, landing pages deploy the same day campaigns launch - not a week after.",
	},
];
---

<StudioLayout
	title="Web & App Development Agency India - Websites, Apps, SaaS | Orbitlee"
	description="Website development, mobile apps, SaaS platforms, landing pages, UI/UX design and AI automation by Orbitlee India. Built fast, optimised for performance and growth."
>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
	</Fragment>

	<section class="pg container">
		<p class="crumb"><a href="/services">Services</a> <span>/</span> Web & App Development</p>
		<p class="eyebrow"><span class="eyebrow__dot"></span> Sites · Apps · SaaS</p>
		<h1>Built to convert and <em>scale</em>.</h1>
		<p class="lead">Landing pages to SaaS — designed and shipped at marketing speed, not a quarter later. Split into <a href="/services/web-development">web development</a> and <a href="/services/software-app-development">software &amp; app development</a> if you want a tighter brief.</p>
		<div class="pg__actions">
			<a href="/contact" class="btn btn--solid">Start a project</a>
			<a href="/services" class="btn btn--ghost">All services</a>
		</div>
	</section>

	<section class="section" style="padding-top: 0;">
		<div class="container split">
			<img src="/1.jpg" alt="Design and product work by Orbitlee" />
			<div>
				<p class="kicker">Approach</p>
				<h2 class="h2">Dev that moves at marketing speed.</h2>
				{approach.map((a) => (
					<p><strong style="color: var(--ink);">{a.title}.</strong> {a.body}</p>
				))}
			</div>
		</div>
	</section>

	<section class="section" style="padding-top: 0;">
		<div class="container">
			<p class="kicker">What’s included</p>
			<h2 class="h2">The full product stack.</h2>
			<div class="offer" style="margin-top: 28px;">
				{offerings.map((o) => (
					<article>
						<h3>{o.title}</h3>
						<p>{o.desc}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="cta-block">
		<div>
			<h2>Have a product to ship?</h2>
			<p>We’ll scope the fastest path to live.</p>
		</div>
		<a href="/contact" class="btn btn--solid">Start a project</a>
	</section>
</StudioLayout>
