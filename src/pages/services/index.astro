---
import StudioLayout from '../../layouts/StudioLayout.astro';
import { extraServices, servicePillars, services } from '../../lib/content';

const marketing = servicePillars.filter((s) => s.lane === 'growth');
const technology = servicePillars.filter((s) => s.lane === 'build');

const siteUrl = 'https://www.orbitlee.com';
const servicesSchema = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'CollectionPage',
			'@id': `${siteUrl}/services/#webpage`,
			url: `${siteUrl}/services/`,
			name: 'Services - Orbitlee',
			description: 'Tech and marketing agency services: ads, social, web, apps, branding and growth.',
		},
		{
			'@type': 'ItemList',
			name: 'Orbitlee Services',
			numberOfItems: services.length,
			itemListElement: services.map((s, i) => ({
				'@type': 'ListItem',
				position: i + 1,
				name: s.title,
				url: `${siteUrl}${s.href}/`,
			})),
		},
		{
			'@type': 'BreadcrumbList',
			itemListElement: [
				{ '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
				{ '@type': 'ListItem', position: 2, name: 'Services', item: `${siteUrl}/services/` },
			],
		},
	],
};
---

<StudioLayout
	title="Tech & Marketing Services | Ads, Web, Apps | Orbitlee"
	description="Orbitlee services: digital marketing, performance ads, social media, web development, apps and software. Hire one lane or keep both."
	keywords="tech and marketing services, digital marketing, performance ads, web development, app development, Orbitlee"
>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(servicesSchema)} />
	</Fragment>

	<section class="pg container">
		<p class="crumb"><a href="/">Home</a> <span>/</span> Services</p>
		<p class="eyebrow"><span class="eyebrow__dot"></span> Tech &amp; marketing services</p>
		<h1>Tech and marketing services. Ads, apps, or <em>both</em>.</h1>
		<p class="lead">Hire the campaign, hire the product, or keep them in one weekly sprint.</p>
	</section>

	<section class="section" style="padding-top: 0;">
		<div class="container depts">
			<div>
				<p class="kicker kicker--m">Marketing</p>
				<div class="svc-cards" style="grid-template-columns: 1fr; margin-top: 16px;">
					{marketing.map((s) => (
						<a class="svc-card" href={s.href}>
							<img src={s.img} alt={`${s.title} work by Orbitlee`} loading="lazy" width="280" height="280" />
							<div>
								<h3>{s.title}</h3>
								<p>{s.blurb}</p>
								<ul>{s.items.map((i) => <li>{i}</li>)}</ul>
							</div>
						</a>
					))}
				</div>
			</div>
			<div>
				<p class="kicker kicker--t">Technology</p>
				<div class="svc-cards" style="grid-template-columns: 1fr; margin-top: 16px;">
					{technology.map((s) => (
						<a class="svc-card" href={s.href}>
							<img src={s.img} alt={`${s.title} work by Orbitlee`} loading="lazy" width="280" height="280" />
							<div>
								<h3>{s.title}</h3>
								<p>{s.blurb}</p>
								<ul>{s.items.map((i) => <li>{i}</li>)}</ul>
							</div>
						</a>
					))}
				</div>
			</div>
		</div>
	</section>

	<section class="section" style="padding-top: 0;">
		<div class="container">
			<p class="kicker">Also</p>
			<h2 class="h2">Brand and the roadmap.</h2>
			<div class="svc-cards" style="margin-top: 28px;">
				{extraServices.map((s) => (
						<a class="svc-card" href={s.href}>
							<img src={s.img} alt={`${s.title} by Orbitlee`} loading="lazy" width="280" height="280" />
						<div>
							<h3>{s.title}</h3>
							<p>{s.blurb}</p>
							<ul>{s.items.map((i) => <li>{i}</li>)}</ul>
						</div>
					</a>
				))}
			</div>
		</div>
	</section>

	<section class="cta-block">
		<div>
			<h2>Not sure where to start?</h2>
			<p>A free 30-minute chat. We’ll say what’s first.</p>
		</div>
		<a href="/contact" class="btn btn--solid">Book a free audit</a>
	</section>
</StudioLayout>
