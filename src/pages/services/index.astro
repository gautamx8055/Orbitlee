---
import StudioLayout from '../../layouts/StudioLayout.astro';
import { extraServices, servicePillars, services } from '../../lib/content';

const siteUrl = 'https://www.orbitlee.com';
const servicesSchema = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'CollectionPage',
			'@id': `${siteUrl}/services/#webpage`,
			url: `${siteUrl}/services/`,
			name: 'Services - Orbitlee',
			description: 'Digital marketing, performance marketing, social media, software, web, branding and growth consulting under one roof.',
		},
		{
			'@type': 'ItemList',
			name: 'Orbitlee Services',
			numberOfItems: services.length,
			itemListElement: services.map((s, i) => ({
				'@type': 'ListItem',
				position: i + 1,
				name: s.title,
				url: `${siteUrl}${s.href}/`,
			})),
		},
	],
};
---

<StudioLayout
	title="Services — Orbitlee Creative & Marketing Agency India"
	description="Digital marketing, performance marketing, social media management, software & app development, web development, branding and growth. One team, one weekly sprint."
>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(servicesSchema)} />
	</Fragment>

	<section class="pg container">
		<p class="crumb"><a href="/">Home</a> <span>/</span> Services</p>
		<p class="eyebrow"><span class="eyebrow__dot"></span> Five practices · one pod</p>
		<h1>Everything you need to <em>grow</em>.</h1>
		<p class="lead">Digital marketing, performance, social, software and web — plus branding and growth when the brief needs them. One team, not a vendor pile.</p>
	</section>

	<section class="section" style="padding-top: 0;">
		<div class="container">
			<p class="kicker">Core services</p>
			<h2 class="h2">What clients usually <em>hire</em>.</h2>
			<div class="svc-cards" style="margin-top: 28px;">
				{servicePillars.map((s) => (
					<a class="svc-card" href={s.href}>
						<img src={s.img} alt="" loading="lazy" />
						<div>
							<h3>{s.title}</h3>
							<p>{s.blurb}</p>
							<ul>{s.items.map((i) => <li>{i}</li>)}</ul>
						</div>
					</a>
				))}
			</div>
		</div>
	</section>

	<section class="section" style="padding-top: 0;">
		<div class="container">
			<p class="kicker">Also in the studio</p>
			<h2 class="h2">Brand and the roadmap.</h2>
			<div class="svc-cards" style="margin-top: 28px;">
				{extraServices.map((s) => (
					<a class="svc-card" href={s.href}>
						<img src={s.img} alt="" loading="lazy" />
						<div>
							<h3>{s.title}</h3>
							<p>{s.blurb}</p>
							<ul>{s.items.map((i) => <li>{i}</li>)}</ul>
						</div>
					</a>
				))}
			</div>
		</div>
	</section>

	<section class="cta-block">
		<div>
			<h2>Not sure where to start?</h2>
			<p>The free audit tells you where the biggest wins are hiding.</p>
		</div>
		<a href="/contact" class="btn btn--solid">Book a free audit</a>
	</section>
</StudioLayout>
