---
import StudioLayout from '../../layouts/StudioLayout.astro';

const siteUrl = "https://www.orbitlee.com";
const pageSchema = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "Service",
			"@id": `${siteUrl}/services/marketing-advertising/#service`,
			name: "Marketing & Advertising",
			serviceType: "Digital Marketing & Advertising",
			provider: { "@id": `${siteUrl}/#organization` },
			areaServed: { "@type": "Country", name: "India" },
			description: "Full-funnel marketing and advertising - Meta Ads, Google Ads, social media management, AI UGC, lead generation and email marketing.",
			url: `${siteUrl}/services/marketing-advertising/`,
			hasOfferCatalog: {
				"@type": "OfferCatalog",
				name: "Marketing & Advertising Services",
				itemListElement: [
					{ "@type": "Offer", itemOffered: { "@type": "Service", name: "Meta Ads (Facebook & Instagram Ads)" } },
					{ "@type": "Offer", itemOffered: { "@type": "Service", name: "Google Ads (Search, Display, YouTube)" } },
					{ "@type": "Offer", itemOffered: { "@type": "Service", name: "Social Media Management" } },
					{ "@type": "Offer", itemOffered: { "@type": "Service", name: "Lead Generation" } },
					{ "@type": "Offer", itemOffered: { "@type": "Service", name: "AI UGC Production" } },
					{ "@type": "Offer", itemOffered: { "@type": "Service", name: "Email Marketing" } },
				],
			},
		},
		{
			"@type": "BreadcrumbList",
			itemListElement: [
				{ "@type": "ListItem", position: 1, name: "Home", item: siteUrl },
				{ "@type": "ListItem", position: 2, name: "Services", item: `${siteUrl}/services/` },
				{ "@type": "ListItem", position: 3, name: "Marketing & Advertising", item: `${siteUrl}/services/marketing-advertising/` },
			],
		},
		{
			"@type": "FAQPage",
			mainEntity: [
				{ "@type": "Question", name: "What marketing services does Orbitlee offer?", acceptedAnswer: { "@type": "Answer", text: "Orbitlee offers full-funnel marketing services including Meta Ads (Facebook & Instagram), Google Ads (Search, Display, YouTube), social media management, lead generation, AI UGC production and email marketing campaigns." } },
				{ "@type": "Question", name: "Does Orbitlee run Meta and Google Ads?", acceptedAnswer: { "@type": "Answer", text: "Yes - Orbitlee manages Meta Ads (Facebook and Instagram) and Google Ads (Search, Display, YouTube) campaigns. We handle strategy, creative, targeting, optimisation and weekly performance reporting." } },
				{ "@type": "Question", name: "What is AI UGC and does Orbitlee produce it?", acceptedAnswer: { "@type": "Answer", text: "AI UGC (AI User-Generated Content) is high-performing ad content that looks authentic and organic, produced using AI tools at a fraction of traditional shoot costs. Orbitlee is an AI UGC agency that produces these at scale for paid campaigns." } },
			],
		},
	],
};

const offerings = [
	{
		icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>`,
		title: "Meta Ads",
		desc: "Facebook and Instagram campaigns built to convert - from creative strategy to pixel setup, audience architecture and ongoing optimisation.",
	},
	{
		icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>`,
		title: "Google Ads",
		desc: "Search, display and YouTube campaigns targeting high-intent buyers at the exact moment they're looking for what you offer.",
	},
	{
		icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`,
		title: "Social Media Management",
		desc: "Content calendars, community management and growth strategy across Instagram, LinkedIn and beyond - consistent, on-brand, and built to compound.",
	},
	{
		icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
		title: "Lead Generation",
		desc: "End-to-end pipeline building - from landing pages and lead magnets to nurture sequences that warm leads and hand them off sales-ready.",
	},
	{
		icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2"/></svg>`,
		title: "AI UGC Production",
		desc: "AI-generated user content that looks authentic and performs like organic. 10× the ad variants at a fraction of traditional production cost.",
	},
	{
		icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><path d="m22 6-10 7L2 6"/></svg>`,
		title: "Email Marketing",
		desc: "Sequences, broadcasts and automation flows that keep your audience engaged, nurture intent and drive repeat revenue.",
	},
];

const approach = [
	{
		title: "Strategy before spend",
		body: "We map your funnel, audience segments and creative angles before a single rupee goes live. Bad targeting wastes budgets; good strategy compounds them.",
	},
	{
		title: "Creative and media together",
		body: "Our ads team and creative team share the same brief. The creative is built for the placement, not repurposed from a static graphic.",
	},
	{
		title: "Data that drives decisions",
		body: "Weekly performance reviews with clear attribution. No vanity metrics — we report on CAC, ROAS and pipeline, and adjust accordingly.",
	},
	{
		title: "Never off. Never behind.",
		body: "Trends move fast. We ship weekly so your brand stays present — organic, paid and creative in the same cadence.",
	},
];
---

<StudioLayout
	title="Marketing & Advertising Agency India - Meta Ads, Google Ads, AI UGC | Orbitlee"
	description="Full-funnel marketing & advertising by Orbitlee India - Meta Ads, Google Ads, social media management, AI UGC production, lead generation. Compounding results from one team."
>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
	</Fragment>

	<section class="pg container">
		<p class="crumb"><a href="/services">Services</a> <span>/</span> Marketing & Advertising</p>
		<p class="eyebrow"><span class="eyebrow__dot"></span> Social · Ads · AI UGC</p>
		<h1>Anyone can post. We build growth you can <em>measure</em>.</h1>
		<p class="lead">Meta, Google, social and AI UGC from one pod — so the metric you watch is growth, not vanity. For the deeper practices see <a href="/services/digital-marketing">digital marketing</a>, <a href="/services/performance-marketing">performance marketing</a> and <a href="/services/social-media">social media</a>.</p>
		<div class="pg__actions">
			<a href="/contact" class="btn btn--solid">Start a campaign</a>
			<a href="/services" class="btn btn--ghost">All services</a>
		</div>
	</section>

	<section class="section" style="padding-top: 0;">
		<div class="container split">
			<div>
				<p class="kicker">How we run it</p>
				<h2 class="h2">Social and ads that actually connect.</h2>
				<p>We start with your audience — what stops the scroll, what earns a follow, what converts. Reels, AI UGC and paid social share one brief.</p>
				<div class="offer" style="grid-template-columns: 1fr 1fr; margin-top: 24px;">
					{approach.map((a) => (
						<article>
							<h3>{a.title}</h3>
							<p>{a.body}</p>
						</article>
					))}
				</div>
			</div>
			<img src="/Ads-try-1-F.jpg" alt="Paid social ad creative by Orbitlee" />
		</div>
	</section>

	<section class="section" style="padding-top: 0;">
		<div class="container">
			<p class="kicker">What’s included</p>
			<h2 class="h2">The full marketing stack.</h2>
			<div class="offer" style="margin-top: 28px;">
				{offerings.map((o) => (
					<article>
						<h3>{o.title}</h3>
						<p>{o.desc}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="cta-block">
		<div>
			<h2>Ready to spend smarter?</h2>
			<p>Free audit. We’ll show you where the budget should go.</p>
		</div>
		<a href="/contact" class="btn btn--solid">Book a free audit</a>
	</section>
</StudioLayout>
