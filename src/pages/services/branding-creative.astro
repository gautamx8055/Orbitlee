---
import Layout from '../../layouts/Layout.astro';

const offerings = [
	{
		icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>`,
		title: "Brand Strategy",
		desc: "Positioning, messaging hierarchy and a clear point of view. We define what your brand stands for and who it's built to serve.",
	},
	{
		icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="3"/></svg>`,
		title: "Logo Design",
		desc: "Marks built to last — distinctive, scalable across every surface and rooted in your brand's actual positioning.",
	},
	{
		icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>`,
		title: "Visual Identity",
		desc: "Colour systems, typography, iconography and brand guidelines that give your team the tools to stay consistent everywhere.",
	},
	{
		icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>`,
		title: "Packaging Design",
		desc: "Shelf-presence and unboxing experiences designed to convert at point of purchase and generate organic shares.",
	},
	{
		icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2"/></svg>`,
		title: "AI UGC Production",
		desc: "Authentic-looking AI user content at scale — 10× the ad variants at a fraction of traditional shoot costs. Built for performance.",
	},
	{
		icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m15 10-4 4 6 6-4-16-6 6 4-4"/></svg>`,
		title: "Commercial Ads",
		desc: "High-production video and photo content engineered to stop the scroll and move product — from concept to final deliverable.",
	},
	{
		icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>`,
		title: "Product Photography",
		desc: "Clean, scroll-stopping product imagery styled for e-commerce, social and paid campaigns.",
	},
	{
		icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 3l14 9-14 9V3z"/></svg>`,
		title: "Motion Graphics",
		desc: "Animated content for social, ads and product demos — from short-form reels to full explainer sequences.",
	},
];

const approach = [
	{
		title: "Identity built on truth",
		body: "We start with your audience, competitors and positioning — not moodboards. Every creative decision connects back to a strategic reason.",
	},
	{
		title: "Production and performance aligned",
		body: "Our creative team is briefed alongside the media team. The content is built to perform in the platform it's made for, not adapted after the fact.",
	},
	{
		title: "Systems, not one-offs",
		body: "A logo isn't a brand. We build identity systems your team can actually execute at scale without hiring a designer for every post.",
	},
];
---

<Layout
	title="Branding & Creative — Orbitlee"
	description="Brand strategy, logo design, visual identity, AI UGC, commercial ads, product photography and motion graphics — high-craft creative production built to convert."
>
	<!-- BREADCRUMB + HERO -->
	<section class="page-hero">
		<div class="breadcrumb">
			<a href="/services">Services</a>
			<span class="breadcrumb__sep">›</span>
			<span>Branding & Creative</span>
		</div>
		<div class="page-hero__eyebrow">
			<span class="eyebrow eyebrow--plain">Branding & Creative</span>
		</div>
		<h1 class="page-hero__title">Identity that <span class="hero__gradient">commands attention.</span></h1>
		<p class="page-hero__sub">
			Positioning, identity systems and high-craft production built to stop the scroll, make your brand stick and turn browsers into buyers.
		</p>
		<div class="hero__actions" style="margin-top: 32px;">
			<a href="/contact" class="btn btn--primary btn--lg">Build my brand</a>
			<a href="/services" class="btn btn--ghost btn--lg">All services</a>
		</div>
	</section>

	<!-- WHAT'S INCLUDED -->
	<section class="section">
		<div class="section__head">
			<span class="eyebrow eyebrow--plain">What's included</span>
			<h2 class="section__title">Strategy to <span class="hero__gradient">screen-ready.</span></h2>
			<p class="section__sub">From the first positioning brief to the final production asset — we cover the full creative stack.</p>
		</div>
		<div class="svc-detail-grid">
			{offerings.map((o) => (
				<article class="svc-item">
					<div class="svc-item__icon" set:html={o.icon}></div>
					<h3 class="svc-item__title">{o.title}</h3>
					<p class="svc-item__desc">{o.desc}</p>
				</article>
			))}
		</div>
	</section>

	<!-- OUR APPROACH -->
	<section class="section section--why">
		<div class="section__head">
			<span class="eyebrow eyebrow--plain">Our approach</span>
			<h2 class="section__title">Creative built <span class="hero__gradient">to perform.</span></h2>
		</div>
		<div class="why-grid">
			{approach.map((a, i) => (
				<article class="why-card">
					<span class="why-card__num">0{i + 1}</span>
					<h3 class="why-card__title">{a.title}</h3>
					<p class="why-card__body">{a.body}</p>
				</article>
			))}
		</div>
	</section>

	<!-- CTA -->
	<div class="cta-strip">
		<div class="cta-strip__inner">
			<div class="cta-strip__copy">
				<h2 class="cta-strip__title">Want a brand that <span class="hero__gradient">actually stands out?</span></h2>
				<p class="cta-strip__sub">Let's audit what you have and map what it should become.</p>
			</div>
			<a href="/contact" class="btn btn--primary btn--lg">Book a brand audit</a>
		</div>
	</div>
</Layout>
