---
import StudioLayout from '../../layouts/StudioLayout.astro';
import ServiceDepth from '../../components/studio/ServiceDepth.astro';
import OfferIcon from '../../components/studio/OfferIcon.astro';

const siteUrl = "https://www.orbitlee.com";
const pageSchema = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "Service",
			"@id": `${siteUrl}/services/branding-creative/#service`,
			name: "Branding & Creative",
			serviceType: "Branding, Design and Creative Production",
			provider: { "@id": `${siteUrl}/#organization` },
			areaServed: { "@type": "Place", name: "Worldwide" },
			description: "Brand strategy, logo design, visual identity, AI UGC production, commercial ads, product photography and motion graphics.",
			url: `${siteUrl}/services/branding-creative/`,
		},
		{
			"@type": "BreadcrumbList",
			itemListElement: [
				{ "@type": "ListItem", position: 1, name: "Home", item: siteUrl },
				{ "@type": "ListItem", position: 2, name: "Services", item: `${siteUrl}/services/` },
				{ "@type": "ListItem", position: 3, name: "Branding & Creative", item: `${siteUrl}/services/branding-creative/` },
			],
		},
		{
			"@type": "FAQPage",
			mainEntity: [
				{ "@type": "Question", name: "Does Orbitlee do logo and brand identity design?", acceptedAnswer: { "@type": "Answer", text: "Yes - Orbitlee provides complete branding services including brand strategy, logo design, visual identity systems, brand guidelines, packaging design and all brand collateral." } },
				{ "@type": "Question", name: "What is AI UGC production?", acceptedAnswer: { "@type": "Answer", text: "AI UGC (Artificial Intelligence User-Generated Content) is authentic-looking ad content created with AI tools. Orbitlee produces AI UGC at scale - 10x more ad variants at a fraction of traditional production cost, built specifically for paid advertising performance." } },
			],
		},
	],
};

const offerings = [
	{ icon: 'star', title: 'Brand strategy', desc: 'Positioning and a point of view. What you stand for, who it’s for.' },
	{ icon: 'mark', title: 'Logo', desc: 'A mark that scales. Distinctive, not a trend clip.' },
	{ icon: 'grid', title: 'Visual identity', desc: 'Type, colour, rules your team can use without us on every post.' },
	{ icon: 'spark', title: 'AI UGC', desc: 'More ad variants, less shoot cost. Built for paid.' },
	{ icon: 'play', title: 'Commercial ads', desc: 'Film and stills from one brief, made to stop the scroll.' },
	{ icon: 'motion', title: 'Motion', desc: 'Short motion for social, ads and product demos.' },
];

const approach = [
	{
		title: "Identity built on truth",
		body: "We start with your audience, competitors and positioning - not moodboards. Every creative decision connects back to a strategic reason.",
	},
	{
		title: "Production and performance aligned",
		body: "Our creative team is briefed alongside the media team. The content is built to perform in the platform it's made for, not adapted after the fact.",
	},
	{
		title: "Systems, not one-offs",
		body: "A logo isn't a brand. We build identity systems your team can actually execute at scale without hiring a designer for every post.",
	},
];

const week = [
	{ t: 'Truth', d: 'Audience, competitors, what you actually sell.' },
	{ t: 'Look', d: 'Mark, type, colour. Built to scale.' },
	{ t: 'System', d: 'Rules your team can use without us on every post.' },
	{ t: 'Ads', d: 'First creatives that match the identity.' },
];
const fit = [
	{ t: 'A logo isn’t a brand', d: 'You need a system, not one mark.' },
	{ t: 'Ads look off-brand', d: 'Creative and identity should share a brief.' },
	{ t: 'You need volume', d: 'UGC and ads without a new shoot every week.' },
];
const weekly = [
	{ t: 'Refs', d: 'What we’re aiming at. What’s out.' },
	{ t: 'Assets', d: 'Files you can ship. Not a moodboard only.' },
	{ t: 'Usage', d: 'How the team applies it on Monday.' },
];
---

<StudioLayout
	title="Branding Agency | Identity & Ad Creative | Orbitlee"
	description="Brand strategy, logo, identity and ad creative from Orbitlee. Consistent systems your team can use. Free 30-minute brand chat."
	keywords="branding agency, brand identity, logo design, ad creative, AI UGC production, Orbitlee"
>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
	</Fragment>

	<section class="pg container">
		<p class="crumb"><a href="/services/">Services</a> <span>/</span> Branding & Creative</p>
		<p class="eyebrow"><span class="eyebrow__dot"></span> Identity · Production · UGC</p>
		<h1>Branding and creative people <em>notice</em>.</h1>
		<p class="lead">Logo, look and ads that stay consistent, from an international tech and marketing agency.</p>
		<div class="pg__actions">
			<a href="/contact/" class="btn btn--solid">Build my brand</a>
			<a href="/services/" class="btn btn--ghost">All services</a>
		</div>
	</section>

	<section class="section" style="padding-top: 0;">
		<div class="container split">
			<div>
				<p class="kicker">Approach</p>
				<h2 class="h2">Creative built to perform.</h2>
				{approach.map((a) => (
					<p><strong style="color: var(--ink);">{a.title}.</strong> {a.body}</p>
				))}
			</div>
			<img src="/5.jpg" alt="Brand and thumbnail work by Orbitlee" loading="lazy" width="800" height="600" />
		</div>
	</section>

	<section class="section" style="padding-top: 0;">
		<div class="container">
			<p class="kicker">What’s included</p>
			<h2 class="h2">The full creative stack.</h2>
			<div class="offer offer--book" style="margin-top: 28px;">
				{offerings.map((o) => (
					<article>
						<OfferIcon name={o.icon} />
						<h3>{o.title}</h3>
						<p>{o.desc}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<ServiceDepth week={week} fit={fit} weekly={weekly} lane="growth" />

	<section class="cta-block">
		<div>
			<h2>Want a brand that stands out?</h2>
			<p>We’ll audit what you have and map what it should become.</p>
		</div>
		<a href="/contact/" class="btn btn--solid">Book a brand audit</a>
	</section>
</StudioLayout>
