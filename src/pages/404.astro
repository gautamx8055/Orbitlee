---
import StudioLayout from '../layouts/StudioLayout.astro';
---

<StudioLayout
	title="Page not found | Orbitlee"
	description="This Orbitlee page is missing. Head home, see the work, or book a 30-minute chat."
	keywords="Orbitlee 404"
	noindex
>
	<section class="pg container">
		<p class="crumb"><a href="/">Home</a> <span>/</span> 404</p>
		<p class="eyebrow"><span class="eyebrow__dot"></span> Lost orbit</p>
		<h1>This page is <em>gone</em>.</h1>
		<p class="lead">The link is old, or the page never existed. The mix is still here.</p>
		<div class="pg__actions">
			<a href="/" class="btn btn--solid">Go home</a>
			<a href="/work/" class="btn btn--ghost">See the work</a>
			<a href="/contact/" class="btn btn--ghost">Start a project</a>
		</div>
	</section>
</StudioLayout>
