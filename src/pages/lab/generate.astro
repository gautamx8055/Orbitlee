---
// Internal tool, not linked from nav. Static page — only /api/runway/generate
// is on-demand, so this still builds and deploys like the rest of the site.
import StudioLayout from '../../layouts/StudioLayout.astro';
import { IMAGE_MODELS, VIDEO_MODELS } from '../../lib/runway';

const imageModels = Object.values(IMAGE_MODELS);
const videoModels = Object.values(VIDEO_MODELS);
const catalog = { image: imageModels, video: videoModels };
---

<StudioLayout title="Runway Lab — Orbitlee" description="Internal content-generation tool powered by the Runway Dev API." noindex>
	<section class="container lab">
		<div class="lab__head">
			<span class="eyebrow"><span class="eyebrow__dot"></span>Internal tool</span>
			<h1 class="lab__title">Runway <span class="u italic accent">Lab</span></h1>
			<p class="lab__sub">Text prompt in, image or video out — via the Runway Dev API (<code>text_to_image</code> / <code>text_to_video</code>). Submits and waits server-side; a run can take anywhere from a few seconds to a few minutes.</p>
		</div>

		<form id="lab-form" class="lab__form">
			<div class="lab__row lab__row--modes" role="radiogroup" aria-label="Output type">
				<button type="button" class="lab__mode is-active" data-mode="image">Image</button>
				<button type="button" class="lab__mode" data-mode="video">Video</button>
			</div>

			<label class="lab__field">
				<span>Prompt</span>
				<textarea id="lab-prompt" name="promptText" rows="4" placeholder="A studio product shot of a matte ceramic mug on a warm gradient backdrop, soft rim light" required></textarea>
			</label>

			<div class="lab__row">
				<label class="lab__field">
					<span>Model</span>
					<select id="lab-model" name="model"></select>
				</label>
				<label class="lab__field">
					<span>Ratio</span>
					<select id="lab-ratio" name="ratio"></select>
				</label>
				<label class="lab__field" id="lab-duration-field">
					<span>Duration (s)</span>
					<input id="lab-duration" name="duration" type="number" />
				</label>
			</div>

			<div class="lab__row lab__row--foot">
				<button type="submit" class="btn btn--lime" id="lab-submit">
					Generate
					<span class="btn__arrow"><svg viewBox="0 0 12 12" fill="none"><path d="M2 10 10 2M4 2h6v6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
				</button>
				<span class="lab__pricing" id="lab-pricing"></span>
			</div>
		</form>

		<div class="lab__status" id="lab-status" role="status" aria-live="polite"></div>
		<div class="lab__result" id="lab-result"></div>
	</section>

	<script type="application/json" id="lab-catalog" is:inline set:html={JSON.stringify(catalog)} />
	<script src="../../scripts/lab-generate.ts"></script>
</StudioLayout>

<style>
	.lab {
		padding-block: clamp(48px, 8vw, 96px);
		max-width: 760px;
	}
	.lab__title {
		font-family: var(--ff-display);
		font-size: clamp(2.2rem, 5vw, 3.2rem);
		margin: 12px 0 10px;
	}
	.lab__sub {
		color: var(--ink-mute);
		max-width: 56ch;
		line-height: 1.6;
	}
	.lab__sub code {
		font-family: var(--ff-mono);
		font-size: 0.85em;
		color: var(--ink);
	}
	.lab__form {
		margin-top: 36px;
		display: flex;
		flex-direction: column;
		gap: 18px;
		background: var(--bg-elev);
		border: 1px solid var(--rule);
		border-radius: 16px;
		padding: clamp(18px, 3vw, 28px);
	}
	.lab__row {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
		gap: 14px;
	}
	.lab__row--modes {
		grid-template-columns: repeat(2, max-content);
	}
	.lab__row--foot {
		grid-template-columns: max-content 1fr;
		align-items: center;
		margin-top: 4px;
	}
	.lab__mode {
		font-family: var(--ff-mono);
		font-size: 0.8rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		padding: 9px 18px;
		border-radius: 999px;
		border: 1px solid var(--rule-strong);
		color: var(--ink-mute);
		background: transparent;
		cursor: pointer;
		transition: all 0.2s var(--ease-out);
	}
	.lab__mode.is-active {
		color: var(--bg);
		background: var(--lime);
		border-color: var(--lime);
	}
	.lab__field {
		display: flex;
		flex-direction: column;
		gap: 6px;
		font-size: 0.8rem;
		color: var(--ink-mute);
	}
	.lab__field span {
		font-family: var(--ff-mono);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		font-size: 0.72rem;
	}
	.lab__field textarea,
	.lab__field select,
	.lab__field input {
		font: inherit;
		font-family: var(--ff-sans);
		font-size: 0.95rem;
		color: var(--ink);
		background: var(--bg);
		border: 1px solid var(--rule-strong);
		border-radius: 10px;
		padding: 10px 12px;
		resize: vertical;
	}
	.lab__field textarea:focus,
	.lab__field select:focus,
	.lab__field input:focus {
		outline: none;
		border-color: var(--lime);
	}
	.lab__pricing {
		font-family: var(--ff-mono);
		font-size: 0.75rem;
		color: var(--ink-dim);
		text-align: right;
	}
	.lab__status {
		margin-top: 20px;
		font-family: var(--ff-mono);
		font-size: 0.85rem;
		color: var(--ink-mute);
		min-height: 1.4em;
	}
	.lab__status[data-state='error'] {
		color: #ff6b6b;
	}
	.lab__result {
		margin-top: 20px;
		display: grid;
		gap: 12px;
	}
	.lab__result img,
	.lab__result video {
		width: 100%;
		border-radius: 14px;
		border: 1px solid var(--rule);
	}
	.lab__submit-disabled {
		opacity: 0.6;
		pointer-events: none;
	}
</style>
