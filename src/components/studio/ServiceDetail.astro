---
import StudioLayout from '../../layouts/StudioLayout.astro';
import { servicePillars, type ServicePillar } from '../../lib/content';

interface Props {
	service: ServicePillar;
}

const { service: s } = Astro.props;
const siteUrl = 'https://www.orbitlee.com';
const others = servicePillars.filter((p) => p.slug !== s.slug);

const pageSchema = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Service',
			'@id': `${siteUrl}${s.href}/#service`,
			name: s.title,
			serviceType: s.title,
			provider: { '@id': `${siteUrl}/#organization` },
			areaServed: { '@type': 'Place', name: 'Worldwide' },
			description: s.lead,
			url: `${siteUrl}${s.href}/`,
			hasOfferCatalog: {
				'@type': 'OfferCatalog',
				name: `${s.title} services`,
				itemListElement: s.offerings.map((o) => ({
					'@type': 'Offer',
					itemOffered: { '@type': 'Service', name: o.title, description: o.desc },
				})),
			},
		},
		{
			'@type': 'BreadcrumbList',
			itemListElement: [
				{ '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
				{ '@type': 'ListItem', position: 2, name: 'Services', item: `${siteUrl}/services/` },
				{ '@type': 'ListItem', position: 3, name: s.title, item: `${siteUrl}${s.href}/` },
			],
		},
		{
			'@type': 'FAQPage',
			mainEntity: s.faqs.map((f) => ({
				'@type': 'Question',
				name: f.q,
				acceptedAnswer: { '@type': 'Answer', text: f.a },
			})),
		},
	],
};
---

<StudioLayout title={s.seoTitle} description={s.seoDescription} keywords={s.seoKeywords}>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
	</Fragment>

	<section class="pg container">
		<p class="crumb"><a href="/services">Services</a> <span>/</span> {s.title}</p>
		<p class="eyebrow"><span class="eyebrow__dot"></span> {s.eyebrow}</p>
		<h1>{s.headline} <em>{s.headlineEm}</em>.</h1>
		<p class="lead">{s.lead}</p>
		<div class="pg__actions">
			<a href="/contact" class="btn btn--solid">{s.ctaLabel}</a>
			<a href="/services" class="btn btn--ghost">All services</a>
		</div>
	</section>

	<section class="section" style="padding-top: 0;">
		<div class="container split">
			<div>
				<p class="kicker">In short</p>
				<h2 class="h2">How we can <em>help</em>.</h2>
				<p>{s.story}</p>
			</div>
			<img src={s.img} alt={s.imgAlt} loading="lazy" width="640" height="480" />
		</div>
	</section>

	<section class="section" style="padding-top: 0;">
		<div class="container">
			<p class="kicker">Includes</p>
			<h2 class="h2">What you can book.</h2>
			<div class="offer" style="margin-top: 28px;">
				{s.offerings.map((o) => (
					<article id={o.id}>
						<h3>{o.title}</h3>
						<p>{o.desc}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="section" style="padding-top: 0;">
		<div class="container faq">
			<p class="kicker">FAQ</p>
			<h2 class="h2">Quick answers.</h2>
			{s.faqs.map((f) => (
				<details>
					<summary>{f.q}</summary>
					<p class="faq__a">{f.a}</p>
				</details>
			))}
		</div>
	</section>

	<section class="section" style="padding-top: 0;">
		<div class="container">
			<p class="kicker">Also</p>
			<div class="svc-mini">
				{others.map((p) => (
					<a href={p.href}>
						<strong>{p.navLabel}</strong>
						<span>{p.blurb}</span>
					</a>
				))}
			</div>
		</div>
	</section>

	<section class="cta-block">
		<div>
			<h2>{s.ctaTitle}</h2>
			<p>{s.ctaBody}</p>
		</div>
		<a href="/contact" class="btn btn--solid">{s.ctaLabel}</a>
	</section>
</StudioLayout>
