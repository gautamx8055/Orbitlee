---
import { servicePillars } from '../../lib/content';

interface Props {
	pathname: string;
}
const { pathname } = Astro.props;
const path = pathname.replace(/\/+$/, '') || '/';
const servicesOpen = path === '/services' || path.startsWith('/services/');
---

<nav class="nav" id="studio-nav" aria-label="Primary">
	<a href="/" class="nav__brand" aria-label="Orbitlee home">
		<img class="nav__mark" src="/Orbitlee-fav-icon.png" alt="" width="36" height="34" />
		<span class="nav__word">Orbitlee</span>
	</a>

	<ul class="nav__list">
		<li>
			<a href="/work/" class={path === '/work' ? 'is-active' : undefined}>Work</a>
		</li>
		<li class="nav__item--drop" data-nav-drop>
			<a
				href="/services/"
				class:list={['nav__parent', { 'is-active': servicesOpen }]}
				aria-haspopup="true"
				aria-expanded="false"
				data-nav-drop-trigger
			>
				Services
				<svg viewBox="0 0 12 12" width="10" height="10" aria-hidden="true"><path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
			</a>
			<div class="nav__drop" id="nav-services-panel">
				<div class="nav__drop-panel nav__drop-panel--depts">
					<div>
						<p class="nav__drop-kicker">Marketing</p>
						{servicePillars.filter((p) => p.lane === 'growth').map((p) => (
							<a href={p.href} class={path === p.href.replace(/\/+$/, '') ? 'is-active' : undefined}>
								<strong>{p.navLabel}</strong>
								<span>{p.items.slice(0, 3).join(' · ')}</span>
							</a>
						))}
					</div>
					<div>
						<p class="nav__drop-kicker nav__drop-kicker--t">Technology</p>
						{servicePillars.filter((p) => p.lane === 'build').map((p) => (
							<a href={p.href} class={path === p.href.replace(/\/+$/, '') ? 'is-active' : undefined}>
								<strong>{p.navLabel}</strong>
								<span>{p.items.slice(0, 3).join(' · ')}</span>
							</a>
						))}
					</div>
					<a class="nav__drop-all" href="/services/">All services</a>
				</div>
			</div>
		</li>
		<li>
			<a href="/about/" class={path === '/about' ? 'is-active' : undefined}>About</a>
		</li>
		<li>
			<a href="/contact/" class={path === '/contact' ? 'is-active' : undefined}>Contact</a>
		</li>
	</ul>

	<div class="nav__tools">
		<button class="theme-btn" id="theme-toggle" type="button" aria-label="Switch theme">
			<svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
				<circle cx="12" cy="12" r="4" />
				<path d="M12 3v2M12 19v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M3 12h2M19 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4" />
			</svg>
			<svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
				<path d="M20 14.5A8.5 8.5 0 1 1 9.5 4 7 7 0 0 0 20 14.5Z" />
			</svg>
		</button>
		<a href="/contact/" class="nav__cta">Let’s talk</a>
		<button class="nav__burger" id="studio-burger" type="button" aria-label="Open menu" aria-expanded="false">
			<span></span><span></span><span></span>
		</button>
	</div>
</nav>

<nav class="mnav" id="studio-mnav" aria-hidden="true">
	<a href="/work/">Work</a>
	<a href="/services/">Services</a>
	<div class="mnav__subs">
		<p class="mnav__kicker">Marketing</p>
		{servicePillars.filter((p) => p.lane === 'growth').map((p) => (
			<a href={p.href}>{p.navLabel}</a>
		))}
		<p class="mnav__kicker mnav__kicker--t">Technology</p>
		{servicePillars.filter((p) => p.lane === 'build').map((p) => (
			<a href={p.href}>{p.navLabel}</a>
		))}
	</div>
	<a href="/about/">About</a>
	<a href="/contact/">Contact</a>
	<a href="/contact/">Let’s talk</a>
	<div class="mnav__foot">
		<span>orbitleeee@gmail.com</span>
		<a href="https://wa.me/919999558199" target="_blank" rel="noopener">+91 99995 58199</a>
		<span>Remote · Worldwide</span>
	</div>
</nav>
