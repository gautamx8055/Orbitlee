---
interface Props {
	name: string;
}

const { name } = Astro.props;
const stroke = 'currentColor';
---

<span class="offer__icon" aria-hidden="true">
	<svg viewBox="0 0 24 24" fill="none" stroke={stroke} stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
		{name === 'search' && <><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></>}
		{name === 'file' && <><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><path d="M14 2v6h6M8 13h8M8 17h5" /></>}
		{name === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></>}
		{name === 'chart' && <><path d="M4 19V5M4 19h16" /><path d="M8 16v-5M12 16V8M16 16v-3" /></>}
		{name === 'pin' && <><path d="M12 21s7-5.4 7-11a7 7 0 1 0-14 0c0 5.6 7 11 7 11z" /><circle cx="12" cy="10" r="2.2" /></>}
		{name === 'loop' && <><path d="M3 12a9 9 0 0 1 15-6.7L21 8" /><path d="M21 3v5h-5M21 12a9 9 0 0 1-15 6.7L3 16" /><path d="M3 21v-5h5" /></>}
		{name === 'ads' && <><rect x="3" y="7" width="18" height="12" rx="2" /><path d="M7 7V5a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v2" /><path d="M8 13h8" /></>}
		{name === 'target' && <><circle cx="12" cy="12" r="9" /><circle cx="12" cy="12" r="5" /><circle cx="12" cy="12" r="1.5" /></>}
		{name === 'form' && <><rect x="5" y="3" width="14" height="18" rx="2" /><path d="M9 8h6M9 12h6M9 16h4" /></>}
		{name === 'report' && <><path d="M4 19V5h12l4 4v10H4z" /><path d="M16 5v4h4M8 13h8M8 17h5" /></>}
		{name === 'play' && <><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m10 9 6 3-6 3V9z" /></>}
		{name === 'pixel' && <><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" /></>}
		{name === 'users' && <><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="3" /><path d="M22 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></>}
		{name === 'camera' && <><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z" /><circle cx="12" cy="13" r="4" /></>}
		{name === 'chat' && <><path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z" /></>}
		{name === 'boost' && <><path d="M13 2 4 14h7l-1 8 10-14h-7l0-6z" /></>}
		{name === 'calendar' && <><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4" /></>}
		{name === 'film' && <><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M7 4v16M17 4v16M3 9h4M3 15h4M17 9h4M17 15h4" /></>}
		{name === 'phone' && <><rect x="7" y="2" width="10" height="20" rx="2" /><path d="M11 18h2" /></>}
		{name === 'cloud' && <><path d="M18 18H7a4 4 0 0 1 0-8 5.5 5.5 0 0 1 10.6-1.5A3.5 3.5 0 0 1 18 18z" /></>}
		{name === 'cut' && <><circle cx="6" cy="6" r="3" /><circle cx="6" cy="18" r="3" /><path d="M20 4 8.1 15.9M20 20 8.1 8.1" /></>}
		{name === 'layers' && <><path d="m12 3 9 5-9 5-9-5 9-5z" /><path d="m3 12 9 5 9-5M3 16l9 5 9-5" /></>}
		{name === 'code' && <><path d="m8 8-4 4 4 4M16 8l4 4-4 4" /></>}
		{name === 'test' && <><path d="M9 3h6M10 3v5l-5 9a3 3 0 0 0 2.6 4.5h8.8A3 3 0 0 0 19 17l-5-9V3" /></>}
		{name === 'globe' && <><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" /></>}
		{name === 'layout' && <><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M3 9h18M9 9v11" /></>}
		{name === 'cart' && <><circle cx="9" cy="20" r="1.4" /><circle cx="18" cy="20" r="1.4" /><path d="M3 4h2l2.4 12h11l2-8H7" /></>}
		{name === 'wrench' && <><path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18v3h3l6.3-6.3a4 4 0 0 0 5.4-5.4L16 11l-2.3-2.3 1-2.4z" /></>}
		{name === 'zap' && <><path d="M13 2 4 14h7l-1 8 10-14h-7z" /></>}
		{name === 'edit' && <><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4 11.5-11.5z" /></>}
		{name === 'star' && <path d="M12 3l2.6 6.2L21 10l-5 4.6 1.4 6.4L12 17.8 6.6 21 8 14.6 3 10l6.4-.8L12 3z" />}
		{name === 'mark' && <><circle cx="12" cy="12" r="9" /><circle cx="12" cy="12" r="3" /></>}
		{name === 'grid' && <><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" /></>}
		{name === 'spark' && <path d="M12 3v4M12 17v4M4.2 6.2l2.8 2.8M17 15l2.8 2.8M3 12h4M17 12h4M4.2 17.8 7 15M17 9l2.8-2.8" />}
		{name === 'clap' && <><path d="M4 13v6a2 2 0 0 0 2 2h3" /><path d="M14 9V5a2 2 0 0 0-4 0v10" /><path d="M10 12V7a2 2 0 0 1 4 0v5" /><path d="M18 11v8a2 2 0 0 1-2 2h-1" /></>}
		{name === 'motion' && <><path d="M5 3v18M5 12h14l-5-5M14 17l5-5" /></>}
		{name === 'audit' && <><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5M8 11h6M11 8v6" /></>}
		{name === 'map' && <><path d="M9 4 3 6v14l6-2 6 2 6-2V4l-6 2-6-2z" /><path d="M9 4v14M15 6v14" /></>}
		{name === 'rocket' && <><path d="M5 16c1 3 4 4 4 4s1-3 4-4c6-3 7-10 7-10s-7 1-10 7z" /><path d="m12 12 3 3" /></>}
		{name === 'trend' && <><path d="M3 17 9 11l4 4 8-8" /><path d="M14 7h7v7" /></>}
		{name === 'box' && <><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" /></>}
		{name === 'photo' && <><rect x="3" y="5" width="18" height="14" rx="2" /><circle cx="9" cy="11" r="2" /><path d="m21 15-4.5-4.5L9 18" /></>}
	</svg>
</span>
