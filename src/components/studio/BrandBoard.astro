---
const swatches = [
	{ n: 'Orbit', c: '#9CE454' },
	{ n: 'Pulse', c: '#9C30F0' },
	{ n: 'Ink', c: '#F7F4EE' },
	{ n: 'Void', c: '#0C0814' },
];
---

<figure class="mock mock--brand" aria-label="Sample brand identity kit">
	<div class="mock__bar">
		<span class="term__dot term__dot--lime"></span>
		<span class="term__dot term__dot--mute"></span>
		<span class="term__dot term__dot--violet"></span>
		<p class="mock__title">identity / system</p>
	</div>
	<div class="mock__body kit">
		<div class="kit__mark" aria-hidden="true">
			<span></span>
			<strong>YOUR MARK</strong>
		</div>
		<p class="kit__type">Aa Bb <em>Display</em></p>
		<ul class="kit__swatch">
			{swatches.map((s) => (
				<li>
					<span style={`background:${s.c}`}></span>
					{s.n}
				</li>
			))}
		</ul>
		<p class="kit__rule">Rule: one look in the ads, the pack and the page.</p>
		<p class="mock__foot">Logo · type · colour · first ad set</p>
	</div>
</figure>
