---
import logoLight from '../../assets/orbitlee-logo-light.png';
import logoDark from '../../assets/orbitlee-logo-dark.png';

interface Props {
	size?: 'nav' | 'foot' | 'about';
}

const { size = 'nav' } = Astro.props;
---

<span class:list={['lockup', `lockup--${size}`]}>
	<img class="lockup__img lockup__img--dark" src={logoLight.src} alt="" width={logoLight.width} height={logoLight.height} />
	<img class="lockup__img lockup__img--light" src={logoDark.src} alt="" width={logoDark.width} height={logoDark.height} />
</span>
