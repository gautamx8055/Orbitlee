# Runway Dev API — server-side only, never expose to the browser.
# Get a key from the Developer Portal: https://dev.runwayml.com (API Keys).
# Requires credits on the org before generation calls will succeed.
RUNWAYML_API_SECRET=

# Cloudflare Turnstile site key for the contact form. Public, safe in the browser.
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
# Set this in Vercel as well, or the live form will not show the check.
PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare Turnstile secret. Server-only. Never prefix with PUBLIC_ and never commit the value.
# Same widget as PUBLIC_TURNSTILE_SITE_KEY. Set this in Vercel as well.
TURNSTILE_SECRET_KEY=
